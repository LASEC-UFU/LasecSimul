        "resource": {
          "tasks": [
            {
              "name": "MAIN_TASK",
              "triggering": "Cyclic",
              "interval": "T#10ms",
              "priority": 1
            }
          ],
          "instances": [
            {
              "name": "MAIN_INSTANCE",
