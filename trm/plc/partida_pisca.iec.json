{
  "schemaVersion": 1,
  "projectId": "partida_pisca",
  "dataTypes": [],
  "globalVariableLists": [],
  "configurations": [
    {
      "name": "CONFIGURATION_1",
      "resource": "RESOURCE_1"
    }
  ],
  "resources": [
    {
      "name": "RESOURCE_1",
      "task": "MAIN_TASK"
    }
  ],
  "tasks": [
    {
      "name": "MAIN_TASK",
      "intervalMs": 10,
      "priority": 1
    }
  ],
  "programInstances": [
    {
      "name": "MAIN_INSTANCE",
      "pouId": "pou-main",
      "task": "MAIN_TASK"
    }
  ],
  "pous": [
    {
      "pouId": "pou-main",
      "name": "MAIN",
      "kind": "program",
      "interface": {
        "variables": [
          {
            "ioId": "START",
            "name": "START",
            "class": "input",
            "type": "BOOL"
          },
          {
            "ioId": "STOP",
            "name": "STOP",
            "class": "input",
            "type": "BOOL"
          },
          {
            "ioId": "LAMP",
            "name": "LAMP",
            "class": "output",
            "type": "BOOL"
          },
          {
            "ioId": "BLINK",
            "name": "BLINK",
            "class": "output",
            "type": "BOOL"
          },
          {
            "name": "RUN",
            "class": "local",
            "type": "BOOL"
          },
          {
            "name": "COUNT",
            "class": "local",
            "type": "INT"
          },
          {
            "name": "T1",
            "class": "local",
            "type": "TON"
          },
          {
            "name": "FLIP",
            "class": "local",
            "type": "TOGGLE"
          }
        ]
      },
      "implementation": {
        "language": "st",
        "text": "(* Partida e parada com selo: LIGA acende, DESLIGA apaga. *)\nRUN := (START OR RUN) AND NOT STOP;\nLAMP := RUN;\n\n(* Pisca de 0,5 s enquanto a lampada esta acesa. *)\nT1(IN := RUN AND NOT T1.Q, PT := T#500ms);\nFLIP(CLK := T1.Q);\nBLINK := FLIP.Q AND RUN;\nIF T1.Q THEN\n  COUNT := COUNT + 1;\nEND_IF;"
      }
    },
    {
      "pouId": "pou-toggle",
      "name": "TOGGLE",
      "kind": "functionBlock",
      "interface": {
        "variables": [
          {
            "ioId": "CLK",
            "name": "CLK",
            "class": "input",
            "type": "BOOL"
          },
          {
            "ioId": "Q",
            "name": "Q",
            "class": "output",
            "type": "BOOL"
          },
          {
            "name": "EDGE",
            "class": "local",
            "type": "R_TRIG"
          }
        ]
      },
      "implementation": {
        "language": "st",
        "text": "(* Inverte Q a cada borda de subida de CLK. *)\nEDGE(CLK := CLK);\nIF EDGE.Q THEN\n  Q := NOT Q;\nEND_IF;"
      }
    }
  ],
  "libraries": [],
  "buildSettings": {
    "entryConfiguration": "CONFIGURATION_1"
  }
}
