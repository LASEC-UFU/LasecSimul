{
  "schemaVersion": 1,
  "projectId": "partida_pisca_il",
  "dataTypes": [],
  "globalVariableLists": [],
  "configurations": [
    {
      "name": "CONFIGURATION_1",
      "resource": "RESOURCE_1"
    }
  ],
  "resources": [
    {
      "name": "RESOURCE_1",
      "task": "MAIN_TASK"
    }
  ],
  "tasks": [
    {
      "name": "MAIN_TASK",
      "intervalMs": 10,
      "priority": 1
    }
  ],
  "programInstances": [
    {
      "name": "MAIN_INSTANCE",
      "pouId": "pou-main",
      "task": "MAIN_TASK"
    }
  ],
  "pous": [
    {
      "pouId": "pou-main",
      "name": "MAIN",
      "kind": "program",
      "interface": {
        "variables": [
          {
            "ioId": "START",
            "name": "START",
            "class": "input",
            "type": "BOOL"
          },
          {
            "ioId": "STOP",
            "name": "STOP",
            "class": "input",
            "type": "BOOL"
          },
          {
            "ioId": "LAMP",
            "name": "LAMP",
            "class": "output",
            "type": "BOOL"
          },
          {
            "ioId": "BLINK",
            "name": "BLINK",
            "class": "output",
            "type": "BOOL"
          },
          {
            "name": "RUN",
            "class": "local",
            "type": "BOOL"
          },
          {
            "name": "COUNT",
            "class": "local",
            "type": "INT"
          },
          {
            "name": "T1",
            "class": "local",
            "type": "TON"
          },
          {
            "name": "FLIP",
            "class": "local",
            "type": "TOGGLE"
          }
        ]
      },
      "implementation": {
        "language": "il",
        "text": "(* Partida e parada com selo: LIGA acende, DESLIGA apaga. *)\n      LD    START\n      OR    RUN\n      ANDN  STOP\n      ST    RUN\n      ST    LAMP\n\n(* Pisca de 0,5 s enquanto a lampada esta acesa. *)\n      LD    T#500ms\n      ST    T1.PT       (* so grava a entrada: PT T1 tambem CHAMARIA o TON, e duas *)\n                        (* chamadas no mesmo scan engolem o pulso de T1.Q        *)\n      LD    RUN\n      ANDN  T1.Q\n      IN    T1          (* T1(IN := RUN AND NOT T1.Q) *)\n      LD    T1.Q\n      CLK   FLIP        (* FLIP(CLK := T1.Q) *)\n      LD    FLIP.Q\n      AND   RUN\n      ST    BLINK\n      LD    T1.Q\n      JMPCN FIM\n      LD    COUNT\n      ADD   1\n      ST    COUNT\nFIM:"
      }
    },
    {
      "pouId": "pou-toggle",
      "name": "TOGGLE",
      "kind": "functionBlock",
      "interface": {
        "variables": [
          {
            "ioId": "CLK",
            "name": "CLK",
            "class": "input",
            "type": "BOOL"
          },
          {
            "ioId": "Q",
            "name": "Q",
            "class": "output",
            "type": "BOOL"
          },
          {
            "name": "EDGE",
            "class": "local",
            "type": "R_TRIG"
          }
        ]
      },
      "implementation": {
        "language": "il",
        "text": "(* Inverte Q a cada borda de subida de CLK. *)\n      LD    CLK\n      CLK   EDGE        (* EDGE(CLK := CLK) *)\n      LD    EDGE.Q\n      JMPCN FIM\n      LD    Q\n      NOT\n      ST    Q\nFIM:"
      }
    }
  ],
  "libraries": [],
  "buildSettings": {
    "entryConfiguration": "CONFIGURATION_1"
  }
}
