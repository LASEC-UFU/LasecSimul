    "version": "4.2.8"
  },
  "project": {
    "meta": {
      "name": "partida_pisca",
      "type": "plc-project"
    },
    "data": {
      "pous": [],
      "dataTypes": [],
      "libraries": [],
      "configuration": {
        "resource": {
          "tasks": [
            {
              "name": "MAIN_TASK",
              "triggering": "Cyclic",
              "interval": "T#10ms",
              "priority": 1
            }
          ],
          "instances": [
            {
              "name": "MAIN_INSTANCE",
              "program": "MAIN",
              "task": "MAIN_TASK"
            }
          ],
          "globalVariables": []
        }
