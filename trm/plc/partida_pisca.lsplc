    }
  },
  "devices": {
    "configuration": {
      "deviceBoard": "OpenPLC Simulator",
      "communicationPort": "",
      "runtimeIpAddress": "",
      "vendorScreenData": {},
      "vendorScreenDataByBoard": {},
      "selectedPlatformOptions": {}
    },
    "pinMapping": {}
  },
  "files": {
    "pous/function-blocks/TOGGLE_1.st": "FUNCTION_BLOCK TOGGLE_1\n  VAR_INPUT\n    CLK : BOOL;\n  END_VAR\n  VAR_OUTPUT\n    Q : BOOL;\n  END_VAR\n  VAR\n    EDGE : R_TRIG;\n  END_VAR\n\n(* Inverte Q a cada borda de subida de CLK. *)\nEDGE(CLK := CLK);\nIF EDGE.Q THEN\n  Q := NOT Q;\nEND_IF;\n\nEND_FUNCTION_BLOCK",
    "pous/programs/MAIN.st": "PROGRAM MAIN\n  VAR_INPUT\n    START : BOOL;\n    STOP : BOOL;\n  END_VAR\n  VAR_OUTPUT\n    LAMP : BOOL;\n    BLINK : BOOL;\n  END_VAR\n  VAR\n    RUN : BOOL;\n    COUNT : INT;\n    T1 : TON;\n    FLIP : TOGGLE_1;\n  END_VAR\n\n(* Partida e parada com selo: LIGA acende, DESLIGA apaga. *)\nRUN := (START OR RUN) AND NOT STOP;\nLAMP := RUN;\n\n(* Pisca de 0,5 s enquanto a lampada esta acesa. *)\nT1(IN := RUN AND NOT T1.Q, PT := T#500ms);\nFLIP(CLK := T1.Q);\nBLINK := FLIP.Q AND RUN;\nIF T1.Q THEN\n  COUNT := COUNT + 1;\nEND_IF;\n\nEND_PROGRAM"
  }
}
