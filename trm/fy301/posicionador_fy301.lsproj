    {
      "id": "component-1791649688358-valve1",
      "typeId": "subcircuits.local.control_valve",
      "label": "Válvula de controle",
      "showValue": false,
      "showDialValue": false,
      "visual": {
        "x": -216,
        "y": 330,
        "rotation": 0
      },
      "properties": {},
      "subcircuitRef": {
        "path": "valvula_controle.lssubcircuit",
        "lastKnownTypeId": "subcircuits.local.control_valve",
        "lastKnownPinIds": [
          "supply",
          "out1",
          "position",
          "flow"
        ],
        "embedded": {
          "schemaVersion": 3,
          "typeId": "subcircuits.local.control_valve",
          "name": "Válvula de controle com atuador pneumático",
          "language": "pt-BR",
          "folderPath": [
            "Modelos"
          ],
          "workspaceSection": "process",
          "help": {
            "description": "Válvula globo com atuador pneumático de diafragma e mola, para ser comandada por um posicionador (FY301). OUT1 é a pressão que o posicionador manda à câmara do atuador; SUP é o suprimento de ar do filtro-regulador; POS é o curso da haste (mm de abertura) que o ímã leva ao sensor Hall do posicionador. Modelo: atraso pneumático, equilíbrio mola x diafragma pela faixa da mola (bench set), ar para abrir ou para fechar, banda morta do atrito da gaxeta e vazão Q = Kvs·f(l)·√ΔP com a característica inerente linear, igual porcentagem (R = 50) ou abertura rápida. Os parâmetros ficam em Propriedades Exportadas."
          },
          "components": [
            {
              "id": "t_out1",
              "typeId": "connectors.signal_tunnel",
              "properties": {
                "name": "out1",
                "pinId": "out1",
                "direction": "Input",
                "valueType": "Real",
                "defaultValue": 0
              },
              "visual": {
                "x": 40,
                "y": 80,
                "rotation": 0
              }
            },
            {
              "id": "t_supply",
              "typeId": "connectors.signal_tunnel",
              "properties": {
                "name": "supply",
                "pinId": "supply",
                "direction": "Output",
                "valueType": "Real"
              },
              "visual": {
                "x": 1340,
                "y": 560,
                "rotation": 0
              }
            },
            {
              "id": "t_position",
              "typeId": "connectors.signal_tunnel",
              "properties": {
                "name": "position",
                "pinId": "position",
                "direction": "Output",
                "valueType": "Real"
              },
              "visual": {
                "x": 1340,
                "y": 680,
                "rotation": 0
              }
            },
            {
              "id": "t_flow",
              "typeId": "connectors.signal_tunnel",
              "properties": {
                "name": "flow",
                "pinId": "flow",
                "direction": "Output",
                "valueType": "Real"
              },
              "visual": {
                "x": 1340,
                "y": 440,
                "rotation": 0
              }
            },
            {
              "id": "c_supply",
              "typeId": "control.constant",
              "properties": {
                "value": 1.4,
                "unit": "bar"
              },
              "visual": {
                "x": 200,
                "y": 40,
                "rotation": 0
              },
              "label": "Pressão de suprimento de ar (conjunto filtro-regulador)"
            },
            {
              "id": "c_action",
              "typeId": "control.constant",
              "properties": {
                "value": 0,
                "unit": "",
                "options": "0=Ar para abrir (mola fecha: falha fechada);1=Ar para fechar (mola abre: falha aberta)"
              },
              "visual": {
                "x": 200,
                "y": 100,
                "rotation": 0
              },
              "label": "Ação do atuador"
            },
            {
              "id": "c_plo",
              "typeId": "control.constant",
              "properties": {
                "value": 0.2,
                "unit": "bar"
              },
              "visual": {
                "x": 200,
                "y": 160,
                "rotation": 0
              },
              "label": "Faixa da mola: início do movimento (bench set)"
            },
            {
              "id": "c_phi",
              "typeId": "control.constant",
              "properties": {
                "value": 1,
                "unit": "bar"
              },
              "visual": {
                "x": 200,
                "y": 220,
                "rotation": 0
              },
              "label": "Faixa da mola: fim do curso (bench set)"
            },
            {
              "id": "c_stroke",
              "typeId": "control.constant",
              "properties": {
                "value": 20,
                "unit": "mm"
              },
              "visual": {
                "x": 200,
                "y": 280,
                "rotation": 0
              },
              "label": "Curso da válvula"
            },
            {
              "id": "c_tau",
              "typeId": "control.constant",
              "properties": {
                "value": 0.5,
                "unit": "s"
              },
              "visual": {
                "x": 200,
                "y": 340,
                "rotation": 0
              },
              "label": "Constante de tempo pneumática do atuador"
            },
            {
              "id": "c_friction",
              "typeId": "control.constant",
              "properties": {
                "value": 0.5,
                "unit": "% do curso"
              },
              "visual": {
                "x": 200,
                "y": 400,
                "rotation": 0
              },
              "label": "Atrito da gaxeta (banda morta)"
            },
            {
              "id": "c_kvs",
              "typeId": "control.constant",
              "properties": {
                "value": 10,
                "unit": "m³/h"
              },
              "visual": {
                "x": 200,
                "y": 460,
                "rotation": 0
              },
              "label": "Kvs (coeficiente de vazão a 100 %)"
            },
            {
              "id": "c_char",
              "typeId": "control.constant",
              "properties": {
                "value": 0,
                "unit": "",
                "options": "0=Linear;1=Igual porcentagem (R = 50);2=Abertura rápida"
              },
              "visual": {
                "x": 200,
                "y": 520,
                "rotation": 0
              },
              "label": "Característica inerente da válvula"
            },
            {
              "id": "c_dp",
              "typeId": "control.constant",
              "properties": {
                "value": 1,
                "unit": "bar"
              },
              "visual": {
                "x": 200,
                "y": 580,
                "rotation": 0
              },
              "label": "Pressão diferencial na válvula"
            },
            {
              "id": "out1_bar",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "o",
                "inputs": [
                  "o"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 40,
                "rotation": 0
              },
              "label": "OUT1 recebida do posicionador (bar)"
            },
            {
              "id": "supply_bar",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(s>0)*s",
                "inputs": [
                  "s"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 100,
                "rotation": 0
              },
              "label": "Suprimento (bar)"
            },
            {
              "id": "p_in",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "((o-p)>0)*(o-p)/((tau>0.01)*tau+(tau<0.0101)*0.01)",
                "inputs": [
                  "o",
                  "p",
                  "tau"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 160,
                "rotation": 0
              },
              "label": "Enchimento do atuador"
            },
            {
              "id": "p_out",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "((p-o)>0)*(p-o)/((tau>0.01)*tau+(tau<0.0101)*0.01)",
                "inputs": [
                  "o",
                  "p",
                  "tau"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 220,
                "rotation": 0
              },
              "label": "Exaustão do atuador"
            },
            {
              "id": "p_act",
              "typeId": "control.tank",
              "properties": {
                "area": 1,
                "initial": 0,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 40,
                "y": 300,
                "rotation": 0
              },
              "label": "Pressão no atuador (bar)"
            },
            {
              "id": "x_eq",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "s*((a<0.5)*((p-lo)/(((hi-lo)>0.01)*(hi-lo)+((hi-lo)<0.0101)*0.01))+(a>0.5)*(1-(p-lo)/(((hi-lo)>0.01)*(hi-lo)+((hi-lo)<0.0101)*0.01)))",
                "inputs": [
                  "p",
                  "lo",
                  "hi",
                  "a",
                  "s"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 280,
                "rotation": 0
              },
              "label": "Equilíbrio mola x diafragma (mm de abertura; fora da faixa: sede ou batente)"
            },
            {
              "id": "gap",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "((e-x)>f*s/200)*((e-x)-f*s/200)+((e-x)<(0-f*s/200))*((e-x)+f*s/200)",
                "inputs": [
                  "e",
                  "x",
                  "f",
                  "s"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 340,
                "rotation": 0
              },
              "label": "Força líquida além do atrito (mm)"
            },
            {
              "id": "stem_in",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(g>0)*g/0.15*(x<s)",
                "inputs": [
                  "g",
                  "x",
                  "s"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 400,
                "rotation": 0
              },
              "label": "Haste: abrindo (até o batente)"
            },
            {
              "id": "stem_out",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(g<0)*(0-g)/0.15",
                "inputs": [
                  "g"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 460,
                "rotation": 0
              },
              "label": "Haste: fechando"
            },
            {
              "id": "stem",
              "typeId": "control.tank",
              "properties": {
                "area": 1,
                "initial": 0,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 40,
                "y": 360,
                "rotation": 0
              },
              "label": "Abertura da haste (mm)"
            },
            {
              "id": "opening",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "x/((s>0.1)*s+(s<0.1001)*0.1)*100",
                "inputs": [
                  "x",
                  "s"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 520,
                "rotation": 0
              },
              "label": "Abertura (%)"
            },
            {
              "id": "flow_m3h",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "k*((c<0.5)*(l/100)+(c>0.5)*(c<1.5)*(50^(l/100)-1)/49+(c>1.5)*((l/100)>0)*(l/100)^0.5)*((dp>0)*dp)^0.5",
                "inputs": [
                  "l",
                  "c",
                  "k",
                  "dp"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 1000000
              },
              "visual": {
                "x": 620,
                "y": 580,
                "rotation": 0
              },
              "label": "Vazão Q = Kvs·f(l)·√ΔP (m³/h)"
            },
