              "properties": {
                "value": 20,
                "unit": "s"
              },
              "visual": {
                "x": 200,
                "y": 280,
                "rotation": 0
              },
              "label": "Constante de tempo do termopar (tubo de proteção)"
            },
            {
              "id": "c_type",
              "typeId": "control.constant",
              "properties": {
                "value": 3,
                "unit": "",
                "options": "0=B;1=E;2=J;3=K;4=N;5=R;6=S;7=T"
              },
              "visual": {
                "x": 200,
                "y": 340,
                "rotation": 0
              },
              "label": "Tipo do termopar"
            },
            {
              "id": "c_lead",
              "typeId": "control.constant",
              "properties": {
                "value": 2.5,
                "unit": "Ω"
              },
              "visual": {
                "x": 200,
                "y": 400,
                "rotation": 0
              },
              "label": "Resistência de cada fio (termopar + cabo)"
            },
            {
              "id": "c_dev",
              "typeId": "control.constant",
              "properties": {
                "value": 0,
                "unit": "°C"
              },
              "visual": {
                "x": 200,
                "y": 460,
                "rotation": 0
              },
              "label": "Desvio do termopar (erro do sensor)"
            },
            {
              "id": "c_cable",
              "typeId": "control.constant",
              "properties": {
                "value": 0,
                "unit": "",
                "options": "0=Extensão/compensação (correto);1=Cobre comum (erro)"
              },
              "visual": {
                "x": 200,
                "y": 520,
                "rotation": 0
              },
              "label": "Cabo do cabeçote ao transmissor"
            },
            {
