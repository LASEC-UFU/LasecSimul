                "y": 440,
                "rotation": 0
              },
              "label": "Temperatura da junta de medição (°C)"
            },
            {
              "id": "t_lo",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "(u(1) > -0.5)*(u(1) < 0.5)*0 + (u(1) > 0.5)*(u(1) < 1.5)*-270 + (u(1) > 1.5)*(u(1) < 2.5)*-210 + (u(1) > 2.5)*(u(1) < 3.5)*-270 + (u(1) > 3.5)*(u(1) < 4.5)*-270 + (u(1) > 4.5)*(u(1) < 5.5)*-50 + (u(1) > 5.5)*(u(1) < 6.5)*-50 + (u(1) > 6.5)*(u(1) < 7.5)*-270",
                "SampleTime": "0.01"
              },
              "visual": {
                "x": 620,
                "y": 520,
                "rotation": 0
              },
              "label": "Limite inferior do tipo (°C)"
            },
            {
              "id": "t_hi",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "(u(1) > -0.5)*(u(1) < 0.5)*1820 + (u(1) > 0.5)*(u(1) < 1.5)*1000 + (u(1) > 1.5)*(u(1) < 2.5)*1200 + (u(1) > 2.5)*(u(1) < 3.5)*1372 + (u(1) > 3.5)*(u(1) < 4.5)*1300 + (u(1) > 4.5)*(u(1) < 5.5)*1768.1 + (u(1) > 5.5)*(u(1) < 6.5)*1768.1 + (u(1) > 6.5)*(u(1) < 7.5)*400",
                "SampleTime": "0.01"
              },
              "visual": {
                "x": 620,
                "y": 580,
                "rotation": 0
              },
              "label": "Limite superior do tipo (°C)"
            },
            {
              "id": "t_hot",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "u(1) + u(2) + (u(1) + u(2) < u(3))*(u(3) - (u(1) + u(2))) + (u(1) + u(2) > u(4))*(u(4) - (u(1) + u(2)))",
                "SampleTime": "0.01"
              },
              "visual": {
                "x": 620,
                "y": 640,
                "rotation": 0
              },
              "label": "Junta de medição limitada à faixa do tipo (°C)"
            },
            {
              "id": "t_ref",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "(u(1) < 0.5)*u(2) + (u(1) > 0.5)*u(3) + ((u(1) < 0.5)*u(2) + (u(1) > 0.5)*u(3) < u(4))*(u(4) - ((u(1) < 0.5)*u(2) + (u(1) > 0.5)*u(3))) + ((u(1) < 0.5)*u(2) + (u(1) > 0.5)*u(3) > u(5))*(u(5) - ((u(1) < 0.5)*u(2) + (u(1) > 0.5)*u(3)))",
                "SampleTime": "0.01"
              },
              "visual": {
                "x": 620,
                "y": 700,
                "rotation": 0
              },
              "label": "Junta de referência: bornes do transmissor (extensão) ou cabeçote (cobre) (°C)"
            },
