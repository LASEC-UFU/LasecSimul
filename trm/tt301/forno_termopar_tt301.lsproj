              "properties": {
                "value": 60,
                "unit": "°C"
              },
              "visual": {
                "x": 200,
                "y": 580,
                "rotation": 0
              },
              "label": "Temperatura no cabeçote do termopar"
            },
            {
              "id": "c_reverse",
              "typeId": "control.constant",
              "properties": {
                "value": 0,
                "unit": "",
                "options": "0=Não;1=Sim (+ e − trocados)"
              },
              "visual": {
                "x": 200,
                "y": 640,
                "rotation": 0
              },
              "label": "Polaridade invertida nos bornes"
            },
            {
              "id": "c_broken",
              "typeId": "control.constant",
              "properties": {
                "value": 0,
                "unit": "",
                "options": "0=Não;1=Sim (circuito aberto)"
              },
              "visual": {
                "x": 200,
                "y": 700,
                "rotation": 0
              },
              "label": "Termopar rompido"
            },
            {
              "id": "u",
              "typeId": "control.observer",
              "properties": {
                "unit": "%",
                "observerOnly": true,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 40,
                "y": 200,
                "rotation": 0
              },
              "label": "Aquecimento"
            },
            {
              "id": "q_heat",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "1000*P*((u>0)*(u<100)*u+(u>99.9999)*100)/100",
                "inputs": [
                  "u",
                  "P"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 40,
                "rotation": 0
              },
              "label": "Potência das resistências (W)"
            },
            {
              "id": "q_loss",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "UA*(T-Ta)",
                "inputs": [
                  "T",
                  "UA",
                  "Ta"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 100,
                "rotation": 0
              },
              "label": "Perdas para o ambiente (W)"
            },
            {
              "id": "heat_in",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "q/(1000*C)",
                "inputs": [
                  "q",
                  "C"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 160,
                "rotation": 0
              },
              "label": "Ganho de temperatura (K/s)"
            },
            {
              "id": "heat_out",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "l/(1000*C)",
                "inputs": [
                  "l",
                  "C"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 220,
                "rotation": 0
              },
              "label": "Perda de temperatura (K/s)"
            },
            {
              "id": "temp",
              "typeId": "control.tank",
              "properties": {
                "area": 1,
                "initial": 25,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 40,
                "y": 320,
                "rotation": 0
              },
              "label": "Temperatura do forno (°C)"
            },
            {
              "id": "tau_th",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "1000*C/UA/60",
                "inputs": [
                  "C",
                  "UA"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 280,
                "rotation": 0
              },
              "label": "Constante de tempo térmica (min)"
            },
            {
              "id": "t_steady",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "Ta+1000*P/UA",
                "inputs": [
                  "P",
                  "UA",
                  "Ta"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 340,
                "rotation": 0
              },
              "label": "Temperatura de regime a 100 % (°C)"
            },
            {
              "id": "well_in",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "T/((tau>0.1)*tau+(tau<0.1)*0.1)",
                "inputs": [
                  "T",
                  "tau"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 400,
                "rotation": 0
              },
              "label": "Tubo: entrada"
            },
            {
              "id": "well_out",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "Ts/((tau>0.1)*tau+(tau<0.1)*0.1)",
                "inputs": [
                  "Ts",
                  "tau"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 460,
                "rotation": 0
              },
              "label": "Tubo: saída"
            },
            {
              "id": "sensor_temp",
              "typeId": "control.tank",
              "properties": {
                "area": 1,
                "initial": 25,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 40,
                "y": 440,
                "rotation": 0
              },
              "label": "Temperatura da junta de medição (°C)"
            },
            {
              "id": "t_lo",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(m>-0.5)*(m<0.5)*0.0+(m>0.5)*(m<1.5)*(-270.0)+(m>1.5)*(m<2.5)*(-210.0)+(m>2.5)*(m<3.5)*(-270.0)+(m>3.5)*(m<4.5)*(-270.0)+(m>4.5)*(m<5.5)*(-50.0)+(m>5.5)*(m<6.5)*(-50.0)+(m>6.5)*(m<7.5)*(-270.0)",
                "inputs": [
                  "m"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 520,
                "rotation": 0
              },
              "label": "Limite inferior do tipo (°C)"
            },
            {
              "id": "t_hi",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(m>-0.5)*(m<0.5)*1820.0+(m>0.5)*(m<1.5)*1000.0+(m>1.5)*(m<2.5)*1200.0+(m>2.5)*(m<3.5)*1372.0+(m>3.5)*(m<4.5)*1300.0+(m>4.5)*(m<5.5)*1768.1+(m>5.5)*(m<6.5)*1768.1+(m>6.5)*(m<7.5)*400.0",
                "inputs": [
                  "m"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 580,
                "rotation": 0
              },
              "label": "Limite superior do tipo (°C)"
            },
            {
              "id": "t_hot",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(Ts+d)+((Ts+d)<lo)*(lo-(Ts+d))+((Ts+d)>hi)*(hi-(Ts+d))",
                "inputs": [
                  "Ts",
                  "d",
                  "lo",
                  "hi"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 640,
                "rotation": 0
              },
              "label": "Junta de medição limitada à faixa do tipo (°C)"
            },
            {
              "id": "t_ref",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "((cable<0.5)*Ta+(cable>0.5)*Th)+(((cable<0.5)*Ta+(cable>0.5)*Th)<lo)*(lo-((cable<0.5)*Ta+(cable>0.5)*Th))+(((cable<0.5)*Ta+(cable>0.5)*Th)>hi)*(hi-((cable<0.5)*Ta+(cable>0.5)*Th))",
                "inputs": [
                  "cable",
                  "Ta",
                  "Th",
                  "lo",
                  "hi"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 700,
                "rotation": 0
              },
              "label": "Junta de referência: bornes do transmissor (extensão) ou cabeçote (cobre) (°C)"
            },
            {
              "id": "e_hot_b",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(t<630.615)*(t*((-0.00024650818346)+t*(5.9040421171e-06+t*((-1.3257931636e-09)+t*(1.5668291901e-12+t*((-1.694452924e-15)+t*(6.2990347094e-19)))))))+(1-(t<630.615))*((-3.8938168621)+t*(0.02857174747+t*((-8.4885104785e-05)+t*(1.5785280164e-07+t*((-1.6835344864e-10)+t*(1.1109794013e-13+t*((-4.4515431033e-17)+t*(9.8975640821e-21+t*((-9.3791330289e-25))))))))))",
                "inputs": [
                  "t"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 840,
                "y": 40,
                "rotation": 0
              },
              "label": "Tipo B: E(junta de medição) (mV)"
            },
            {
              "id": "e_ref_b",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(t<630.615)*(t*((-0.00024650818346)+t*(5.9040421171e-06+t*((-1.3257931636e-09)+t*(1.5668291901e-12+t*((-1.694452924e-15)+t*(6.2990347094e-19)))))))+(1-(t<630.615))*((-3.8938168621)+t*(0.02857174747+t*((-8.4885104785e-05)+t*(1.5785280164e-07+t*((-1.6835344864e-10)+t*(1.1109794013e-13+t*((-4.4515431033e-17)+t*(9.8975640821e-21+t*((-9.3791330289e-25))))))))))",
                "inputs": [
                  "t"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 840,
                "y": 100,
                "rotation": 0
              },
              "label": "Tipo B: E(junta de referência) (mV)"
            },
            {
              "id": "e_hot_e",
