            {
              "id": "well_out",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "u(1)/((u(2) > 0.1)*u(2) + (u(2) < 0.1)*0.1)",
                "SampleTime": "0.01"
              },
              "visual": {
