              },
              "label": "Temperatura de regime a 100 % (°C)"
            },
            {
              "id": "well_in",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "u(1)/((u(2) > 0.1)*u(2) + (u(2) < 0.1)*0.1)",
                "SampleTime": "0.01"
              },
              "visual": {
                "x": 620,
                "y": 400,
                "rotation": 0
              },
              "label": "Tubo: entrada"
