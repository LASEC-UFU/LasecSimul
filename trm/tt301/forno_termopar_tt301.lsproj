              "id": "e_hot_b",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "(u(1) < 630.615)*(u(1)*(-0.00024650818346 + u(1)*(0.0000059040421171 + u(1)*(-1.3257931636e-9 + u(1)*(1.5668291901e-12 + u(1)*(-1.694452924e-15 + u(1)*6.2990347094e-19)))))) + (1 - (u(1) < 630.615))*(-3.8938168621 + u(1)*(0.02857174747 + u(1)*(-0.000084885104785 + u(1)*(1.5785280164e-7 + u(1)*(-1.6835344864e-10 + u(1)*(1.1109794013e-13 + u(1)*(-4.4515431033e-17 + u(1)*(9.8975640821e-21 + u(1)*-9.3791330289e-25))))))))",
                "SampleTime": "0.01"
              },
              "visual": {
                "x": 840,
                "y": 40,
                "rotation": 0
              },
              "label": "Tipo B: E(junta de medição) (mV)"
            },
            {
              "id": "e_ref_b",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "(u(1) < 630.615)*(u(1)*(-0.00024650818346 + u(1)*(0.0000059040421171 + u(1)*(-1.3257931636e-9 + u(1)*(1.5668291901e-12 + u(1)*(-1.694452924e-15 + u(1)*6.2990347094e-19)))))) + (1 - (u(1) < 630.615))*(-3.8938168621 + u(1)*(0.02857174747 + u(1)*(-0.000084885104785 + u(1)*(1.5785280164e-7 + u(1)*(-1.6835344864e-10 + u(1)*(1.1109794013e-13 + u(1)*(-4.4515431033e-17 + u(1)*(9.8975640821e-21 + u(1)*-9.3791330289e-25))))))))",
                "SampleTime": "0.01"
              },
              "visual": {
                "x": 840,
                "y": 100,
                "rotation": 0
              },
              "label": "Tipo B: E(junta de referência) (mV)"
            },
            {
              "id": "e_hot_e",
              "typeId": "sl.fcn",
              "properties": {
                "Expr": "(u(1) < 0)*(u(1)*(0.058665508708 + u(1)*(0.000045410977124 + u(1)*(-7.7998048686e-7 + u(1)*(-2.5800160843e-8 + u(1)*(-5.9452583057e-10 + u(1)*(-9.3214058667e-12 + u(1)*(-1.0287605534e-13 + u(1)*(-8.0370123621e-16 + u(1)*(-4.3979497391e-18 + u(1)*(-1.6414776355e-20 + u(1)*(-3.9673619516e-23 + u(1)*(-5.5827328721e-26 + u(1)*-3.4657842013e-29))))))))))))) + (1 - (u(1) < 0))*(u(1)*(0.05866550871 + u(1)*(0.000045032275582 + u(1)*(2.8908407212e-8 + u(1)*(-3.3056896652e-10 + u(1)*(6.502440327e-13 + u(1)*(-1.9197495504e-16 + u(1)*(-1.2536600497e-18 + u(1)*(2.1489217569e-21 + u(1)*(-1.4388041782e-24 + u(1)*3.5960899481e-28))))))))))",
