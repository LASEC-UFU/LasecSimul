              "properties": {
                "value": 36,
                "unit": "m³/h"
              },
              "visual": {
                "x": 200,
                "y": 460,
                "rotation": 0
              },
              "label": "Vazão máxima de entrada (válvula 100 %)"
            },
            {
              "id": "c_qout_max",
              "typeId": "control.constant",
              "properties": {
                "value": 36,
                "unit": "m³/h"
              },
              "visual": {
                "x": 200,
                "y": 520,
                "rotation": 0
              },
              "label": "Vazão máxima de saída (válvula 100 %, tanque cheio)"
            },
            {
              "id": "u_in",
              "typeId": "control.observer",
              "properties": {
                "unit": "%",
                "observerOnly": true,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 200,
                "y": 620,
                "rotation": 0
              },
              "label": "Abertura da válvula de entrada"
            },
            {
              "id": "u_out",
              "typeId": "control.observer",
              "properties": {
                "unit": "%",
                "observerOnly": true,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 200,
                "y": 680,
                "rotation": 0
              },
              "label": "Abertura da válvula de saída"
            },
            {
              "id": "q_in",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "Qmax*((u>0)*u)/100*(h<H)",
                "inputs": [
                  "u",
                  "h",
                  "H",
                  "Qmax"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 420,
                "y": 80,
                "rotation": 0
              },
              "label": "Vazão de entrada (m³/h)"
            },
            {
              "id": "q_out",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "Qmax*((u>0)*u)/100*((h>0.02)+(h<0.02)*h/0.02)*((((SG*h+0.101972*Pg)>0)*(SG*h+0.101972*Pg))/(SG*H+0.101972*Pg))^0.5",
                "inputs": [
                  "u",
                  "h",
                  "H",
                  "SG",
                  "Pg",
                  "Qmax"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 420,
                "y": 160,
                "rotation": 0
              },
              "label": "Vazão de saída (m³/h)"
            },
            {
              "id": "dh_in",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "q/3600/(0.785398163*D^2)",
                "inputs": [
                  "q",
                  "D"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 80,
                "rotation": 0
              },
              "label": "Entrada (m/s)"
            },
            {
              "id": "dh_out",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "q/3600/(0.785398163*D^2)",
                "inputs": [
                  "q",
                  "D"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 620,
                "y": 160,
                "rotation": 0
              },
              "label": "Saída (m/s)"
            },
            {
              "id": "tank",
              "typeId": "control.tank",
              "properties": {
                "area": 1,
                "initial": 1.5,
                "samplePeriodNs": 10000000
              },
              "visual": {
                "x": 820,
