            },
            {
              "id": "p_high",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "1000*(SG*h+SGc*Lc)+101.972*Pg",
                "inputs": [
                  "h",
                  "SG",
                  "SGc",
                  "Lc",
                  "Pg"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
