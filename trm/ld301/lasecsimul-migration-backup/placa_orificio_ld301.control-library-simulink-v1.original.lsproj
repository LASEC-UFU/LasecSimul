            },
            {
              "id": "reynolds",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "1111.111111*rho*q/(3.14159265*mu*D)",
                "inputs": [
                  "q",
                  "rho",
                  "mu",
                  "D"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
