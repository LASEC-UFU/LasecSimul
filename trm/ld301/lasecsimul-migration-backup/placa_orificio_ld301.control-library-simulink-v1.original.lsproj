            },
            {
              "id": "ra_pipe",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(m>0.5)*(m<1.5)*0.015+(m>1.5)*(m<2.5)*0.005+(m>2.5)*(m<3.5)*0.08+(m>3.5)*(m<4.5)*0.05+(m>4.5)*(m<5.5)*0.0005+(m>5.5)*(m<6.5)*0.0005",
                "inputs": [
