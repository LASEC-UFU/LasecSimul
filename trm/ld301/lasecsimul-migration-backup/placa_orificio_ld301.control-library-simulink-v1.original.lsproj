                "rotation": 0
              },
              "label": "β = d/D"
            },
            {
              "id": "velocity",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "q/3600/(0.785398163*(D/1000)^2)",
                "inputs": [
                  "q",
                  "D"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
                "upperLimitEnabled": false,
                "lowerLimitEnabled": false,
                "samplePeriodNs": 10000000
