            },
            {
              "id": "alpha_pipe",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "(m>0.5)*(m<1.5)*11.2+(m>1.5)*(m<2.5)*16.0+(m>2.5)*(m<3.5)*10.4+(m>3.5)*(m<4.5)*11.2+(m>4.5)*(m<5.5)*16.8+(m>5.5)*(m<6.5)*54.0",
