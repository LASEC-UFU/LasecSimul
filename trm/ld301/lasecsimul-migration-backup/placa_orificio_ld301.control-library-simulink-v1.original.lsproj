              "id": "eps1",
              "typeId": "control.calc_expression",
              "properties": {
                "expression": "1-(gas>0.5)*(0.351+0.256*b^4+0.93*b^8)*(1-(((p1+101.325-dp/1000)/(p1+101.325)>0.01)*(p1+101.325-dp/1000)/(p1+101.325)+((p1+101.325-dp/1000)/(p1+101.325)<0.01)*0.01)^(1/k))",
                "inputs": [
                  "gas",
                  "b",
                  "p1",
                  "k",
                  "dp"
                ],
                "upperLimit": 0,
                "lowerLimit": 0,
