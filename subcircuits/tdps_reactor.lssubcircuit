    {
      "id": "calc-41",
      "typeId": "sl.fcn",
      "label": "Sel_MV",
      "visual": {
        "x": 220,
        "y": 896,
        "rotation": 0
      },
      "properties": {
        "Expr": "(1 - u(1))*u(2) + u(1)*u(3)",
        "SampleTime": "0.01"
      }
    },
    {
      "id": "calc-42",
      "typeId": "sl.fcn",
      "label": "LT01_BM",
      "visual": {
        "x": 500,
        "y": 440,
        "rotation": 0
      },
      "properties": {
        "Expr": "u(1) - u(2)",
        "SampleTime": "0.01"
      }
    },
    {
      "id": "calc-44",
      "typeId": "sl.fcn",
      "label": "SP Demanda",
      "visual": {
        "x": 220,
        "y": 1688,
        "rotation": 0
      },
      "properties": {
        "Expr": "u(1)*u(2) + 50*(1 - u(1)) + (u(3)*2 - 100)",
        "SampleTime": "0.01"
      }
    },
    {
      "id": "calc-45",
      "typeId": "sl.saturation",
      "label": "TT2",
      "visual": {
        "x": 220,
        "y": 608,
        "rotation": 0
      },
      "properties": {
        "UpperLimit": "100",
        "LowerLimit": "0",
        "SampleTime": "0.01"
      }
    },
    {
      "id": "calc-46",
      "typeId": "sl.fcn",
      "label": "TT1_FCV",
      "visual": {
        "x": 220,
        "y": 1048,
        "rotation": 0
      },
      "properties": {
        "Expr": "u(1) + (u(2)*2 - 100 + u(3))*(1 - u(4))",
        "SampleTime": "0.01"
      }
    },
    {
      "id": "calc-47",
      "typeId": "sl.fcn",
      "label": "F02aux2",
      "visual": {
        "x": 220,
        "y": 1504,
        "rotation": 0
      },
      "properties": {
        "Expr": "u(1)*u(2) + (1 - u(1))*u(3) + u(4) + 0.3*u(5)",
        "SampleTime": "0.01"
      }
    },
    {
      "id": "calc-48",
      "typeId": "sl.fcn",
      "label": "F01aux2",
      "visual": {
        "x": 220,
        "y": 200,
        "rotation": 0
      },
      "properties": {
        "Expr": "u(1)*u(2) + (1 - u(1))*u(3) + u(4)",
        "SampleTime": "0.01"
      }
    },
    {
      "id": "calc-49",
      "typeId": "sl.fcn",
      "label": "LIC01_aux",
      "visual": {
        "x": 220,
        "y": 1216,
        "rotation": 0
      },
      "properties": {
        "Expr": "u(1) + u(2) + 0.5*u(3)",
        "SampleTime": "0.01"
      }
    },
    {
      "id": "calc-50",
