  "components": [
    {
      "id": "pid-01",
      "typeId": "control.pid",
      "properties": {
        "kc": 1,
        "ti": 10,
        "td": 0,
        "bias": 50,
        "derivativeFilter": 0.1,
        "outputMin": 0,
        "outputMax": 100,
        "action": 1,
        "derivativeOnPv": true,
        "remoteSpEnabled": true,
        "feedForwardEnabled": false,
        "autoMode": true,
        "samplePeriodNs": 10000000
      },
      "label": "FIC101",
      "showValue": false,
      "visual": {
        "x": 180,
        "y": 320,
        "rotation": 0
      }
    },
    {
      "id": "process-21",
      "typeId": "control.process",
      "properties": {
        "tau1": 1.1,
        "tau2": 0.8,
        "saturationEnabled": false,
        "hysteresis": 0,
        "deadTime": 0.4,
        "gain": 1.2,
        "valveType": 0,
        "stiction": 0,
        "rateLimiter": 0,
        "actuatorTau": 0.5,
        "transferFunctionType": 0,
        "lead": 0,
        "lag": 0,
        "samplePeriodNs": 10000000
      },
      "label": "FT101",
      "showValue": false,
      "visual": {
        "x": 440,
        "y": 320,
        "rotation": 0
      }
    },
    {
      "id": "calc-41",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(1-0.2*x0)*x1+x2+x3*x4",
        "inputs": [
          "x0",
          "x1",
          "x2",
          "x3",
          "x4"
        ],
        "upperLimit": 105,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": true,
        "samplePeriodNs": 10000000
      },
      "label": "FY101",
      "showValue": false,
      "visual": {
        "x": 760,
        "y": 280,
        "rotation": 0
      }
    },
    {
      "id": "calc-42",
