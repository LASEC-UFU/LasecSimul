    {
      "schemaVersion": 3,
      "typeId": "subsystem.legado_pid_dpv",
      "name": "PID (convertido)",
      "language": "pt-BR",
      "folderPath": [
        "Convertidos"
      ],
      "workspaceSection": "control",
      "help": {
        "description": "PID (convertido): composição de blocos da biblioteca equivalente ao Simulink gerada pela migração dos blocos legados (docs/68)."
      },
      "components": [
        {
          "id": "tunnel_in_sp",
