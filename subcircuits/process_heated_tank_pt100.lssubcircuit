{
  "schemaVersion": 3,
  "typeId": "subcircuits.process.heated_tank_pt100",
  "name": "Tanque aquecido com Pt100",
  "language": "pt-BR",
  "folderPath": [
    "Modelos"
  ],
  "workspaceSection": "process",
  "help": {
    "description": "Tanque de água com resistência de aquecimento (pino Aquecimento, 0–100 %) e um Pt100 em poço termométrico, ligado por cabo de 4 fios aos bornes 1 a 4 de um transmissor de temperatura (TT301). Balanço de energia m·c·dT/dt = P − UA·(T − Tamb), fervura a 100 °C, atraso do poço e curva IEC 60751 (Callendar-Van Dusen). O elemento e os fios do cabo são resistências de verdade no circuito: a 2 fios o transmissor soma os dois fios, a 3 fios compensa e a 4 fios ignora. Volume, potência, perdas, poço, R0, resistência dos fios, desvio do sensor e sensor rompido ficam em Propriedades Exportadas."
  },
  "components": [
    {
      "id": "t_heater",
      "typeId": "connectors.signal_tunnel",
      "properties": {
        "name": "heater",
        "pinId": "heater",
        "direction": "Input",
        "valueType": "Real",
        "defaultValue": 0
      },
      "visual": {
        "x": 40,
        "y": 80,
        "rotation": 0
      }
    },
    {
      "id": "c_volume",
      "typeId": "control.constant",
      "properties": {
        "value": 10,
        "unit": "L"
      },
      "visual": {
        "x": 200,
        "y": 40,
        "rotation": 0
      },
      "label": "Volume de água no tanque"
    },
    {
      "id": "c_pmax",
      "typeId": "control.constant",
      "properties": {
        "value": 6,
        "unit": "kW"
      },
      "visual": {
        "x": 200,
        "y": 100,
        "rotation": 0
      },
      "label": "Potência máxima do aquecedor (100 %)"
    },
    {
      "id": "c_ua",
      "typeId": "control.constant",
      "properties": {
        "value": 80,
        "unit": "W/K"
      },
      "visual": {
        "x": 200,
        "y": 160,
        "rotation": 0
      },
      "label": "Coeficiente de perdas para o ambiente UA"
    },
    {
      "id": "c_tamb",
      "typeId": "control.constant",
      "properties": {
        "value": 25,
        "unit": "°C"
      },
      "visual": {
        "x": 200,
        "y": 220,
        "rotation": 0
      },
      "label": "Temperatura ambiente"
    },
    {
      "id": "c_tau",
      "typeId": "control.constant",
      "properties": {
        "value": 15,
        "unit": "s"
      },
      "visual": {
        "x": 200,
        "y": 280,
        "rotation": 0
      },
      "label": "Constante de tempo do poço termométrico"
    },
    {
      "id": "c_r0",
      "typeId": "control.constant",
      "properties": {
        "value": 100,
        "unit": "Ω"
      },
      "visual": {
        "x": 200,
        "y": 340,
        "rotation": 0
      },
      "label": "R0 do sensor (resistência a 0 °C)"
    },
    {
      "id": "c_lead",
      "typeId": "control.constant",
      "properties": {
        "value": 0.5,
        "unit": "Ω"
      },
      "visual": {
        "x": 200,
        "y": 400,
        "rotation": 0
      },
      "label": "Resistência de cada fio do cabo do sensor"
    },
    {
      "id": "c_dev",
      "typeId": "control.constant",
      "properties": {
        "value": 0,
        "unit": "°C"
      },
      "visual": {
        "x": 200,
        "y": 460,
        "rotation": 0
      },
      "label": "Desvio do sensor (erro do Pt100)"
    },
    {
      "id": "c_broken",
      "typeId": "control.constant",
      "properties": {
        "value": 0,
        "unit": "",
        "options": "0=Não;1=Sim (circuito aberto)"
      },
      "visual": {
        "x": 200,
        "y": 520,
        "rotation": 0
      },
      "label": "Sensor rompido"
    },
    {
      "id": "c_level",
      "typeId": "control.constant",
      "properties": {
        "value": 80,
        "unit": "%"
      },
      "visual": {
        "x": 200,
        "y": 640,
        "rotation": 0
      },
      "label": "Nível de água (desenho)"
    },
    {
      "id": "u",
      "typeId": "control.observer",
      "properties": {
        "unit": "%",
        "observerOnly": true,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 40,
        "y": 200,
        "rotation": 0
      },
      "label": "Aquecimento"
    },
    {
      "id": "q_heat",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "1000*P*((u>0)*(u<100)*u+(u>99.9999)*100)/100",
        "inputs": [
          "u",
          "P"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 40,
        "rotation": 0
      },
      "label": "Potência do aquecedor (W)"
    },
    {
      "id": "q_loss",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "UA*(T-Ta)",
        "inputs": [
          "T",
          "UA",
          "Ta"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 100,
        "rotation": 0
      },
      "label": "Perdas para o ambiente (W)"
    },
    {
      "id": "mc",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "4186*V",
        "inputs": [
          "V"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 160,
        "rotation": 0
      },
      "label": "Capacidade térmica m·c (J/K)"
    },
    {
      "id": "heat_in",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "((T<100)*q+(T>99.9999)*((q<l)*q+(q>l-0.000001)*l))/mc",
        "inputs": [
          "q",
          "l",
          "T",
          "mc"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 220,
        "rotation": 0
      },
      "label": "Ganho de temperatura (K/s)"
    },
    {
      "id": "heat_out",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "l/mc",
        "inputs": [
          "l",
          "mc"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 280,
        "rotation": 0
      },
      "label": "Perda de temperatura (K/s)"
    },
    {
      "id": "temp",
      "typeId": "control.tank",
      "properties": {
        "area": 1,
        "initial": 25,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 40,
        "y": 320,
        "rotation": 0
      },
      "label": "Temperatura da água (°C)"
    },
    {
      "id": "tau_th",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "mc/UA/60",
        "inputs": [
          "mc",
          "UA"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 340,
        "rotation": 0
      },
      "label": "Constante de tempo térmica (min)"
    },
    {
      "id": "well_in",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "T/((tau>0.1)*tau+(tau<0.1)*0.1)",
        "inputs": [
          "T",
          "tau"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 400,
        "rotation": 0
      },
      "label": "Poço: entrada"
    },
    {
      "id": "well_out",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "Ts/((tau>0.1)*tau+(tau<0.1)*0.1)",
        "inputs": [
          "Ts",
          "tau"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 460,
        "rotation": 0
      },
      "label": "Poço: saída"
    },
    {
      "id": "sensor_temp",
      "typeId": "control.tank",
      "properties": {
        "area": 1,
        "initial": 25,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 40,
        "y": 440,
        "rotation": 0
      },
      "label": "Temperatura no sensor (°C)"
    },
    {
      "id": "r_pt100",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "R0*(1+0.0039083*(Ts+d)+(-5.775e-07)*(Ts+d)^2+((Ts+d)<0)*(-4.183e-12)*((Ts+d)-100)*(Ts+d)^3)",
        "inputs": [
          "Ts",
          "d",
          "R0"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 520,
        "rotation": 0
      },
      "label": "Resistência do Pt100 (Ω)"
    },
    {
      "id": "r_element",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(b<0.5)*r+(b>0.5)*1000000000",
        "inputs": [
          "r",
          "b"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 580,
        "rotation": 0
      },
      "label": "Elemento (rompido = 1 GΩ)"
    },
