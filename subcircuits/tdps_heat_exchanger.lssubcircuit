{
  "schemaVersion": 3,
  "typeId": "subcircuits.tdps.heat_exchanger",
  "name": "TDPS - Trocador de Calor",
  "language": "pt-BR",
  "folderPath": [
    "Process",
    "TDPS Convertidos"
  ],
  "workspaceSection": "process",
  "help": {
    "description": "Cenario didatico TDPS convertido com mistura de vapor/temperatura, duas constantes de tempo, atuador e tempo morto."
  },
  "components": [
    {
      "id": "steam-tunnel",
      "typeId": "connectors.tunnel",
      "properties": {
        "name": "steam",
        "pinId": "steam",
        "defaultValue": 0
      },
      "visual": {
        "x": 40,
        "y": 70,
        "rotation": 0
      }
    },
    {
      "id": "inletTemperature-tunnel",
      "typeId": "connectors.tunnel",
      "properties": {
