        "defaultValue": 0
      },
      "visual": {
        "x": 40,
        "y": 150,
        "rotation": 0
      }
    },
    {
      "id": "balance",
      "typeId": "control.calc_expression",
      "label": "Modelo estatico",
      "properties": {
        "expression": "0.65*x0+0.35*x1",
        "inputs": [
          "x0",
          "x1"
        ]
      },
      "visual": {
        "x": 210,
        "y": 110,
        "rotation": 0
      }
    },
    {
      "id": "plant",
      "typeId": "control.process",
      "label": "TDPS - Trocador de Calor",
      "properties": {
        "gain": 1.1,
        "tau1": 12,
        "tau2": 3.5,
        "deadTime": 1.2,
        "actuatorTau": 0.8,
        "hysteresis": 0,
        "stiction": 0.3,
        "rateLimiter": 15,
        "lead": 0,
        "lag": 0,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 420,
        "y": 110,
        "rotation": 0
      }
    },
    {
      "id": "outletTemperature-tunnel",
      "typeId": "connectors.tunnel",
      "properties": {
        "name": "outletTemperature",
        "pinId": "outletTemperature"
      },
      "visual": {
        "x": 640,
        "y": 110,
        "rotation": 180
      }
    }
  ],
  "topology": {
    "revision": 0,
    "nodes": [],
