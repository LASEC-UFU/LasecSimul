    {
      "id": "pv_in",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) - 4)/16*100",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 300,
        "rotation": 0
      },
      "label": "PV: sinal de entrada em % (4-20 mA)"
    },
    {
      "id": "in_pct",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) - u(2))/((u(3) - u(2) > 0.1)*(u(3) - u(2)) + (u(3) - u(2) < 0.1001)*0.1)*100 + ((u(1) - u(2))/((u(3) - u(2) > 0.1)*(u(3) - u(2)) + (u(3) - u(2) < 0.1001)*0.1)*100 < 0)*(0 - (u(1) - u(2))/((u(3) - u(2) > 0.1)*(u(3) - u(2)) + (u(3) - u(2) < 0.1001)*0.1)*100) + ((u(1) - u(2))/((u(3) - u(2) > 0.1)*(u(3) - u(2)) + (u(3) - u(2) < 0.1001)*0.1)*100 > 100)*(100 - (u(1) - u(2))/((u(3) - u(2) > 0.1)*(u(3) - u(2)) + (u(3) - u(2) < 0.1001)*0.1)*100)",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 360,
        "rotation": 0
      },
      "label": "Entrada em % do split range"
    },
    {
      "id": "sp_src",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(2) < 0.5)*u(1) + (u(2) > 0.5)*(u(3) + (u(3) < 0)*(0 - u(3)) + (u(3) > 100)*(100 - u(3)))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 420,
        "rotation": 0
      },
      "label": "Setpoint: Auto (4-20 mA) ou Man (SP%)"
    },
    {
      "id": "sp_char",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(2) > -0.5)*(u(2) < 0.5)*u(1) + (u(2) > 0.5)*(u(2) < 1.5)*(100*(25^(u(1)/100) - 1)/(25 - 1)) + (u(2) > 1.5)*(u(2) < 2.5)*(100*(33^(u(1)/100) - 1)/(33 - 1)) + (u(2) > 2.5)*(u(2) < 3.5)*(100*(50^(u(1)/100) - 1)/(50 - 1)) + (u(2) > 3.5)*(u(2) < 4.5)*(100*25*(u(1)/100)/(1 + (25 - 1)*(u(1)/100))) + (u(2) > 4.5)*(u(2) < 5.5)*(100*33*(u(1)/100)/(1 + (33 - 1)*(u(1)/100))) + (u(2) > 5.5)*(u(2) < 6.5)*(100*50*(u(1)/100)/(1 + (50 - 1)*(u(1)/100)))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 480,
        "rotation": 0
      },
      "label": "CHAR: setpoint caracterizado (%)"
    },
    {
      "id": "sp_lim",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "u(1) + (u(1) < u(2))*(u(2) - u(1)) + (u(1) > u(3))*(u(3) - u(1))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 540,
        "rotation": 0
      },
      "label": "Limites do setpoint"
    },
    {
      "id": "sp_t",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(3) > 0.0001)*(u(2) < u(3))*(0 - 5) + (1 - (u(3) > 0.0001)*(u(2) < u(3)))*u(1)",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 600,
        "rotation": 0
      },
      "label": "TSO: abaixo do limite, fecha estanque"
    },
    {
      "id": "sp_rate",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "20*(u(1) - u(2)) + (20*(u(1) - u(2)) < 0 - 100/((u(3) > 0.1)*u(3) + (u(3) < 0.1001)*0.1))*(0 - 100/((u(3) > 0.1)*u(3) + (u(3) < 0.1001)*0.1) - 20*(u(1) - u(2))) + (20*(u(1) - u(2)) > 100/((u(3) > 0.1)*u(3) + (u(3) < 0.1001)*0.1))*(100/((u(3) > 0.1)*u(3) + (u(3) < 0.1001)*0.1) - 20*(u(1) - u(2)))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 660,
        "rotation": 0
      },
      "label": "TIME: taxa do setpoint (%/s)"
    },
    {
      "id": "sp_r",
      "typeId": "sl.discrete_time_integrator",
      "properties": {
        "IntegratorMethod": "Integration: Forward Euler",
        "gainval": "1",
        "InitialCondition": "0",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 420,
        "y": 600,
        "rotation": 0
      },
      "label": "Setpoint de posição (%)"
    },
    {
      "id": "setup_in",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "u(1) > 0.5",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 720,
        "rotation": 0
      },
      "label": "Auto Setup: contagem"
    },
    {
      "id": "setup_reset",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) < 0.5)*10*u(2)",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 780,
        "rotation": 0
      },
      "label": "Auto Setup: zera"
    },
    {
      "id": "setup_timer",
      "typeId": "process.accumulator",
      "properties": {
        "initial": 0,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 420,
        "y": 660,
        "rotation": 0
      },
      "label": "Tempo do Auto Setup (s)"
    },
    {
      "id": "setup_active",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) > 0.5)*(u(2) < 50)",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 840,
        "rotation": 0
      },
      "label": "Auto Setup em andamento"
    },
    {
      "id": "setup_progress",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) > 0.5)*((u(2) < 50)*u(2)*2 + (u(2) > 49.9999)*100)",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 900,
        "rotation": 0
      },
      "label": "Auto Setup (%)"
    },
    {
      "id": "hold_rest_in",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) > 0.5)*(u(2) > 20)*(u(2) < 25)*(u(3) - u(4) > 0)*(u(3) - u(4))*5",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 640,
        "y": 960,
        "rotation": 0
      },
      "label": "Auto Setup: grava a posição (rest)"
    },
    {
      "id": "hold_rest_out",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) > 0.5)*(u(2) > 20)*(u(2) < 25)*(u(4) - u(3) > 0)*(u(4) - u(3))*5",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 300,
        "rotation": 0
      },
      "label": "Auto Setup: grava a posição (rest)"
    },
    {
      "id": "hold_rest",
      "typeId": "process.accumulator",
      "properties": {
        "initial": 0,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 420,
        "y": 720,
        "rotation": 0
      },
      "label": "Posição sem ar (mm)"
    },
    {
      "id": "hold_full_in",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) > 0.5)*(u(2) > 45)*(u(2) < 50)*(u(3) - u(4) > 0)*(u(3) - u(4))*5",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 360,
        "rotation": 0
      },
      "label": "Auto Setup: grava a posição (full)"
    },
    {
      "id": "hold_full_out",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) > 0.5)*(u(2) > 45)*(u(2) < 50)*(u(4) - u(3) > 0)*(u(4) - u(3))*5",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 420,
        "rotation": 0
      },
      "label": "Auto Setup: grava a posição (full)"
    },
    {
      "id": "hold_full",
      "typeId": "process.accumulator",
      "properties": {
        "initial": 30,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 420,
        "y": 780,
        "rotation": 0
      },
      "label": "Posição com ar total (mm)"
    },
    {
      "id": "pos_raw",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) - ((u(2) < u(3))*u(2) + (1 - (u(2) < u(3)))*u(3)))/(((u(2) < u(3))*u(3) + (1 - (u(2) < u(3)))*u(2) - ((u(2) < u(3))*u(2) + (1 - (u(2) < u(3)))*u(3)) > 0.1)*((u(2) < u(3))*u(3) + (1 - (u(2) < u(3)))*u(2) - ((u(2) < u(3))*u(2) + (1 - (u(2) < u(3)))*u(3))) + ((u(2) < u(3))*u(3) + (1 - (u(2) < u(3)))*u(2) - ((u(2) < u(3))*u(2) + (1 - (u(2) < u(3)))*u(3)) < 0.1001)*0.1)*100",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 480,
        "rotation": 0
      },
      "label": "Abertura medida pelo sensor (% do curso calibrado)"
    },
    {
      "id": "pos_trim",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) - u(2))/((u(3) - u(2) > 0.1)*(u(3) - u(2)) + (u(3) - u(2) < 0.1001)*0.1)*100",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 540,
        "rotation": 0
      },
      "label": "LOPOS/UPPOS"
    },
    {
      "id": "pos",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(1 - ((u(2) > 0.5)*(u(2) < 1.5) + (u(2) > 2.5)))*u(1) + ((u(2) > 0.5)*(u(2) < 1.5) + (u(2) > 2.5))*(100 - u(1))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 600,
        "rotation": 0
      },
      "label": "Posição (%): direta ou reversa (TYPE)"
    },
    {
      "id": "err",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(1 - 2*(u(3) > 0.5))*(u(1) - u(2))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 660,
        "rotation": 0
      },
      "label": "Desvio do servo (com o efeito do ar)"
    },
    {
      "id": "u",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "3*u(3)*(u(1) + u(2))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 720,
        "rotation": 0
      },
      "label": "Saída do PI (%)"
    },
    {
      "id": "servo_i_in",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(1 - u(4))*(u(3) > 0.001)*(1 - (u(2) > 100)*(u(1) > 0) - (u(2) < 0)*(u(1) < 0))*u(1)/(((u(3) > 0.001)*u(3) + (u(3) < 0.0011)*1)*60) - u(4)*5*u(5)",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 780,
        "rotation": 0
      },
      "label": "TR: integral (anti-saturação; zerada no Auto Setup)"
    },
    {
      "id": "servo_i",
      "typeId": "sl.discrete_time_integrator",
      "properties": {
        "IntegratorMethod": "Integration: Forward Euler",
        "gainval": "1",
        "InitialCondition": "0",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 420,
        "y": 840,
        "rotation": 0
      },
      "label": "Integral do servo"
    },
    {
      "id": "out_pct",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(4) > 3.8)*(u(2)*(u(3) > 25)*100 + (1 - u(2))*(u(1) + (u(1) < 0)*(0 - u(1)) + (u(1) > 100)*(100 - u(1))))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 840,
        "rotation": 0
      },
      "label": "Sinal do piezo/carretel (% do suprimento); sem sinal (< 3,8 mA) a saída esvazia"
    },
    {
      "id": "out1_bar",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "u(1)/100*((u(2) > 0)*u(2))",
        "SampleTime": "0.001"
      },
      "visual": {
        "x": 860,
        "y": 900,
        "rotation": 0
      },
      "label": "OUT1 (bar)"
    },
