    {
      "id": "pv_in",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(i-4)/16*100",
        "inputs": [
          "i"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 640,
        "y": 300,
        "rotation": 0
      },
      "label": "PV: sinal de entrada em % (4-20 mA)"
    },
    {
      "id": "in_pct",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "((i-lo)/(((hi-lo)>0.1)*(hi-lo)+((hi-lo)<0.1001)*0.1)*100)+(((i-lo)/(((hi-lo)>0.1)*(hi-lo)+((hi-lo)<0.1001)*0.1)*100)<0)*(0-((i-lo)/(((hi-lo)>0.1)*(hi-lo)+((hi-lo)<0.1001)*0.1)*100))+(((i-lo)/(((hi-lo)>0.1)*(hi-lo)+((hi-lo)<0.1001)*0.1)*100)>100)*(100-((i-lo)/(((hi-lo)>0.1)*(hi-lo)+((hi-lo)<0.1001)*0.1)*100))",
        "inputs": [
          "i",
          "lo",
          "hi"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 640,
        "y": 360,
        "rotation": 0
      },
      "label": "Entrada em % do split range"
    },
    {
      "id": "sp_src",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(m<0.5)*x+(m>0.5)*((sp)+((sp)<0)*(0-(sp))+((sp)>100)*(100-(sp)))",
        "inputs": [
          "x",
          "m",
          "sp"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 640,
        "y": 420,
        "rotation": 0
      },
      "label": "Setpoint: Auto (4-20 mA) ou Man (SP%)"
    },
    {
      "id": "sp_char",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(c>-0.5)*(c<0.5)*(x)+(c>0.5)*(c<1.5)*(100*(25^(x/100)-1)/(25-1))+(c>1.5)*(c<2.5)*(100*(33^(x/100)-1)/(33-1))+(c>2.5)*(c<3.5)*(100*(50^(x/100)-1)/(50-1))+(c>3.5)*(c<4.5)*(100*25*(x/100)/(1+(25-1)*(x/100)))+(c>4.5)*(c<5.5)*(100*33*(x/100)/(1+(33-1)*(x/100)))+(c>5.5)*(c<6.5)*(100*50*(x/100)/(1+(50-1)*(x/100)))",
        "inputs": [
          "x",
          "c"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 640,
        "y": 480,
        "rotation": 0
      },
      "label": "CHAR: setpoint caracterizado (%)"
    },
    {
      "id": "sp_lim",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(x)+((x)<lo)*(lo-(x))+((x)>hi)*(hi-(x))",
        "inputs": [
          "x",
          "lo",
          "hi"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 640,
        "y": 540,
        "rotation": 0
      },
      "label": "Limites do setpoint"
    },
    {
      "id": "sp_t",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(t>0.0001)*(c<t)*(0-5)+(1-(t>0.0001)*(c<t))*x",
        "inputs": [
          "x",
          "c",
          "t"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 640,
        "y": 600,
        "rotation": 0
      },
      "label": "TSO: abaixo do limite, fecha estanque"
    },
    {
      "id": "sp_rate",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(20*(x-r))+((20*(x-r))<(0-100/((T>0.1)*T+(T<0.1001)*0.1)))*((0-100/((T>0.1)*T+(T<0.1001)*0.1))-(20*(x-r)))+((20*(x-r))>(100/((T>0.1)*T+(T<0.1001)*0.1)))*((100/((T>0.1)*T+(T<0.1001)*0.1))-(20*(x-r)))",
        "inputs": [
          "x",
          "r",
          "T"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 640,
        "y": 660,
        "rotation": 0
      },
      "label": "TIME: taxa do setpoint (%/s)"
    },
    {
      "id": "sp_r",
      "typeId": "control.integrator",
      "properties": {
        "gain": 1,
        "initial": 0,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 420,
        "y": 600,
        "rotation": 0
      },
      "label": "Setpoint de posição (%)"
    },
    {
      "id": "setup_in",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(s>0.5)",
        "inputs": [
          "s"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
