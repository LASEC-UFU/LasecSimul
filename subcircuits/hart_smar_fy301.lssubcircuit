    {
      "id": "pos_raw",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(x-((a<b)*a+(1-(a<b))*b))/((((a<b)*b+(1-(a<b))*a)-((a<b)*a+(1-(a<b))*b)>0.1)*(((a<b)*b+(1-(a<b))*a)-((a<b)*a+(1-(a<b))*b))+((((a<b)*b+(1-(a<b))*a)-((a<b)*a+(1-(a<b))*b))<0.1001)*0.1)*100",
        "inputs": [
          "x",
          "a",
          "b"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 860,
        "y": 480,
        "rotation": 0
      },
      "label": "Abertura medida pelo sensor (% do curso calibrado)"
    },
    {
      "id": "pos_trim",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(p-lo)/((((up-lo)>0.1)*(up-lo))+(((up-lo)<0.1001)*0.1))*100",
        "inputs": [
          "p",
          "lo",
          "up"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 860,
        "y": 540,
        "rotation": 0
      },
      "label": "LOPOS/UPPOS"
    },
    {
      "id": "pos",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(1-((k>0.5)*(k<1.5)+(k>2.5)))*p+((k>0.5)*(k<1.5)+(k>2.5))*(100-p)",
        "inputs": [
          "p",
          "k"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 860,
        "y": 600,
        "rotation": 0
      },
      "label": "Posição (%): direta ou reversa (TYPE)"
    },
    {
      "id": "err",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(1-2*(a>0.5))*(r-p)",
        "inputs": [
          "r",
          "p",
          "a"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 860,
        "y": 660,
        "rotation": 0
      },
      "label": "Desvio do servo (com o efeito do ar)"
    },
    {
      "id": "u",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "3*kp*(e+i)",
        "inputs": [
          "e",
          "i",
          "kp"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 860,
        "y": 720,
        "rotation": 0
      },
      "label": "Saída do PI (%)"
    },
    {
      "id": "servo_i_in",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(1-a)*(tr>0.001)*(1-(u>100)*(e>0)-(u<0)*(e<0))*e/((((tr>0.001)*tr)+((tr<0.0011)*1))*60)-a*5*i",
        "inputs": [
          "e",
          "u",
          "tr",
          "a",
          "i"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 860,
        "y": 780,
        "rotation": 0
      },
      "label": "TR: integral (anti-saturação; zerada no Auto Setup)"
    },
    {
      "id": "servo_i",
      "typeId": "control.integrator",
      "properties": {
        "gain": 1,
        "initial": 0,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 420,
        "y": 840,
        "rotation": 0
      },
      "label": "Integral do servo"
    },
    {
      "id": "out_pct",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(i>3.8)*(a*(t>25)*100+(1-a)*((u)+((u)<0)*(0-(u))+((u)>100)*(100-(u))))",
        "inputs": [
          "u",
          "a",
          "t",
          "i"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 860,
        "y": 840,
        "rotation": 0
      },
      "label": "Sinal do piezo/carretel (% do suprimento); sem sinal (< 3,8 mA) a saída esvazia"
    },
    {
      "id": "out1_bar",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "o/100*((s>0)*s)",
        "inputs": [
          "o",
          "s"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 1000000
      },
      "visual": {
        "x": 860,
        "y": 900,
        "rotation": 0
      },
      "label": "OUT1 (bar)"
    }
  ],
