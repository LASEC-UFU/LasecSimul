{
  "schemaVersion": 3,
  "typeId": "subcircuits.process.hydraulic_tank",
  "name": "Tanque hidráulico (vazão → volume)",
  "language": "pt-BR",
  "folderPath": [
    "Modelos"
  ],
  "workspaceSection": "process",
  "help": {
    "description": "Tanque aberto de seção A constante para o Laboratório de Cálculo: o volume V (L) integra a vazão de entrada menos a de saída num acumulador conservativo (fundo 0, borda Vmax = 1000·A·hmax). Saída por bomba (q = q_saída) ou por válvula (q = k·h) ou por orifício (q = c·√h, Torricelli). Com a área A mudando durante a execução, V é preservado, h = V/A salta e o excesso acima da borda derrama de uma vez. Vazões, área, borda, k e o modo de saída ficam em Propriedades Exportadas e mudam com a simulação rodando; o volume inicial é a propriedade 'initial' do acumulador (com a simulação parada). Todos os blocos rodam a 10 ms."
  },
  "components": [
    {
      "id": "c_qin",
      "typeId": "control.constant",
      "properties": {
        "value": 1.0,
        "unit": "L/s"
      },
      "visual": {
        "x": 40,
        "y": 40,
        "rotation": 0
      },
      "label": "Vazão da bomba de entrada"
    },
    {
      "id": "c_qout",
      "typeId": "control.constant",
      "properties": {
        "value": 0.4,
        "unit": "L/s"
      },
      "visual": {
        "x": 40,
        "y": 100,
        "rotation": 0
      },
      "label": "Vazão da bomba de saída"
    },
    {
      "id": "c_area",
      "typeId": "control.constant",
      "properties": {
        "value": 0.1,
        "unit": "m²"
      },
      "visual": {
        "x": 40,
        "y": 160,
        "rotation": 0
      },
      "label": "Área da seção do tanque (A)"
    },
    {
      "id": "c_hmax",
      "typeId": "control.constant",
      "properties": {
        "value": 1.0,
        "unit": "m"
      },
      "visual": {
        "x": 40,
        "y": 220,
        "rotation": 0
      },
      "label": "Altura da borda (h máx.)"
    },
    {
      "id": "c_k",
      "typeId": "control.constant",
      "properties": {
        "value": 2.0,
        "unit": "L/(s·m)"
      },
      "visual": {
        "x": 40,
        "y": 280,
        "rotation": 0
      },
      "label": "Coeficiente da válvula de saída (q = k·h)"
    },
    {
      "id": "c_torr",
      "typeId": "control.constant",
      "properties": {
        "value": 1.4,
        "unit": "L/(s·√m)"
      },
      "visual": {
        "x": 40,
        "y": 340,
        "rotation": 0
      },
      "label": "Coeficiente do orifício (q = c·√h)"
    },
    {
      "id": "c_outlet",
      "typeId": "control.constant",
      "properties": {
        "value": 0.0,
        "unit": ""
      },
      "visual": {
        "x": 40,
        "y": 400,
        "rotation": 0
      },
      "label": "Saída: 0 bomba, 1 válvula linear (k·h), 2 orifício (c·√h)"
    },
    {
      "id": "vmax",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "a*hm*1000",
        "inputs": [
          "a",
          "hm"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 240,
        "y": 120,
        "rotation": 0
      },
      "label": "Volume máximo (L)"
    },
    {
      "id": "q_out",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(m<0.5)*qo+(m>0.5)*(m<1.5)*k*h+(m>1.5)*c*h^0.5",
        "inputs": [
          "qo",
          "m",
          "k",
          "c",
          "h"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 240,
        "y": 240,
        "rotation": 0
      },
      "label": "Saída demandada (L/s)"
    },
    {
      "id": "acc",
      "typeId": "control.accumulator",
      "properties": {
        "initial": 20,
        "lowerLimitEnabled": true,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "upperLimit": 100,
        "lowerInput": false,
        "upperInput": true,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 460,
        "y": 160,
        "rotation": 0
      },
      "label": "Volume (L)"
    },
    {
      "id": "h",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "v/(a*1000)",
        "inputs": [
          "v",
          "a"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 680,
        "y": 120,
        "rotation": 0
      },
      "label": "Nível h (m)"
    },
    {
      "id": "level_percent",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "100*h/hm",
        "inputs": [
          "h",
          "hm"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 680,
        "y": 220,
        "rotation": 0
      },
      "label": "Nível (%)"
    },
    {
      "id": "obs_overflow",
      "typeId": "control.observer",
      "properties": {
        "unit": "L/s",
        "observerOnly": true,
        "samplePeriodNs": 10000000
      },
      "visual": {
