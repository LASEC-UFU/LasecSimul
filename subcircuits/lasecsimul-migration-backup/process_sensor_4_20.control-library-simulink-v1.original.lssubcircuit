{
  "schemaVersion": 3,
  "typeId": "subcircuits.process.sensor_4_20",
  "name": "Sensor 4–20 mA (laboratório)",
  "language": "pt-BR",
  "folderPath": [
    "Modelos"
  ],
  "workspaceSection": "process",
  "help": {
    "description": "Transmissor de pressão como função afim: I = 4 mA + 16 mA·(P − Pmin)/(Pmax − Pmin), saturado em 3,8–20,5 mA como um laço 4–20 mA real. A saída 'raw' mostra o valor sem saturação. P muda com a simulação rodando; a faixa Pmin–Pmax é configuração. Usado pelo experimento A do Laboratório de Cálculo (função afim, ganho/offset, inversa, saturação)."
  },
  "components": [
    {
      "id": "c_p",
      "typeId": "control.constant",
      "properties": {
        "value": 100.0,
        "unit": "kPa"
      },
      "visual": {
        "x": 40,
        "y": 40,
        "rotation": 0
      },
      "label": "Pressão aplicada P"
    },
    {
      "id": "c_pmin",
      "typeId": "control.constant",
      "properties": {
        "value": 0.0,
        "unit": "kPa"
      },
      "visual": {
        "x": 40,
        "y": 100,
        "rotation": 0
      },
      "label": "Início da faixa (Pmin → 4 mA)"
    },
    {
      "id": "c_pmax",
      "typeId": "control.constant",
      "properties": {
        "value": 200.0,
        "unit": "kPa"
      },
      "visual": {
        "x": 40,
        "y": 160,
        "rotation": 0
      },
      "label": "Fim da faixa (Pmax → 20 mA)"
    },
    {
      "id": "i_raw",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "4+16*(p-pmin)/(pmax-pmin)",
        "inputs": [
          "p",
          "pmin",
          "pmax"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 240,
        "y": 80,
        "rotation": 0
      },
      "label": "Corrente sem saturação (mA)"
    },
    {
      "id": "i_loop",
      "typeId": "control.saturation",
      "properties": {
        "minimum": 3.8,
        "maximum": 20.5,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 440,
        "y": 80,
        "rotation": 0
      },
      "label": "Corrente do laço (mA)"
    },
    {
      "id": "t_current",
      "typeId": "connectors.signal_tunnel",
      "properties": {
        "name": "current",
        "pinId": "current",
        "direction": "Output",
        "valueType": "Real"
      },
      "visual": {
        "x": 640,
        "y": 80,
        "rotation": 0
      }
    },
    {
      "id": "t_raw",
      "typeId": "connectors.signal_tunnel",
      "properties": {
        "name": "raw",
        "pinId": "raw",
        "direction": "Output",
        "valueType": "Real"
      },
      "visual": {
        "x": 640,
        "y": 160,
        "rotation": 0
      }
    },
    {
      "id": "g_p",
      "typeId": "graphics.value_display",
      "properties": {
        "width": 150,
        "height": 40,
        "stroke": "currentColor",
        "fill": "#f8fafc",
        "strokeWidth": 1.5,
        "opacity": 1,
        "label": "Pressão",
        "valueColor": "#0f172a",
        "value": 0,
        "bindSource": "c_p",
        "bindChannel": 0,
        "bindScale": 1,
        "bindOffset": 0,
        "bindMin": -1000000000.0,
        "bindMax": 1000000000.0,
        "bindUnit": "kPa",
        "bindDecimals": 1
      },
      "visual": {
        "x": 210,
        "y": 50,
        "rotation": 0
      }
    },
    {
      "id": "g_i",
      "typeId": "graphics.value_display",
      "properties": {
        "width": 150,
        "height": 40,
        "stroke": "currentColor",
        "fill": "#f8fafc",
        "strokeWidth": 1.5,
        "opacity": 1,
        "label": "Corrente",
        "valueColor": "#0f172a",
        "value": 0,
        "bindSource": "i_loop",
        "bindChannel": 0,
        "bindScale": 1,
        "bindOffset": 0,
        "bindMin": -1000000000.0,
        "bindMax": 1000000000.0,
        "bindUnit": "mA",
        "bindDecimals": 3
      },
      "visual": {
        "x": 210,
        "y": 106,
        "rotation": 0
      }
    }
  ],
