    {
      "id": "calc-41",
      "typeId": "control.calc_expression",
      "label": "P->V",
      "visual": {
        "x": 594,
        "y": 156,
        "rotation": 0
      },
      "properties": {
        "expression": "(1.25*x0)/100",
        "inputs": [
          "x0"
        ],
        "upperLimit": 105,
        "lowerLimit": -5,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-42",
      "typeId": "control.calc_expression",
      "label": "V->P",
      "visual": {
        "x": 108,
        "y": 323,
        "rotation": 0
      },
      "properties": {
        "expression": "0.75*(1-((x0*1.25+x1*1.25+x2*50)/300))+0.25",
        "inputs": [
          "x0",
          "x1",
          "x2"
        ],
        "upperLimit": 1.25,
        "lowerLimit": -5,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      }
    },
