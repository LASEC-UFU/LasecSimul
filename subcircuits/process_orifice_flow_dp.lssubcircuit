    },
    {
      "id": "rhg_A",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(19000*b/(Re+(Re<1)))^0.8",
        "inputs": [
          "b",
          "Re"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 700,
        "rotation": 0
      },
      "label": "A = (19000 β / Re_D)^0,8"
    },
    {
      "id": "c_iso",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "0.5961+0.0261*b^2-0.216*b^8+0.000521*(1000000*b/(Re+(Re<1)))^0.7+(0.0188+0.0063*A)*b^3.5*(1000000/(Re+(Re<1)))^0.3+(0.043+0.080*2.718281828^(-10*L1)-0.123*2.718281828^(-7*L1))*(1-0.11*A)*b^4/(1-b^4)-0.031*(2*L2/(1-b)-0.8*(2*L2/(1-b))^1.1)*b^1.3+(D<71.12)*0.011*(0.75-b)*(2.8-D/25.4)",
        "inputs": [
          "b",
          "Re",
          "L1",
          "L2",
          "A",
          "D"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 760,
        "rotation": 0
      },
      "label": "C (ISO 5167-2)"
    },
    {
      "id": "req_up_a",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(b<0.2001)*6+(b>0.2001)*(b<0.4001)*16+(b>0.4001)*(b<0.5001)*22+(b>0.5001)*(b<0.6001)*42+(b>0.6001)*44",
        "inputs": [
          "b"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 820,
        "rotation": 0
      },
      "label": "Montante exigido, sem incerteza adicional (D)"
    },
    {
      "id": "req_up_b",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(b<0.4001)*3+(b>0.4001)*(b<0.5001)*9+(b>0.5001)*(b<0.6001)*13+(b>0.6001)*20",
        "inputs": [
          "b"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 620,
        "y": 880,
        "rotation": 0
      },
      "label": "Montante mínimo, com +0,5 % de incerteza (D)"
    },
    {
      "id": "req_dn_a",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(b<0.2001)*4+(b>0.2001)*(b<0.5001)*6+(b>0.5001)*(b<0.6701)*7+(b>0.6701)*8",
        "inputs": [
          "b"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 40,
        "rotation": 0
      },
      "label": "Jusante exigido (D)"
    },
    {
      "id": "dev_up",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(L<A)*(L>B)*0.5*(A-L)/(A-B)+(L<B+0.000001)*(0.5+1.5*(B-L)/B)",
        "inputs": [
          "L",
          "A",
          "B"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 100,
        "rotation": 0
      },
      "label": "Desvio do trecho a montante (%)"
    },
    {
      "id": "dev_dn",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(L<A)*(L>A/2)*0.25*(A-L)/(A/2)+(L<A/2+0.000001)*(0.25+0.25*(A/2-L)/(A/2))",
        "inputs": [
          "L",
          "A"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 160,
        "rotation": 0
      },
      "label": "Desvio do trecho a jusante (%)"
    },
    {
      "id": "rough_rel",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "10000*Ra/D",
        "inputs": [
          "Ra",
          "D"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 220,
        "rotation": 0
      },
      "label": "10⁴·Ra/D"
    },
    {
      "id": "rough_limit",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(b<0.3)*25+(b>0.3)*(4+21*2.718281828^(-19.1*(b-0.3)))",
        "inputs": [
          "b"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 280,
        "rotation": 0
      },
      "label": "Limite de 10⁴·Ra/D (aprox. da Tabela 1)"
    },
    {
      "id": "dev_rough",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(r>lim)*(0.5*(r/lim-1)*(r/lim<5)+2*(r/lim>5))",
        "inputs": [
          "r",
          "lim"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 340,
        "rotation": 0
      },
      "label": "Desvio por rugosidade (%)"
    },
    {
      "id": "dev_total",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "(on>0.5)*(u+d+r)",
        "inputs": [
          "on",
          "u",
          "d",
          "r"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 400,
        "rotation": 0
      },
      "label": "Desvio didático total de C (%)"
    },
    {
      "id": "c_real",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "C*(1+dev/100)",
        "inputs": [
          "C",
          "dev"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 460,
        "rotation": 0
      },
      "label": "C real (com o desvio)"
    },
    {
      "id": "dp0",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "8*rho*(1-b^4)*(q/3600)^2/(C^2*9.8696044*(d/1000)^4)",
        "inputs": [
          "q",
          "rho",
          "b",
          "C",
          "d"
        ],
        "upperLimit": 0,
        "lowerLimit": 0,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      },
      "visual": {
        "x": 840,
        "y": 520,
        "rotation": 0
      },
      "label": "ΔP sem expansibilidade (Pa)"
    },
    {
      "id": "eps1",
      "typeId": "control.calc_expression",
      "properties": {
        "expression": "1-(gas>0.5)*(0.351+0.256*b^4+0.93*b^8)*(1-(((p1+101.325-dp/1000)/(p1+101.325)>0.01)*(p1+101.325-dp/1000)/(p1+101.325)+((p1+101.325-dp/1000)/(p1+101.325)<0.01)*0.01)^(1/k))",
        "inputs": [
          "gas",
          "b",
          "p1",
          "k",
          "dp"
        ],
        "upperLimit": 0,
