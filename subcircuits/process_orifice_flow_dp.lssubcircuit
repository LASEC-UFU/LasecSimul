      "properties": {
        "Expr": "(u(1) + 101.325 - u(2)/1000)/(u(1) + 101.325)",
        "SampleTime": "0.01"
      },
      "visual": {
        "x": 1060,
        "y": 100,
        "rotation": 0
      },
      "label": "p2/p1"
    },
    {
      "id": "p_high",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "101.97162*u(1)",
        "SampleTime": "0.01"
      },
      "visual": {
        "x": 1060,
        "y": 160,
        "rotation": 0
      },
      "label": "Tomada de alta (mmH2O)"
    },
    {
      "id": "p_low",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "u(1) - u(2)",
        "SampleTime": "0.01"
      },
      "visual": {
        "x": 1060,
        "y": 220,
        "rotation": 0
      },
      "label": "Tomada de baixa (mmH2O)"
    },
    {
      "id": "is_flange",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "u(1) < 1.5",
        "SampleTime": "0.01"
      },
      "visual": {
        "x": 1060,
        "y": 280,
        "rotation": 0
      },
      "label": "Tomada flange"
    },
    {
      "id": "is_dd2",
      "typeId": "sl.fcn",
      "properties": {
        "Expr": "(u(1) > 1.5)*(u(1) < 2.5)",
        "SampleTime": "0.01"
      },
