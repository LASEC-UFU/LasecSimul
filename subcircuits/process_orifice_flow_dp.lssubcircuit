      "properties": {
        "Expr": "(u(1) > 0.0999)*(u(1) < 0.7501)*(u(2) > 49.999)*(u(2) < 1000.001)*(u(3) > 12.499)*(u(4) > 5000)*((u(5) < 1.5)*(u(4) > 170*u(1)^2*u(2)) + (u(5) > 1.5)*((u(1) < 0.56) + (u(1) > 0.56)*(u(4) > 16000*u(1)^2)) > 0.5)*((u(6) < 0.5) + (u(7) > 0.75) > 0.5)",
        "SampleTime": "0.01"
      },
