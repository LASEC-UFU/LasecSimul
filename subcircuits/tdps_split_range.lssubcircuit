      "id": "pid-01",
      "typeId": "control.pid",
      "label": "TC",
      "visual": {
        "x": 220,
        "y": 1200,
        "rotation": 0
      },
      "properties": {
        "kc": 3,
        "ti": 11.0189,
        "td": 2.4456,
        "bias": 50,
        "derivativeFilter": 0.000001,
        "outputMin": 0,
        "outputMax": 100,
        "action": 1,
        "derivativeOnPv": true,
        "remoteSpEnabled": false,
        "feedForwardEnabled": false,
        "autoMode": true,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "process-23",
      "typeId": "control.process",
      "label": "Temp",
      "visual": {
        "x": 500,
        "y": 696,
        "rotation": 0
      },
      "properties": {
        "tau1": 10,
        "tau2": 0,
        "saturationEnabled": true,
        "hysteresis": 0,
        "deadTime": 1.5,
        "gain": 0.04,
        "valveType": 0,
        "stiction": 0,
        "rateLimiter": 0,
        "actuatorTau": 2,
        "transferFunctionType": 3,
        "lead": 0,
        "lag": 0,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-42",
      "typeId": "control.calc_expression",
      "label": "Faixa MV1",
      "visual": {
        "x": 220,
        "y": 712,
        "rotation": 0
      },
      "properties": {
        "expression": "(x0-0)*((x1-x2)/(x3-0))+x2",
        "inputs": [
          "x0",
          "x1",
          "x2",
          "x3"
        ],
        "upperLimit": 100,
        "lowerLimit": 0,
        "upperLimitEnabled": true,
        "lowerLimitEnabled": true,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-43",
      "typeId": "control.calc_expression",
      "label": "Faixa MV2",
      "visual": {
        "x": 220,
        "y": 880,
        "rotation": 0
      },
      "properties": {
        "expression": "(x0-x1)*((x2-x3)/(100-x1))+x3",
        "inputs": [
          "x0",
          "x1",
          "x2",
          "x3"
        ],
        "upperLimit": 100,
        "lowerLimit": 0,
        "upperLimitEnabled": true,
        "lowerLimitEnabled": true,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-44",
      "typeId": "control.calc_expression",
      "label": "Calor -",
      "visual": {
        "x": 220,
        "y": 560,
        "rotation": 0
      },
      "properties": {
        "expression": "(x0-x1*1/2)-x2",
        "inputs": [
          "x0",
          "x1",
          "x2"
        ],
        "upperLimit": 105,
        "lowerLimit": -5,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-45",
      "typeId": "control.calc_expression",
      "label": "Calor +",
      "visual": {
        "x": 220,
        "y": 1048,
        "rotation": 0
      },
      "properties": {
        "expression": "(x0*2/2+x1)-x2",
        "inputs": [
          "x0",
          "x1",
          "x2"
        ],
        "upperLimit": 105,
        "lowerLimit": -5,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-46",
      "typeId": "control.calc_expression",
      "label": "SaldoCalor",
      "visual": {
        "x": 500,
        "y": 560,
        "rotation": 0
      },
      "properties": {
        "expression": "x0+x1",
        "inputs": [
          "x0",
          "x1"
        ],
        "upperLimit": 105,
        "lowerLimit": -5,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      }
    },
