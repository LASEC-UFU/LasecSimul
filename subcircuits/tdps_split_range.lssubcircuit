    {
      "id": "calc-42",
      "typeId": "control.calc_expression",
      "label": "Faixa MV1",
      "visual": {
        "x": 220,
        "y": 712,
        "rotation": 0
      },
      "properties": {
        "expression": "(x0-0)*((x1-x2)/(x3-0))+x2",
        "inputs": [
          "x0",
          "x1",
          "x2",
          "x3"
        ],
        "upperLimit": 100,
        "lowerLimit": 0,
        "upperLimitEnabled": true,
        "lowerLimitEnabled": true,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-43",
      "typeId": "control.calc_expression",
      "label": "Faixa MV2",
      "visual": {
        "x": 220,
        "y": 880,
        "rotation": 0
      },
      "properties": {
        "expression": "(x0-x1)*((x2-x3)/(100-x1))+x3",
        "inputs": [
          "x0",
          "x1",
          "x2",
          "x3"
        ],
        "upperLimit": 100,
        "lowerLimit": 0,
        "upperLimitEnabled": true,
        "lowerLimitEnabled": true,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-44",
      "typeId": "control.calc_expression",
      "label": "Calor -",
      "visual": {
        "x": 220,
        "y": 560,
        "rotation": 0
      },
      "properties": {
        "expression": "(x0-x1*1/2)-x2",
        "inputs": [
          "x0",
          "x1",
          "x2"
        ],
        "upperLimit": 105,
        "lowerLimit": -5,
        "upperLimitEnabled": false,
        "lowerLimitEnabled": false,
        "samplePeriodNs": 10000000
      }
    },
    {
      "id": "calc-45",
