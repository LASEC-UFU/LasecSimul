{
  "schemaVersion": 3,
  "typeId": "subcircuits.tdps.smith_predictor",
  "name": "TDPS - Preditor de Smith",
  "language": "pt-BR",
  "folderPath": ["Controle de Processos", "TDPS importado"],
  "workspaceSection": "process",
  "help": { "description": "Estrategia de Preditor de Smith convertida para componentes e topologia canonicos; nenhuma referencia Mnn permanece no runtime." },
  "components": [
    { "id": "sp", "typeId": "connectors.tunnel", "properties": { "name": "setpoint", "pinId": "setpoint", "defaultValue": 17 }, "visual": { "x": 20, "y": 80, "rotation": 0 } },
    { "id": "disturbance-in", "typeId": "connectors.tunnel", "properties": { "name": "disturbance", "pinId": "disturbance", "defaultValue": 50 }, "visual": { "x": 20, "y": 170, "rotation": 0 } },
    { "id": "selector-in", "typeId": "connectors.tunnel", "properties": { "name": "selector", "pinId": "selector", "defaultValue": 1 }, "visual": { "x": 20, "y": 260, "rotation": 0 } },
    { "id": "control-signal", "typeId": "connectors.tunnel", "properties": { "name": "controlSignal", "pinId": "controlSignal", "defaultValue": 1 }, "visual": { "x": 20, "y": 350, "rotation": 0 } },
    { "id": "pid", "typeId": "control.pid", "label": "ZIC", "properties": { "kc": 1, "ti": 3, "td": 0, "bias": 50, "derivativeFilter": 0.1, "outputMin": 0, "outputMax": 100, "action": 1, "derivativeOnPv": true, "samplePeriodNs": 100000000 }, "visual": { "x": 180, "y": 90, "rotation": 0 } },
    { "id": "process-real", "typeId": "control.process", "label": "G", "properties": { "gain": 1.15, "tau1": 3, "tau2": 0, "deadTime": 12, "actuatorTau": 0, "hysteresis": 0, "stiction": 0, "rateLimiter": 0, "lead": 0, "lag": 0, "samplePeriodNs": 10000000 }, "visual": { "x": 360, "y": 80, "rotation": 0 } },
    { "id": "process-model", "typeId": "control.process", "label": "Gtil", "properties": { "gain": 1.15, "tau1": 3, "tau2": 0, "deadTime": 0, "actuatorTau": 0, "hysteresis": 0, "stiction": 0, "rateLimiter": 0, "lead": 0, "lag": 0, "samplePeriodNs": 10000000 }, "visual": { "x": 360, "y": 190, "rotation": 0 } },
    { "id": "model-delay", "typeId": "control.process", "label": "Delay", "properties": { "gain": 1, "tau1": 0, "tau2": 0, "deadTime": 12, "actuatorTau": 0, "hysteresis": 0, "stiction": 0, "rateLimiter": 0, "lead": 0, "lag": 0, "samplePeriodNs": 10000000 }, "visual": { "x": 360, "y": 300, "rotation": 0 } },
    { "id": "disturbance-model", "typeId": "control.process", "label": "D", "properties": { "gain": 1, "tau1": 0, "tau2": 0, "deadTime": 0, "actuatorTau": 0, "hysteresis": 0, "stiction": 0, "rateLimiter": 0, "lead": 0, "lag": 0, "samplePeriodNs": 10000000 }, "visual": { "x": 360, "y": 410, "rotation": 0 } },
    { "id": "measured-pv", "typeId": "control.calc_expression", "label": "PV_medida", "properties": { "expression": "x0+x1-50", "inputs": ["x0", "x1"], "upperLimitEnabled": false, "lowerLimitEnabled": false, "samplePeriodNs": 10000000 }, "visual": { "x": 600, "y": 80, "rotation": 0 } },
    { "id": "prediction-error", "typeId": "control.calc_expression", "label": "DesvioPS", "properties": { "expression": "x0-x1", "inputs": ["x0", "x1"], "upperLimitEnabled": false, "lowerLimitEnabled": false, "samplePeriodNs": 10000000 }, "visual": { "x": 600, "y": 190, "rotation": 0 } },
    { "id": "feedback-pv", "typeId": "control.calc_expression", "label": "PV_Realim", "properties": { "expression": "x0+x1", "inputs": ["x0", "x1"], "upperLimitEnabled": false, "lowerLimitEnabled": false, "samplePeriodNs": 10000000 }, "visual": { "x": 600, "y": 300, "rotation": 0 } },
    { "id": "selected-control", "typeId": "control.calc_expression", "label": "Sel", "properties": { "expression": "x0*x1", "inputs": ["x0", "x1"], "upperLimitEnabled": false, "lowerLimitEnabled": false, "samplePeriodNs": 10000000 }, "visual": { "x": 600, "y": 410, "rotation": 0 } },
    { "id": "pv-out", "typeId": "connectors.tunnel", "properties": { "name": "pv", "pinId": "pv" }, "visual": { "x": 850, "y": 90, "rotation": 180 } },
    { "id": "prediction-out", "typeId": "connectors.tunnel", "properties": { "name": "predictionError", "pinId": "predictionError" }, "visual": { "x": 850, "y": 200, "rotation": 180 } },
    { "id": "controller-out", "typeId": "connectors.tunnel", "properties": { "name": "controllerOutput", "pinId": "controllerOutput" }, "visual": { "x": 850, "y": 310, "rotation": 180 } }
  ],
