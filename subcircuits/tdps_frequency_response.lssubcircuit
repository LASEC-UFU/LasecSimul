      "typeId": "control.calc_expression",
      "label": "FY101",
      "visual": {
        "x": 220,
        "y": 200,
        "rotation": 0
      },
      "properties": {
        "expression": "(1-0.35*x0*x1)*x2+x3*x4+x5*x6",
        "inputs": [
          "x0",
          "x1",
          "x2",
          "x3",
          "x4",
