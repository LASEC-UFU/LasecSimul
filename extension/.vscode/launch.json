{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LasecSimul Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js", "${workspaceFolder}/out-webview/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "Run SSD1306 regression (II1P04)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../../II1P04_GPIO_Debug"
      ],
      "env": {
        "LASECSIMUL_E2E_FIXTURE": "${workspaceFolder}/../../II1P04_GPIO_Debug/lasecSimul/display.lsproj"
      },
      "outFiles": ["${workspaceFolder}/out/**/*.js", "${workspaceFolder}/out-webview/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    }
  ]
}
