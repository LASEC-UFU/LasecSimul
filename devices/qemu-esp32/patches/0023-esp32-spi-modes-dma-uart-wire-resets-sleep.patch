+        /* Deep sleep ends in a digital reset (the boot ROM prints rst:0x5 (DEEPSLEEP_RESET)); the RTC
+         * domain, RTC memory and these registers stay. */
+        s->reset_cause[0] = ESP32_DEEPSLEEP_RESET;
+        s->reset_cause[1] = ESP32_DEEPSLEEP_RESET;
+        qemu_set_irq(s->dig_power_down, 0);
+        esp32_rtc_update_cpu_stall(s);
+        qemu_irq_pulse(s->dig_reset_req);
+        return;
+    }
+    s->int_raw |= ESP32_RTC_SLP_WAKEUP_INT;
+    qemu_set_irq(s->dig_clock_gate, 0); /* the clocks first, then the cores run */
+    esp32_rtc_update_irq(s);
+    esp32_rtc_update_cpu_stall(s);
