+/* Wakeup sources (ESP-IDF soc/rtc.h, RTC_*_TRIG_EN): the same bits in WAKEUP_ENA and WAKEUP_CAUSE. */
+#define ESP32_RTC_EXT0_TRIG   BIT(0)
+#define ESP32_RTC_EXT1_TRIG   BIT(1)
