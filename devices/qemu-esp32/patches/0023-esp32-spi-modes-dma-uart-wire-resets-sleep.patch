diff --git a/hw/misc/esp32_rtcio.c b/hw/misc/esp32_rtcio.c
new file mode 100644
index 0000000..07cc64c
--- /dev/null
+++ b/hw/misc/esp32_rtcio.c
@@ -0,0 +1,120 @@
+/*
+ * ESP32 RTC IO MUX
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32_rtcio.h"
+#include "../softmmu/vnext_b.h"
+
+/* The registers keep what the firmware writes, from the reset values of ESP-IDF rtc_io_reg.h; the RTC
+ * domain reads its selections from here (the ext0 wakeup pin for RTC_CNTL). */
+
+static Esp32RtcIoState *esp32_rtcio_device;
+
+/* RTC GPIO n -> GPIO (ESP32 TRM, RTC_MUX pin list). */
+static const int8_t esp32_rtcio_gpio[18] = { 36, 37, 38, 39, 34, 35, 25, 26, 33, 32, 4, 0, 2, 15, 13, 12, 14, 27 };
+
+int esp32_rtcio_gpio_of(unsigned rtc)
+{
+    return rtc < ARRAY_SIZE(esp32_rtcio_gpio) ? esp32_rtcio_gpio[rtc] : -1;
+}
+
+unsigned esp32_rtcio_ext0_sel(void)
+{
+    Esp32RtcIoState *s = esp32_rtcio_device;
+    return s ? FIELD_EX32(s->regs[A_RTC_IO_EXT_WAKEUP0 / 4], RTC_IO_EXT_WAKEUP0, SEL) : 0;
+}
+
+/* Level of GPIO `gpio` at the pad, from the vNext-B snapshot (the Core sees the pads). */
+bool esp32_rtcio_pad_level(int gpio)
+{
+    if (gpio < 0 || gpio > 39) return false;
+    const uint64_t in = vnext_b_gpio_read(gpio < 32 ? 0x3FF4403C : 0x3FF44040);
+    return (in >> (gpio % 32)) & 1;
+}
+
+static uint64_t esp32_rtcio_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32RtcIoState *s = ESP32_RTCIO(opaque);
+    if (addr == 0x24) { /* RTC_GPIO_IN: NEXT [31:14], one bit per RTC GPIO, the level at the pad now */
+        vnext_b_lockstep_input_barrier();
+        uint32_t value = 0;
+        for (unsigned rtc = 0; rtc < ARRAY_SIZE(esp32_rtcio_gpio); rtc++)
+            if (esp32_rtcio_pad_level(esp32_rtcio_gpio[rtc])) value |= 1u << (14 + rtc);
+        return value;
+    }
+    return addr / 4 < ESP32_RTCIO_REGS ? s->regs[addr / 4] : 0;
+}
+
+static void esp32_rtcio_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    Esp32RtcIoState *s = ESP32_RTCIO(opaque);
+    if (addr / 4 >= ESP32_RTCIO_REGS) return;
+    /* *_W1TS / *_W1TC of RTC_GPIO_OUT, _ENABLE and _STATUS (0x04/0x08, 0x10/0x14, 0x1C/0x20). */
+    switch (addr) {
+    case 0x04: case 0x10: case 0x1C:
+        s->regs[addr / 4 - 1] |= value;
+        return;
+    case 0x08: case 0x14: case 0x20:
+        s->regs[addr / 4 - 2] &= ~value;
+        return;
+    }
+    s->regs[addr / 4] = value;
+}
+
+static const MemoryRegionOps esp32_rtcio_ops = {
+    .read = esp32_rtcio_read,
+    .write = esp32_rtcio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32_rtcio_reset(DeviceState *dev)
+{
+    Esp32RtcIoState *s = ESP32_RTCIO(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    /* ESP-IDF rtc_io_reg.h defaults */
+    s->regs[0x84 / 4] = 0x80000000; /* PAD_DAC1 */
+    s->regs[0x88 / 4] = 0x80000000; /* PAD_DAC2 */
+    s->regs[0x8C / 4] = 0x84100010; /* XTAL_32K_PAD */
+    s->regs[0x90 / 4] = 0x66000000; /* TOUCH_CFG */
+    static const uint32_t touch_pad[10] = { 0x52000000, 0x4a000000, 0x52000000, 0x4a000000, 0x52000000,
+                                            0x52000000, 0x4a000000, 0x42000000, 0x02000000, 0x02000000 };
+    for (int i = 0; i < 10; i++) s->regs[(0x94 + 4 * i) / 4] = touch_pad[i];
+    s->regs[0xC8 / 4] = 0x01603160; /* DATE */
+}
+
+static void esp32_rtcio_init(Object *obj)
+{
+    Esp32RtcIoState *s = ESP32_RTCIO(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32_rtcio_ops, s, TYPE_ESP32_RTCIO, 0x400);
+    sysbus_init_mmio(sbd, &s->iomem);
+    esp32_rtcio_device = s;
+}
+
+static void esp32_rtcio_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->reset = esp32_rtcio_reset;
+}
+
+static const TypeInfo esp32_rtcio_info = {
+    .name = TYPE_ESP32_RTCIO,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32RtcIoState),
+    .instance_init = esp32_rtcio_init,
+    .class_init = esp32_rtcio_class_init,
+};
+
+static void esp32_rtcio_register_types(void)
+{
+    type_register_static(&esp32_rtcio_info);
+}
+
+type_init(esp32_rtcio_register_types)
