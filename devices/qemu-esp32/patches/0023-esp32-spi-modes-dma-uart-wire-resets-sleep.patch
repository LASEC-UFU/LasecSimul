+/* Light-sleep GPIO wakeup (esp_sleep_enable_gpio_wakeup + gpio_wakeup_enable): a pin with
+ * GPIO_PINn_REG.WAKEUP_ENABLE (bit 10) whose pad is at its INT_TYPE level (low or high). */
+#define GPIO_PIN_WAKEUP_ENABLE (1u << 10)
+bool esp32_gpio_wakeup_pending( void )
+{
+    if( !vnext_gpio_instance ) return false;
+    for( int pin = 0; pin < 40; ++pin ){
+        const uint32_t conf = vnext_gpio_instance->gpio_pin[pin];
+        if( !(conf & GPIO_PIN_WAKEUP_ENABLE) ) continue;
+        const int type = GPIO_PIN_INT_TYPE( conf );
+        const bool level = gpio_pin_level( vnext_gpio_instance, pin );
+        if( (type == GPIO_INT_LOW_LEVEL && !level) || (type == GPIO_INT_HIGH_LEVEL && level) ) return true;
+    }
+    return false;
+}
