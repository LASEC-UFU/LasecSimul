+/* RTC_CNTL dig-power-down: deep sleep has the digital domain off, so the timer groups stop counting (their
+ * watchdogs included) until the wake's digital reset. */
+static void esp32_dig_power_down(void *opaque, int n, int level)
+{
+    Esp32SocState *s = ESP32_SOC(opaque);
+    if (!level) return;
+    for (int i = 0; i < ESP32_TIMG_COUNT; ++i) esp32_timg_dig_power_down(&s->timg[i]);
+}
+
+/* RTC_CNTL dig-clock-gate: light sleep stops the CPU and APB clocks, so CCOUNT (and the CCOMPARE timers),
+ * the timer groups and the FRC timers hold from the sleep to the wakeup; the RTC timer, in the RTC domain,
+ * keeps counting. CCOUNT is ccount_base + the time since time_base: moving time_base by the sleep leaves it
+ * out. The CPUs are stalled across both edges. */
+static void esp32_dig_clock_gate(void *opaque, int n, int level)
+{
+    Esp32SocState *s = ESP32_SOC(opaque);
+    const bool gated = level != 0;
+    if (gated == s->dig_clock_gated) return;
+    const uint64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    for (int i = 0; i < ESP32_CPU_COUNT; ++i) {
+        XtensaCPU *cpu = &s->cpu[i];
+        CPUXtensaState *env = &cpu->env;
+        if (gated) {
+            for (int c = 0; c < env->config->nccompare; ++c) timer_del(env->ccompare[c].timer);
+            continue;
+        }
+        env->time_base += now - s->dig_clock_gate_ns;
+        env->ccount_time = now;
+        env->sregs[CCOUNT] = env->ccount_base + (uint32_t)clock_ns_to_ticks(cpu->clock, now - env->time_base);
+        for (int c = 0; c < env->config->nccompare; ++c) {
+            const uint64_t dcc = (uint64_t)(env->sregs[CCOMPARE + c] - env->sregs[CCOUNT] - 1) + 1;
+            timer_mod(env->ccompare[c].timer, now + clock_ticks_to_ns(cpu->clock, dcc));
+        }
+    }
+    for (int i = 0; i < ESP32_TIMG_COUNT; ++i) esp32_timg_clock_gate(&s->timg[i], gated);
+    for (int i = 0; i < ESP32_FRC_COUNT; ++i) esp32_frc_timer_clock_gate(&s->frc_timer[i], gated);
+    s->dig_clock_gated = gated;
+    s->dig_clock_gate_ns = now;
+}
