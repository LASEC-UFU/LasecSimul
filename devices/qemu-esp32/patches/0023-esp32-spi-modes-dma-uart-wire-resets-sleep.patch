+static void esp32_rtc_update_irq(Esp32RtcCntlState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & *esp32_rtc_reg(s, A_RTC_CNTL_INT_ENA)) != 0);
+}
+
+/* LASECSIMUL_RTC_TRACE=1: sleep entries and wakeups (stderr). */
+static bool esp32_rtc_trace(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *v = getenv("LASECSIMUL_RTC_TRACE");
+        enabled = v && *v && v[0] != '0';
+    }
+    return enabled;
+}
+
+static void esp32_rtc_wake(Esp32RtcCntlState *s, uint32_t cause)
+{
+    if (esp32_rtc_trace())
+        fprintf(stderr, "[RTC] wake cause=0x%x sleeping=%d deep=%d now=%" PRId64 "\n", cause, s->sleeping,
+                s->sleep_deep, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    if (!s->sleeping) return;
+    s->sleeping = false;
+    timer_del(&s->sleep_timer);
+    uint32_t *wakeup = esp32_rtc_reg(s, A_RTC_CNTL_WAKEUP_STATE);
+    *wakeup = FIELD_DP32(*wakeup, RTC_CNTL_WAKEUP_STATE, WAKEUP_CAUSE, cause);
+    uint32_t *state0 = esp32_rtc_reg(s, A_RTC_CNTL_STATE0);
+    *state0 = FIELD_DP32(*state0, RTC_CNTL_STATE0, SLEEP_EN, 0);
