+/* APB_CLK changed (esp32_clk_update): a UART on APB (TICK_REF_ALWAYS_ON) runs at the new rate from the next
+ * frame, as on the chip -- ESP-IDF and Arduino set the divider again themselves when they mean to keep the
+ * baud rate. The Core's adapter computes the same bit time from the divider (0xF10) and the APB it is told. */
+void esp32_uart_apb_changed(void)
+{
+    for (unsigned i = 0; i < 3; ++i) {
+        ESP32UARTState *s = vnext_uart_instances[i];
+        if (!s || !s->use_apb) continue;
+        s->baud_rate = uart_baud(s->clkdiv, true);
+        s->bit_ns = 1e9 / s->baud_rate;
+    }
+}
