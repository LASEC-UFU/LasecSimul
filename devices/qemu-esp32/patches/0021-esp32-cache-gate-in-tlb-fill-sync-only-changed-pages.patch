+/* The cache gate (hw/misc/esp32_dport.c, esp32_cache_set_gate()): a core's cache window stays mapped,
+ * and while that core's gate for it is closed its TLB fills for the window go to the region's trap at
+ * gated_base -- only where the window shows through the system map (the IROM0 window starts past the
+ * ROM, IRAM and RTC memory that share its 4 MB). */
+static hwaddr esp32_cache_gate_paddr(CPUState *cs, hwaddr paddr)
+{
+    Esp32SocState *s = esp32_soc;
+    if (!s || cs->cpu_index < 0 || cs->cpu_index >= ESP32_CPU_COUNT) {
+        return paddr;
+    }
+    Esp32CacheState *cache = &s->dport.cache_state[cs->cpu_index];
+    Esp32CacheRegionState *regions[] = { &cache->drom0, &cache->iram0, s->dport.has_psram ? &cache->dram1 : NULL };
+    for (size_t i = 0; i < ARRAY_SIZE(regions); i++) {
+        Esp32CacheRegionState *crs = regions[i];
+        if (!crs || crs->gate_open || paddr < crs->base || paddr >= crs->base + ESP32_CACHE_REGION_SIZE) {
+            continue;
+        }
+        MemoryRegionSection section = memory_region_find(&s->cpu_specific_mem[cs->cpu_index], paddr, 1);
+        const bool window = section.mr == &crs->mem;
+        if (section.mr) {
+            memory_region_unref(section.mr);
+        }
+        return window ? crs->gated_base + (paddr - crs->base) : paddr;
+    }
+    return paddr;
+}
