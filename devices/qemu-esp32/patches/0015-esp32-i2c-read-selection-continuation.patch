-    if (!(address & 1u) || !vnext_b_active()) return false;
-    s->vnextBurstNs = s->period_ns + (uint64_t)(1u + rxBytes) * (9 * s->period_ns) + s->period_ns;
+    if (!vnext_b_active()) return false;
+    uint32_t idx = s->lastCMD, rxBytes = 0, readCmds = 0;
+    bool lastReadNack = false;
+    while (idx < ESP32_I2C_CMD_COUNT &&
+           FIELD_EX32(s->cmd_reg[idx], I2C_CMD, OPCODE) == I2C_OPCODE_READ) {
+        rxBytes += s->cmd_reg[idx] & 0xffu;
+        lastReadNack = FIELD_EX32(s->cmd_reg[idx], I2C_CMD, ACK_VAL);
+        ++readCmds;
+        ++idx;
+    }
+    if (!readCmds || !rxBytes || rxBytes > ESP32_I2C_FIFO_LENGTH || idx >= ESP32_I2C_CMD_COUNT) return false;
+    if (fifo8_num_free(&s->rx_fifo) < rxBytes) return false;
+    const uint32_t terminalOpcode = FIELD_EX32(s->cmd_reg[idx], I2C_CMD, OPCODE);
+    if (terminalOpcode != I2C_OPCODE_STOP && terminalOpcode != I2C_OPCODE_END) return false;
+    const bool wireStop = terminalOpcode == I2C_OPCODE_STOP;
+
+    const bool start = fifo8_num_used(&s->tx_fifo) > 0;
+    uint8_t address;
+    if (start) address = fifo8_peek(&s->tx_fifo);
+    else if (s->burstAddressValid && (s->burstAddressByte & 1u)) address = s->burstAddressByte;
+    else return false;
+    if (!(address & 1u)) return false;
+
+    s->vnextBurstNs = (start ? s->period_ns + 9 * s->period_ns : 0) +
+                      (uint64_t)rxBytes * (9 * s->period_ns) + (wireStop ? s->period_ns : 0);
     s->vnextBurstSubmitNs = getQemu_ns();
-    const uint32_t wireFlags =
