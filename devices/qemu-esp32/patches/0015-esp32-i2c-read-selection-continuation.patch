-    if ((bool)(txbuf[0] & 1u) != (plan.rxBytes > 0)) return false;
+    if (!readSelection && (bool)(txbuf[0] & 1u) != (plan.rxBytes > 0)) return false;
 
     /* The ESP32 command engine reports END_DETECT rather than STOP, but the
