+    const bool readSelection = vnext_b_active() && (txbuf[0] & 1u) && plan.txBytes == 1 &&
+                               plan.rxBytes == 0 && terminalOpcode == I2C_OPCODE_END;
     /* A direção codificada no byte de endereço precisa concordar com a lista de comandos.
