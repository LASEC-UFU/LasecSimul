+    const bool logicalStop = !readSelection && (plan.stop || terminalOpcode == I2C_OPCODE_END);
 
     I2cBurstRequest req = {0};
     req.flags = 1u /* START */ | (plan.rxBytes ? 4u /* READ */ : 0u) | (logicalStop ? 2u : 0u);
@@ -192,7 +201,7 @@ static bool esp32_i2c_try_burst(Esp32I2CState *s)
         s->vnextBurstNs = s->period_ns + (uint64_t)(plan.txBytes + plan.rxBytes) * (9 * s->period_ns) +
