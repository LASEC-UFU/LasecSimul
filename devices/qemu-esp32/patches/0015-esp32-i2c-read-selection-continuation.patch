-    if (fifo8_num_used(&s->tx_fifo)) fifo8_pop(&s->tx_fifo);
+    /* A lista compacta mantém o fim lógico que sempre teve; a continuação só o anuncia no STOP. */
+    const uint32_t flags = (start ? 1u | 2u : (wireStop ? 2u : 0u)) | 4u |
+                           (wireStop ? VNEXT_I2C_WIRE_STOP : 0u) |
+                           (lastReadNack ? VNEXT_I2C_LAST_READ_NACK : 0u);
+    if (!vnext_b_i2c_submit(s->busIndex, flags, s->period_ns, &address, 1, rxBytes)) return false;
+    if (start) fifo8_pop(&s->tx_fifo);
     s->burstActive = true;
     s->burstPartial = false;
-    s->burstStop = true;
+    s->burstStop = wireStop;
     s->burstAddressByte = address;
