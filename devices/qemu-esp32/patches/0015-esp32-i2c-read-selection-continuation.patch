- * causal BATCH semantics. */
+/* A corrida de READ de uma lista (ESP-IDF: READ n-1 com ACK + READ 1 com NACK) fechada por STOP ou
+ * END, como UM pedido BATCH. Duas formas:
+ *  - lista compacta do HAL: o endereço está no TX FIFO e cmd[0] é READ -- START + endereço aqui;
+ *  - continuação de uma leitura cujo endereço já foi selecionado (esp32_i2c_try_burst, ou a lista
+ *    anterior desta mesma leitura terminada em END): sem START, o endereço só identifica o alvo.
+ * Sem nenhuma das duas, a lista segue no executor elétrico byte a byte. */
 static bool esp32_i2c_try_read_burst(Esp32I2CState *s)
 {
-    if (s->lastCMD >= ESP32_I2C_CMD_COUNT ||
