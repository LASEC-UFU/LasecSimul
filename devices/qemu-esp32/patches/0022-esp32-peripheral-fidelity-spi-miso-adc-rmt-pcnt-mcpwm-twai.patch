+/* The `k`-th byte of a USR transaction as mirrored to the Core: [7:0] what MOSI shifts out, bit 8 =
+ * sample MISO during it, [31:16] where the received byte goes in the buffer. Full duplex
+ * (SPI_USER.DOUTDIN) runs the MOSI and MISO phases together; half duplex sends the MOSI bytes and then
+ * reads the MISO ones (ESP32 TRM, SPI, half-duplex). The MOSI phase reads W0 on, or W8 on with
+ * USR_MOSI_HIGHPART. Outside its own bytes MOSI keeps the level of the last bit it shifted out. */
+static uint32_t esp32_spi_wire_value( Esp32SpiState* s, int k )
+{
+    int tx = -1, rx = -1;
+    if( s->fullDuplex ) {
+        if( k < s->txBytes ) tx = k;
+        if( k < s->rxBytes ) rx = k;
+    } else if( k < s->txBytes ) {
+        tx = k;
+    } else {
+        rx = k - s->txBytes;
+    }
+    uint32_t value = s->mosiHold;
+    if( tx >= 0 ) {
+        const uint8_t byte = esp32_spi_tx_byte( s, tx + (FIELD_EX32(s->user_reg, SPI_USER, MOSI_HIGHPART) ? 32 : 0) );
+        s->mosiHold = (byte & 1u) ? 0xFFu : 0x00u;
+        value = byte;
+    }
+    if( rx >= 0 ) value |= 0x100u | ((uint32_t)rx << 16);
+    return value;
+}
