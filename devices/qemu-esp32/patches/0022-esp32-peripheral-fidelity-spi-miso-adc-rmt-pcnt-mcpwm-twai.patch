diff --git a/hw/misc/esp32_twai.c b/hw/misc/esp32_twai.c
new file mode 100644
index 0000000..4c9d04b
--- /dev/null
+++ b/hw/misc/esp32_twai.c
@@ -0,0 +1,299 @@
+/*
+ * ESP32 TWAI (CAN 2.0B) controller
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "hw/misc/esp32_twai.h"
+#include "../softmmu/simuliface.h"
+#include "../softmmu/vnext_b.h"
+
+/* The bus side (bit timing, stuffing, CRC, ACK, arbitration, error frames, TEC/REC, bus off and its
+ * recovery, the acceptance filter) lives in the Core, which drives TWAI_TX and samples TWAI_RX at their
+ * instants (Esp32Adapter TWAI engine). Every register write is mirrored to it. What the CPU reads locally
+ * is what the controller keeps on the APB side: the RX FIFO (64 bytes, a message counter and an overrun
+ * flag per message, as in the OpenCores SJA1000 core the ESP-IDF errata describe), the interrupt register
+ * and the ALC/ECC captures. Without vNext-B there is no bus: the controller waits for bus-free forever. */
+
+static Esp32TwaiState *esp32_twai_device;
+
+static bool esp32_twai_in_reset(const Esp32TwaiState *s)
+{
+    return (s->mode & 1) != 0;
+}
+
+static void esp32_twai_update_irq(Esp32TwaiState *s)
+{
+    const bool ri = (s->ier & 1) && s->info_cnt > 0;
+    qemu_set_irq(s->irq, ri || s->ir != 0);
+}
+
+static void esp32_twai_fifo_clear(Esp32TwaiState *s)
+{
+    s->fifo_rd = s->fifo_cnt = 0;
+    s->info_rd = s->info_cnt = 0;
+    s->dos = false;
+}
+
+/* DOS follows the message at the head of the FIFO: set (with DOI) when it is one that overran, cleared by
+ * CDO. ESP-IDF reads the valid messages ahead of it and then releases the rest. */
+static void esp32_twai_dos_update(Esp32TwaiState *s)
+{
+    if (s->info_cnt && s->info_overrun[s->info_rd] && !s->dos) {
+        s->dos = true;
+        if (s->ier & 0x08) s->ir |= 0x08;
+    }
+}
+
+static void esp32_twai_commit(Esp32TwaiState *s, uint32_t len)
+{
+    /* RMC at 64: the FIFO the errata calls unrecoverable (TWAI_ERRATA_FIX_RX_FIFO_CORRUPT); ESP-IDF resets
+     * the peripheral before it gets there. */
+    if (s->info_cnt >= ESP32_TWAI_FIFO_FRAMES || len > 13) return;
+    const uint32_t slot = (s->info_rd + s->info_cnt) % ESP32_TWAI_FIFO_FRAMES;
+    if (len <= ESP32_TWAI_FIFO_BYTES - s->fifo_cnt) {
+        for (uint32_t i = 0; i < len; i++)
+            s->fifo[(s->fifo_rd + s->fifo_cnt + i) % ESP32_TWAI_FIFO_BYTES] = s->rx_frame[i];
+        s->fifo_cnt += len;
+        s->info_len[slot] = len;
+        s->info_overrun[slot] = false;
+    } else {
+        s->info_len[slot] = 0; /* no room: counted, flagged, its bytes lost */
+        s->info_overrun[slot] = true;
+    }
+    s->info_cnt++;
+    esp32_twai_dos_update(s);
+}
+
+static void esp32_twai_release(Esp32TwaiState *s)
+{
+    if (!s->info_cnt) return;
+    const uint32_t len = s->info_len[s->info_rd];
+    s->fifo_rd = (s->fifo_rd + len) % ESP32_TWAI_FIFO_BYTES;
+    s->fifo_cnt -= len;
+    s->info_rd = (s->info_rd + 1) % ESP32_TWAI_FIFO_FRAMES;
+    s->info_cnt--;
+    esp32_twai_dos_update(s);
+}
+
+void esp32_twai_vnext_event(uint64_t address, uint64_t value)
+{
+    Esp32TwaiState *s = esp32_twai_device;
+    if (!s) return;
+    const hwaddr offset = address - s->iomem.addr;
+    switch (offset) {
+    case A_TWAI_MODE: /* bus off: the controller entered reset mode by itself */
+        if (!esp32_twai_in_reset(s) && (value & 1)) esp32_twai_fifo_clear(s);
+        s->mode = value & 0x0f;
+        break;
+    case A_TWAI_INT_RAW:
+        s->ir |= value & 0xfe;
+        break;
+    case A_TWAI_ARB_LOST_CAP:
+        if (s->alc_armed) {
+            s->alc = value & 0x1f;
+            s->alc_armed = false;
+            if (s->ier & 0x40) s->ir |= 0x40;
+        }
+        break;
+    case A_TWAI_ERR_CODE_CAP:
+        if (s->ecc_armed) {
+            s->ecc = value & 0xff;
+            s->ecc_armed = false;
+            if (s->ier & 0x80) s->ir |= 0x80;
+        }
+        break;
+    case A_TWAI_DATA_0:
+    case A_TWAI_DATA_0 + 4:
+    case A_TWAI_DATA_0 + 8:
+    case A_TWAI_DATA_0 + 12:
+        for (int i = 0; i < 4; i++) s->rx_frame[(offset - A_TWAI_DATA_0) + i] = (uint8_t)(value >> (8 * i));
+        break;
+    case A_TWAI_RX_MESSAGE_CNT:
+        esp32_twai_commit(s, (uint32_t)value);
+        break;
+    }
+    esp32_twai_update_irq(s);
+}
+
+static uint32_t esp32_twai_engine(void)
+{
+    return vnext_b_twai_state();
+}
+
+static uint64_t esp32_twai_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32TwaiState *s = ESP32_TWAI(opaque);
+    uint32_t value;
+    switch (addr) {
+    case A_TWAI_MODE:
+        vnext_b_lockstep_input_barrier(); /* bus off sets RM from the Core */
+        return s->mode;
+    case A_TWAI_STATUS:
+        vnext_b_lockstep_input_barrier();
+        value = esp32_twai_engine() & 0xfc;
+        if (s->info_cnt) value |= 0x01;
+        if (s->dos) value |= 0x02;
+        return value;
+    case A_TWAI_INT_RAW:
+        vnext_b_lockstep_input_barrier();
+        value = s->ir | (((s->ier & 1) && s->info_cnt) ? 1 : 0);
+        s->ir = 0; /* reading clears everything but RI */
+        esp32_twai_update_irq(s);
+        return value;
+    case A_TWAI_INT_ENA:
+        return s->ier;
+    case A_TWAI_BUS_TIMING_0:
+        return s->btr0;
+    case A_TWAI_BUS_TIMING_1:
+        return s->btr1;
+    case A_TWAI_ARB_LOST_CAP:
+        vnext_b_lockstep_input_barrier();
+        s->alc_armed = true;
+        return s->alc;
+    case A_TWAI_ERR_CODE_CAP:
+        vnext_b_lockstep_input_barrier();
+        s->ecc_armed = true;
+        return s->ecc;
+    case A_TWAI_ERR_WARNING_LIMIT:
+        return s->ewl;
+    case A_TWAI_RX_ERR_CNT:
+        vnext_b_lockstep_input_barrier();
+        return (esp32_twai_engine() >> 16) & 0xff;
+    case A_TWAI_TX_ERR_CNT:
+        vnext_b_lockstep_input_barrier();
+        return (esp32_twai_engine() >> 8) & 0xff;
+    case A_TWAI_RX_MESSAGE_CNT:
+        vnext_b_lockstep_input_barrier();
+        return s->info_cnt;
+    case A_TWAI_CLOCK_DIVIDER:
+        return s->cdr;
+    case A_TWAI_DATA_0 ... A_TWAI_DATA_12: {
+        const unsigned index = (addr - A_TWAI_DATA_0) / 4;
+        if (esp32_twai_in_reset(s)) return index < 4 ? s->acr[index] : index < 8 ? s->amr[index - 4] : 0;
+        vnext_b_lockstep_input_barrier();
+        return s->fifo[(s->fifo_rd + index) % ESP32_TWAI_FIFO_BYTES]; /* the RX buffer window */
+    }
+    }
+    return 0;
+}
+
+static void esp32_twai_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    Esp32TwaiState *s = ESP32_TWAI(opaque);
+    const bool reset = esp32_twai_in_reset(s);
+    value &= 0xff;
+    /* First: writeReg() may replay the guest store (vNext-B backpressure) before anything changed here. */
+    if (addr < 0x80) writeReg(s->iomem.addr + addr, value);
+    switch (addr) {
+    case A_TWAI_MODE: {
+        const uint32_t next = reset ? (value & 0x0f) : ((s->mode & 0x0e) | (value & 1));
+        if (!reset && (next & 1)) esp32_twai_fifo_clear(s); /* entering reset mode empties the RX FIFO */
+        s->mode = next;
+        break;
+    }
+    case A_TWAI_CMD:
+        if (reset) break;
+        if (value & 0x04) esp32_twai_release(s); /* RRB */
+        if (value & 0x08) { /* CDO */
+            s->dos = false;
+            esp32_twai_dos_update(s);
+        }
+        break;
+    case A_TWAI_INT_ENA:
+        s->ier = value;
+        break;
+    case A_TWAI_BUS_TIMING_0:
+        if (reset) s->btr0 = value;
+        break;
+    case A_TWAI_BUS_TIMING_1:
+        if (reset) s->btr1 = value;
+        break;
+    case A_TWAI_ERR_WARNING_LIMIT:
+        if (reset) s->ewl = value;
+        break;
+    case A_TWAI_CLOCK_DIVIDER:
+        s->cdr = value;
+        break;
+    case A_TWAI_DATA_0 ... A_TWAI_DATA_0 + 0x1c: {
+        const unsigned index = (addr - A_TWAI_DATA_0) / 4;
+        if (!reset) break; /* in operation the TX buffer is the Core's */
+        if (index < 4) s->acr[index] = value;
+        else s->amr[index - 4] = value;
+        break;
+    }
+    }
+    esp32_twai_update_irq(s);
+}
+
+static const MemoryRegionOps esp32_twai_ops = {
+    .read = esp32_twai_read,
+    .write = esp32_twai_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+/* SJA1000 / OpenCores reset state: reset mode, EWL 96, everything else 0, the FIFO empty. */
+static void esp32_twai_reset(DeviceState *dev)
+{
+    Esp32TwaiState *s = ESP32_TWAI(dev);
+    s->mode = 0x01;
+    s->ier = 0;
+    s->btr0 = s->btr1 = 0;
+    s->ewl = 96;
+    s->cdr = 0;
+    memset(s->acr, 0, sizeof(s->acr));
+    memset(s->amr, 0, sizeof(s->amr));
+    s->ir = 0;
+    s->alc = s->ecc = 0;
+    s->alc_armed = s->ecc_armed = true;
+    esp32_twai_fifo_clear(s);
+    qemu_irq_lower(s->irq);
+}
+
+void esp32_twai_peripheral_reset(void)
+{
+    Esp32TwaiState *s = esp32_twai_device;
+    if (!s) return;
+    writeReg(s->iomem.addr + 0x2fc, 1); /* the Core's controller too (first: may replay the store) */
+    esp32_twai_reset(DEVICE(s));
+}
+
+static void esp32_twai_init(Object *obj)
+{
+    Esp32TwaiState *s = ESP32_TWAI(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32_twai_ops, s, TYPE_ESP32_TWAI, 0x1000);
+    /* writeReg() may replay the guest store (vNext-B backpressure), see hw/i2c/esp32_i2c.c. */
+    s->iomem.disable_reentrancy_guard = true;
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    esp32_twai_device = s;
+}
+
+static void esp32_twai_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->reset = esp32_twai_reset;
+}
+
+static const TypeInfo esp32_twai_info = {
+    .name = TYPE_ESP32_TWAI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32TwaiState),
+    .instance_init = esp32_twai_init,
+    .class_init = esp32_twai_class_init,
+};
+
+static void esp32_twai_register_types(void)
+{
+    type_register_static(&esp32_twai_info);
+}
+
+type_init(esp32_twai_register_types)
