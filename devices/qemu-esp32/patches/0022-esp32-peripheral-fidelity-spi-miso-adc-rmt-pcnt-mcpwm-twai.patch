+#define SENS_SAR_START_FORCE    0x2c  /* SAR1_BIT_WIDTH [1:0], SAR2_BIT_WIDTH [3:2] */
+#define SENS_SAR_ATTEN1         0x34  /* 2 bits per ADC1 channel */
+#define SENS_SAR_ATTEN2         0x38  /* 2 bits per ADC2 channel */
