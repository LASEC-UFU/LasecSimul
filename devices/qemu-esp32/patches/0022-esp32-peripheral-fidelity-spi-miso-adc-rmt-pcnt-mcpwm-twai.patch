diff --git a/hw/misc/esp32_mcpwm.c b/hw/misc/esp32_mcpwm.c
new file mode 100644
index 0000000..a4c7777
--- /dev/null
+++ b/hw/misc/esp32_mcpwm.c
@@ -0,0 +1,181 @@
+/*
+ * ESP32 motor-control PWM (MCPWM)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/esp32_mcpwm.h"
+#include "../softmmu/simuliface.h"
+#include "../softmmu/vnext_b.h"
+
+/* Timers, operators, dead time, faults and capture run in the Core, which owns the pins (Esp32Adapter
+ * MCPWM engine). Here: the register file with its reset values (ESP-IDF mcpwm_reg.h), every write
+ * mirrored to the Core, the timer status from the vNext-B snapshot (read after a sync, as GPIO_IN), and
+ * the Core's events latched into INT_RAW, CAPn_VALUE, CAP_STATUS, FH_STATUS and FAULT_DETECT. */
+
+#define MCPWM_CAP_TIMER_CFG 0x0e8
+#define MCPWM_CAP_CH0_CFG   0x0f0
+#define MCPWM_CAP_CH0       0x0fc
+#define MCPWM_CAP_STATUS    0x108
+#define MCPWM_FAULT_DETECT  0x0e4
+#define MCPWM_OP0_FH_STATUS 0x070  /* operator n at 0x03c + 0x38 n, FH_STATUS at +0x34 */
+
+static Esp32McpwmState *esp32_mcpwm_units[2];
+
+static void esp32_mcpwm_update_irq(Esp32McpwmState *s)
+{
+    qemu_set_irq(s->irq, (s->regs[A_MCPWM_INT_RAW / 4] & s->regs[A_MCPWM_INT_ENA / 4]) != 0);
+}
+
+void esp32_mcpwm_vnext_event(uint64_t address, uint64_t value)
+{
+    for (int n = 0; n < 2; n++) {
+        Esp32McpwmState *s = esp32_mcpwm_units[n];
+        if (!s || address < s->iomem.addr || address >= s->iomem.addr + ESP32_MCPWM_REG_BYTES) continue;
+        const hwaddr offset = address - s->iomem.addr;
+        if (offset == A_MCPWM_INT_RAW) {
+            s->regs[offset / 4] |= (uint32_t)value;
+            esp32_mcpwm_update_irq(s);
+        } else if (offset == MCPWM_FAULT_DETECT) {
+            /* event_f0..2 [8:6] are status, the rest is configuration */
+            s->regs[offset / 4] = (s->regs[offset / 4] & ~0x1C0u) | ((uint32_t)value & 0x1C0u);
+        } else {
+            s->regs[offset / 4] = (uint32_t)value; /* CAPn_VALUE, CAP_STATUS, FH_STATUS */
+        }
+        return;
+    }
+}
+
+static uint64_t esp32_mcpwm_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32McpwmState *s = ESP32_MCPWM(opaque);
+    if (addr >= ESP32_MCPWM_REG_BYTES) return 0;
+    switch (addr) {
+    case A_MCPWM_TIMER0_STATUS:
+    case A_MCPWM_TIMER0_STATUS + 0x10:
+    case A_MCPWM_TIMER0_STATUS + 0x20: {
+        /* The count moves every tick, not only at Core events: sync at this very instant (once) so the
+         * Core latches the status of now, then replay the load. */
+        const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        if (vnext_b_active() && now != s->status_sync_ns) {
+            s->status_sync_ns = now;
+            vnext_b_lockstep_sync_barrier();
+        }
+        return vnext_b_mcpwm_timer_status(3 * s->unit + (addr - A_MCPWM_TIMER0_STATUS) / 0x10);
+    }
+    case A_MCPWM_INT_ST:
+        vnext_b_lockstep_input_barrier();
+        return s->regs[A_MCPWM_INT_RAW / 4] & s->regs[A_MCPWM_INT_ENA / 4];
+    case A_MCPWM_INT_RAW:
+    case MCPWM_CAP_CH0: case MCPWM_CAP_CH0 + 4: case MCPWM_CAP_CH0 + 8:
+    case MCPWM_CAP_STATUS:
+    case MCPWM_FAULT_DETECT:
+    case MCPWM_OP0_FH_STATUS: case MCPWM_OP0_FH_STATUS + 0x38: case MCPWM_OP0_FH_STATUS + 0x70:
+        vnext_b_lockstep_input_barrier();
+        return s->regs[addr / 4];
+    }
+    return s->regs[addr / 4];
+}
+
+static void esp32_mcpwm_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    Esp32McpwmState *s = ESP32_MCPWM(opaque);
+    if (addr >= ESP32_MCPWM_REG_BYTES) return;
+    switch (addr) {
+    case A_MCPWM_INT_CLR:
+        s->regs[A_MCPWM_INT_RAW / 4] &= ~(uint32_t)value;
+        esp32_mcpwm_update_irq(s);
+        return;
+    case A_MCPWM_INT_RAW:
+    case A_MCPWM_INT_ST:
+    case A_MCPWM_TIMER0_STATUS: case A_MCPWM_TIMER0_STATUS + 0x10: case A_MCPWM_TIMER0_STATUS + 0x20:
+    case MCPWM_CAP_CH0: case MCPWM_CAP_CH0 + 4: case MCPWM_CAP_CH0 + 8:
+    case MCPWM_CAP_STATUS:
+        return; /* read-only */
+    case A_MCPWM_INT_ENA:
+        s->regs[addr / 4] = value;
+        esp32_mcpwm_update_irq(s);
+        break;
+    default:
+        s->regs[addr / 4] = value;
+        break;
+    }
+    writeReg(s->iomem.addr + addr, value);
+    /* Self-clearing triggers: CAP_SYNC_SW (bit 5 of CAP_TIMER_CFG) and CAPn_SW (bit 12 of CAPn_CFG). */
+    if (addr == MCPWM_CAP_TIMER_CFG) s->regs[addr / 4] &= ~(1u << 5);
+    if (addr >= MCPWM_CAP_CH0_CFG && addr < MCPWM_CAP_CH0_CFG + 12) s->regs[addr / 4] &= ~(1u << 12);
+}
+
+static const MemoryRegionOps esp32_mcpwm_ops = {
+    .read = esp32_mcpwm_read,
+    .write = esp32_mcpwm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+/* Reset values from ESP-IDF mcpwm_reg.h: period 255, dead time bypassed, shadow updates enabled. */
+static void esp32_mcpwm_reset(DeviceState *dev)
+{
+    static const struct { uint16_t offset; uint32_t value; } resets[] = {
+        {0x004, 0x0000ff00}, {0x014, 0x0000ff00}, {0x024, 0x0000ff00},
+        {0x04c, 0x00000020}, {0x058, 0x00018000}, {0x084, 0x00000020}, {0x090, 0x00018000},
+        {0x0bc, 0x00000020}, {0x0c8, 0x00018000}, {0x10c, 0x00000055}, {0x124, 0x02107230},
+    };
+    Esp32McpwmState *s = ESP32_MCPWM(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    for (size_t i = 0; i < ARRAY_SIZE(resets); i++) s->regs[resets[i].offset / 4] = resets[i].value;
+    qemu_irq_lower(s->irq);
+}
+
+static void esp32_mcpwm_realize(DeviceState *dev, Error **errp)
+{
+    Esp32McpwmState *s = ESP32_MCPWM(dev);
+    if (s->unit < ARRAY_SIZE(esp32_mcpwm_units)) esp32_mcpwm_units[s->unit] = s;
+}
+
+static void esp32_mcpwm_init(Object *obj)
+{
+    Esp32McpwmState *s = ESP32_MCPWM(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32_mcpwm_ops, s, TYPE_ESP32_MCPWM, 0x1000);
+    /* writeReg() may replay the guest store (vNext-B backpressure), see hw/i2c/esp32_i2c.c. */
+    s->iomem.disable_reentrancy_guard = true;
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static Property esp32_mcpwm_properties[] = {
+    DEFINE_PROP_UINT32("unit", Esp32McpwmState, unit, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32_mcpwm_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->reset = esp32_mcpwm_reset;
+    dc->realize = esp32_mcpwm_realize;
+    device_class_set_props(dc, esp32_mcpwm_properties);
+}
+
+static const TypeInfo esp32_mcpwm_info = {
+    .name = TYPE_ESP32_MCPWM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32McpwmState),
+    .instance_init = esp32_mcpwm_init,
+    .class_init = esp32_mcpwm_class_init,
+};
+
+static void esp32_mcpwm_register_types(void)
+{
+    type_register_static(&esp32_mcpwm_info);
+}
+
+type_init(esp32_mcpwm_register_types)
diff --git a/hw/misc/esp32_pcnt.c b/hw/misc/esp32_pcnt.c
new file mode 100644
index 0000000..d992e5d
--- /dev/null
+++ b/hw/misc/esp32_pcnt.c
@@ -0,0 +1,164 @@
+/*
+ * ESP32 pulse counter (PCNT)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/irq.h"
+#include "hw/misc/esp32_pcnt.h"
+#include "../softmmu/simuliface.h"
+#include "../softmmu/vnext_b.h"
+
+/* Counters, events and the glitch filter live in the Core, which sees every pad edge at its instant
+ * (Esp32Adapter PCNT engine). This model keeps the registers the firmware reads back, mirrors every
+ * configuration write to the Core, reads the counters from the vNext-B snapshot after syncing (as a
+ * GPIO_IN read) and latches the events the Core reports into STATUS_Un / INT_RAW. Without vNext-B there
+ * is no Core to count: the counters read 0, as a unit whose inputs never toggle. */
+
+static Esp32PcntState *esp32_pcnt_device;
+
+static void esp32_pcnt_update_irq(Esp32PcntState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
+}
+
+void esp32_pcnt_vnext_event(uint64_t address, uint64_t value)
+{
+    Esp32PcntState *s = esp32_pcnt_device;
+    if (!s) return;
+    const hwaddr offset = address - s->iomem.addr;
+    if (offset < A_PCNT_U0_STATUS || offset >= A_PCNT_U0_STATUS + 4 * ESP32_PCNT_UNITS) return;
+    const int unit = (offset - A_PCNT_U0_STATUS) / 4;
+    s->status[unit] = (uint32_t)value;
+    s->int_raw |= 1u << unit;
+    esp32_pcnt_update_irq(s);
+}
+
+static uint64_t esp32_pcnt_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32PcntState *s = ESP32_PCNT(opaque);
+    if (addr < A_PCNT_U0_CNT) {
+        const int unit = addr / 12;
+        switch (addr % 12) {
+        case 0: return s->conf0[unit];
+        case 4: return s->conf1[unit];
+        default: return s->conf2[unit];
+        }
+    }
+    switch (addr) {
+    case A_PCNT_U0_CNT ... A_PCNT_U0_CNT + 4 * ESP32_PCNT_UNITS - 4:
+        /* The count at this very instant: the barrier syncs the Core first. */
+        vnext_b_lockstep_input_barrier();
+        return vnext_b_pcnt_count((addr - A_PCNT_U0_CNT) / 4);
+    case A_PCNT_INT_RAW:
+        vnext_b_lockstep_input_barrier();
+        return s->int_raw;
+    case A_PCNT_INT_ST:
+        vnext_b_lockstep_input_barrier();
+        return s->int_raw & s->int_ena;
+    case A_PCNT_INT_ENA:
+        return s->int_ena;
+    case A_PCNT_U0_STATUS ... A_PCNT_U0_STATUS + 4 * ESP32_PCNT_UNITS - 4:
+        vnext_b_lockstep_input_barrier();
+        return s->status[(addr - A_PCNT_U0_STATUS) / 4];
+    case A_PCNT_CTRL:
+        return s->ctrl;
+    case A_PCNT_DATE:
+        return 0x14122600;
+    }
+    return 0;
+}
+
+static void esp32_pcnt_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    Esp32PcntState *s = ESP32_PCNT(opaque);
+    if (addr < A_PCNT_U0_CNT) {
+        const int unit = addr / 12;
+        switch (addr % 12) {
+        case 0: s->conf0[unit] = value; break;
+        case 4: s->conf1[unit] = value; break;
+        default: s->conf2[unit] = value; break;
+        }
+        writeReg(s->iomem.addr + addr, value);
+        return;
+    }
+    switch (addr) {
+    case A_PCNT_INT_ENA:
+        s->int_ena = value & 0xFFu;
+        writeReg(s->iomem.addr + addr, s->int_ena); /* the Core syncs every event while one is armed */
+        esp32_pcnt_update_irq(s);
+        break;
+    case A_PCNT_INT_CLR:
+        /* STATUS_Un keeps the events latched with the last interrupt (TRM, "_LAT"): ESP-IDF's service
+         * clears the interrupt before its handler reads them. */
+        s->int_raw &= ~value;
+        esp32_pcnt_update_irq(s);
+        break;
+    case A_PCNT_CTRL:
+        s->ctrl = value;
+        writeReg(s->iomem.addr + addr, value);
+        break;
+    }
+}
+
+static const MemoryRegionOps esp32_pcnt_ops = {
+    .read = esp32_pcnt_read,
+    .write = esp32_pcnt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+/* Reset values from ESP-IDF pcnt_reg.h: filter on (16 APB cycles), zero / high / low limit events on,
+ * every unit held in reset (PCNT_CTRL 0x5555). */
+static void esp32_pcnt_reset(DeviceState *dev)
+{
+    Esp32PcntState *s = ESP32_PCNT(dev);
+    for (int unit = 0; unit < ESP32_PCNT_UNITS; unit++) {
+        s->conf0[unit] = 0x00003c10;
+        s->conf1[unit] = 0;
+        s->conf2[unit] = 0;
+        s->status[unit] = 0;
+    }
+    s->ctrl = 0x5555;
+    s->int_raw = 0;
+    s->int_ena = 0;
+    qemu_irq_lower(s->irq);
+}
+
+static void esp32_pcnt_init(Object *obj)
+{
+    Esp32PcntState *s = ESP32_PCNT(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32_pcnt_ops, s, TYPE_ESP32_PCNT, 0x100);
+    /* writeReg() may replay the guest store (vNext-B backpressure), see hw/i2c/esp32_i2c.c. */
+    s->iomem.disable_reentrancy_guard = true;
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    esp32_pcnt_device = s;
+}
+
+static void esp32_pcnt_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->reset = esp32_pcnt_reset;
+}
+
+static const TypeInfo esp32_pcnt_info = {
+    .name = TYPE_ESP32_PCNT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32PcntState),
+    .instance_init = esp32_pcnt_init,
+    .class_init = esp32_pcnt_class_init,
+};
+
+static void esp32_pcnt_register_types(void)
+{
+    type_register_static(&esp32_pcnt_info);
+}
+
+type_init(esp32_pcnt_register_types)
diff --git a/hw/misc/esp32_rtc_cntl.c b/hw/misc/esp32_rtc_cntl.c
