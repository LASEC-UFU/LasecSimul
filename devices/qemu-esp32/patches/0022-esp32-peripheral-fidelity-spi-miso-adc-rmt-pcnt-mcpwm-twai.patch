+/* A CPU interrupt input is the OR of every source the matrix maps to it on that CPU (TRM, Interrupt
+ * Matrix): a shared interrupt (ESP_INTR_FLAG_SHARED) stays up while any of its sources is up. The
+ * line is driven only when that OR changes, so one source dropping while another holds an
+ * edge-triggered interrupt is no new edge. CPU interrupts that are not external inputs (timers,
+ * software, profiling, and 6 = "not mapped") have no line. */
+static void esp32_intmatrix_update_line(Esp32IntMatrixState *s, int cpu, int out_index)
+{
+    if (s->outputs[cpu] == NULL || out_index < 0 || out_index >= 32) {
+        return;
