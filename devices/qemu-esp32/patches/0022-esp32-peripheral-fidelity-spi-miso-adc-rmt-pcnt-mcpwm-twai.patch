+/* Reset values of the SENS registers (every field's default in ESP-IDF sens_reg.h): among them 12-bit
+ * width, 11 dB on every pad and the SAR's native (inverted) output. */
+static void esp32_sens_reset(DeviceState *dev)
+{
+    static const struct { uint16_t offset; uint32_t value; } resets[] = {
+        {0x000, 0x00070902}, {0x008, 0x000a000a}, {0x00c, 0x0020000a}, {0x010, 0x0707338f},
+        {0x018, 0x000000c8}, {0x01c, 0x00000064}, {0x020, 0x00000032}, {0x024, 0x00000028},
+        {0x028, 0x00000014}, {0x02c, 0x0000000f}, {0x030, 0x00100200}, {0x034, 0xffffffff},
+        {0x038, 0xffffffff}, {0x04c, 0x00066002}, {0x058, 0x02041000}, {0x084, 0x00400800},
+        {0x08c, 0x3fffffff}, {0x090, 0x00070902}, {0x09c, 0x03000000}, {0x0a0, 0x00000003},
+        {0x0fc, 0x01605180},
+    };
+    Esp32SensState *s = ESP32_SENS(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    for (size_t i = 0; i < ARRAY_SIZE(resets); i++) s->regs[resets[i].offset / 4] = resets[i].value;
+    s->channel1 = 0;
+    s->channel2 = 0;
+}
+
+static void esp32_sens_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
