+    {57431, 76236, 105481, 196602}, {57236, 76175, 105678, 197170} };
+static const uint32_t adc_vref_atten_offset[2][4] = { {75, 78, 107, 142}, {63, 66, 89, 128} };
+static const uint32_t adc_lut_low[2][ADC_LUT_POINTS] = {
+    {2240, 2297, 2352, 2405, 2457, 2512, 2564, 2616, 2664, 2709, 2754, 2795, 2832, 2868, 2903, 2937, 2969, 3000, 3030, 3060},
+    {2238, 2293, 2347, 2399, 2451, 2507, 2561, 2613, 2662, 2710, 2754, 2792, 2831, 2869, 2904, 2937, 2968, 2999, 3029, 3059} };
+static const uint32_t adc_lut_high[2][ADC_LUT_POINTS] = {
+    {2667, 2706, 2745, 2780, 2813, 2844, 2873, 2901, 2928, 2956, 2982, 3006, 3032, 3059, 3084, 3110, 3135, 3160, 3184, 3209},
+    {2657, 2698, 2738, 2774, 2807, 2838, 2867, 2894, 2921, 2946, 2971, 2996, 3020, 3043, 3067, 3092, 3116, 3139, 3162, 3185} };
+
+/* Characterized voltage (mV) at a real-valued 12-bit code `x` on ADC `unit` (0/1) at `atten`: IDF's
+ * cali_raw_to_voltage() without its integer rounding -- the line, and at 11 dB the blend into the
+ * lookup table over its first step and the table (bilinear in code and Vref) above it. */
+static double esp32_adc_curve_mv(int unit, int atten, double x)
+{
+    const double coeff_a = (double)((ADC_VREF_MV * adc_vref_atten_scale[unit][atten]) / 4096) / 65536.0;
+    const double linear = coeff_a * x + adc_vref_atten_offset[unit][atten];
+    if (atten != 3 || x < ADC_LUT_LOW_THRESH) return linear;
+    const double pos = (x - ADC_LUT_LOW_THRESH) / ADC_LUT_STEP;
+    const int i = MIN((int)pos, ADC_LUT_POINTS - 2);
+    const double f = pos - i;
+    const double t = (double)(ADC_VREF_MV - ADC_LUT_VREF_LOW) / (ADC_LUT_VREF_HIGH - ADC_LUT_VREF_LOW);
+    const double low = adc_lut_low[unit][i] + ((double)adc_lut_low[unit][i + 1] - adc_lut_low[unit][i]) * f;
+    const double high = adc_lut_high[unit][i] + ((double)adc_lut_high[unit][i + 1] - adc_lut_high[unit][i]) * f;
+    const double lut = low + (high - low) * t;
+    if (x > ADC_LUT_HIGH_THRESH) return lut;
+    return linear + (lut - linear) * (x - ADC_LUT_LOW_THRESH) / ADC_LUT_STEP;
+}
+
+/* Ideal 12-bit code (real-valued, 0..4096) a typical ESP32 has for `mv` on its pad: the curve's inverse,
+ * pinned at both ends -- below the offset the ADC reads 0, above full scale it saturates. */
+static double esp32_adc_ideal_code(int unit, int atten, double mv)
+{
+    double lo = 0.0, hi = 4096.0;
+    if (mv <= esp32_adc_curve_mv(unit, atten, lo)) return 0.0;
+    if (mv >= esp32_adc_curve_mv(unit, atten, hi)) return hi;
+    for (int k = 0; k < 48; k++) {
+        const double mid = 0.5 * (lo + hi);
+        if (esp32_adc_curve_mv(unit, atten, mid) < mv) lo = mid; else hi = mid;
+    }
+    return lo;
+}
+
+/* MEAS_START1/2 read through vNext-B: the conversion result of the channel selected by EN_PAD, at this
+ * very instant (the barrier syncs the Core first). A successive-approximation conversion of `width`
+ * bits (SARx_BIT_WIDTH, 9..12) keeps the code's top bits -- the floor of the ideal value at that width,
+ * up to the largest code -- and the SAR's native output is inverted unless SARx_DATA_INV is set, as
+ * ESP-IDF sets it. */
+static uint32_t esp32_sens_vnext_meas(Esp32SensState *s, int unit)
+{
+    vnext_b_lockstep_input_barrier();
+    const int channel = unit ? s->channel2 : s->channel1;
+    const uint32_t atten = (s->regs[(unit ? SENS_SAR_ATTEN2 : SENS_SAR_ATTEN1) / 4] >> (2 * channel)) & 3u;
+    const uint32_t width = 9 + ((s->regs[SENS_SAR_START_FORCE / 4] >> (unit ? 2 : 0)) & 3u);
+    const bool data_inv = unit ? (s->regs[SENS_SAR_READ_CTRL2 / 4] >> 29) & 1u
+                               : (s->regs[SENS_SAR_READ_CTRL / 4] >> 28) & 1u;
+    const double mv = vnext_b_adc_pad_tenths_mv((unit ? 8 : 0) + channel) / 10.0;
+    const uint32_t max = (1u << width) - 1u;
+    uint32_t raw = (uint32_t)(esp32_adc_ideal_code(unit, atten, mv) / (double)(1u << (12 - width)));
+    if (raw > max) raw = max;
+    if (!data_inv) raw = ~raw & max;
+    return raw;
+}
 
