+/* Transmitter (ESP32 TRM, Remote Control Peripheral). Each channel reads its items from its RAM blocks
+ * (MEM_SIZE blocks of 64 words from block n): a word is two halves {duration[14:0], level[15]}, the
+ * low half first, durations in channel ticks -- DIV_CNT (0 = 256) periods of APB_CLK (REF_ALWAYS_ON)
+ * or of the 1 MHz REF_TICK. A zero duration ends the transmission. The item is read when it starts:
+ * firmware refilling RAM behind the transmitter (wrap mode, MEM_TX_WRAP_EN, paced by the TX_THR event
+ * every TX_LIM items) races the real reader the same way. At the end comes TX_END and the idle level
+ * (IDLE_OUT_LV when IDLE_OUT_EN, else low); TX_CONTI_MODE starts over from the first item instead.
+ *
+ * The pin is driven by the Core (Esp32Adapter RMT engine): each item is mirrored when it starts, with
+ * both levels and the first half's duration in ps, and the carrier (CARRIER_EN, counted in base-clock
+ * cycles, applied to the CARRIER_OUT_LV level) when the transmission starts. */
+
+static uint64_t esp32_rmt_base_ps(Esp32RmtState *s, int n)
+{
+    if (FIELD_EX32(s->conf1[n], RMT_CHnCONF1, REF_ALWAYS_ON)) {
+        const uint64_t apb = esp32_soc_get_apb_freq();
+        return apb ? (UINT64_C(1000000000000) + apb / 2) / apb : 12500;
+    }
+    return 1000000; /* REF_TICK, 1 MHz */
+}
+
+static uint64_t esp32_rmt_tick_ps(Esp32RmtState *s, int n)
+{
+    const uint32_t div = FIELD_EX32(s->conf0[n], RMT_CHnCONF0, DIV_CNT);
+    return (div ? div : 256) * esp32_rmt_base_ps(s, n);
+}
+
+static uint32_t esp32_rmt_mem_words(Esp32RmtState *s, int n)
+{
+    return MAX(1u, FIELD_EX32(s->conf0[n], RMT_CHnCONF0, MEM_SIZE)) * ESP32_RMT_BLOCK_WORDS;
+}
+
+static void esp32_rmt_update_irq(Esp32RmtState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_en) != 0);
