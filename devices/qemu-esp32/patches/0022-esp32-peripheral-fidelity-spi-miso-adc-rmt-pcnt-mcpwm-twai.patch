+    uint32_t conf2[ESP32_PCNT_UNITS];
+    uint32_t status[ESP32_PCNT_UNITS];
+    uint32_t ctrl;
+    uint32_t int_raw;
+    uint32_t int_ena;
+} Esp32PcntState;
+
+REG32(PCNT_U0_CONF0, 0x00)
+REG32(PCNT_U0_CNT, 0x60)
+REG32(PCNT_INT_RAW, 0x80)
+REG32(PCNT_INT_ST, 0x84)
