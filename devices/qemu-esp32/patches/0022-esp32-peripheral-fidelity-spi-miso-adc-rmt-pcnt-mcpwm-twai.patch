new file mode 100644
index 0000000..bdd06bf
--- /dev/null
+++ b/include/hw/misc/esp32_twai.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/registerfields.h"
+
+#define TYPE_ESP32_TWAI "misc.esp32.twai"
+#define ESP32_TWAI(obj) OBJECT_CHECK(Esp32TwaiState, (obj), TYPE_ESP32_TWAI)
+
+#define ESP32_TWAI_FIFO_BYTES 64
+#define ESP32_TWAI_FIFO_FRAMES 64
+
+/* TWAI (ESP32 TRM, CAN 2.0B; SJA1000 PeliCAN register set). The CAN protocol runs in the Core, bit by bit
+ * on the TWAI_TX/TWAI_RX pads (Esp32Adapter TWAI engine). This model keeps the registers, the 64-byte RX
+ * FIFO with its per-message overrun flags and the interrupt register; SR/TEC/REC come from the vNext-B
+ * snapshot and the Core pushes received frames and interrupt events through C2A
+ * (esp32_twai_vnext_event). */
+typedef struct Esp32TwaiState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t mode;      /* MOD: RM 0, LOM 1, STM 2, AFM 3 */
+    uint32_t ier;       /* IER (bit 4 = BRP_DIV) */
+    uint32_t btr0, btr1, ewl, cdr;
+    uint8_t acr[4], amr[4];
+    uint32_t ir;        /* latched interrupts; RI follows the FIFO */
+    uint32_t alc, ecc;
+    bool alc_armed, ecc_armed; /* reading ALC/ECC re-arms the capture and ALI/BEI */
+    uint8_t fifo[ESP32_TWAI_FIFO_BYTES];
+    uint32_t fifo_rd, fifo_cnt;
+    uint8_t info_len[ESP32_TWAI_FIFO_FRAMES];
+    bool info_overrun[ESP32_TWAI_FIFO_FRAMES];
+    uint32_t info_rd, info_cnt; /* info_cnt = RMC */
+    bool dos;
+    uint8_t rx_frame[16];       /* the frame the Core is delivering, word by word */
+} Esp32TwaiState;
+
+REG32(TWAI_MODE, 0x00)
+REG32(TWAI_CMD, 0x04)
+REG32(TWAI_STATUS, 0x08)
+REG32(TWAI_INT_RAW, 0x0c)
+REG32(TWAI_INT_ENA, 0x10)
+REG32(TWAI_BUS_TIMING_0, 0x18)
+REG32(TWAI_BUS_TIMING_1, 0x1c)
+REG32(TWAI_ARB_LOST_CAP, 0x2c)
+REG32(TWAI_ERR_CODE_CAP, 0x30)
+REG32(TWAI_ERR_WARNING_LIMIT, 0x34)
+REG32(TWAI_RX_ERR_CNT, 0x38)
+REG32(TWAI_TX_ERR_CNT, 0x3c)
+REG32(TWAI_DATA_0, 0x40)
+REG32(TWAI_DATA_12, 0x70)
+REG32(TWAI_RX_MESSAGE_CNT, 0x74)
+REG32(TWAI_RX_BUF_START, 0x78)
+REG32(TWAI_CLOCK_DIVIDER, 0x7c)
+
+/* vNext-B: an event the Core's controller produced (IR bits, ALC, ECC, MOD on bus off, a received frame). */
+void esp32_twai_vnext_event(uint64_t address, uint64_t value);
+/* DPORT_PERIP_RST_EN.TWAI_RST: the peripheral reset ESP-IDF uses at install and in its errata workarounds. */
+void esp32_twai_peripheral_reset(void);
