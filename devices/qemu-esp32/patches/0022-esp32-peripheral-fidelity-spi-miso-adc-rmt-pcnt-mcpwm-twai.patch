 static bool esp32_analog_trace_enabled(void)
 {
@@ -24,6 +34,83 @@ static bool esp32_analog_trace_enabled(void)
     return value && value[0] && strcmp(value, "0") != 0;
 }
 
+/* The SAR ADC transfer function is the inverse of ESP-IDF's line-fitting characterization of a chip
+ * with the default 1100 mV reference (components/esp_adc/esp32/adc_cali_line_fitting.c, the curve
+ * analogReadMilliVolts() uses for a chip without eFuse calibration, like this one): per unit and
+ * attenuation a line raw -> mV, and at 11 dB a lookup table from raw 2880 on, where the real ADC
+ * bends and saturates near 3.1 V. A typical chip reads, for each pad voltage, the raw code whose
+ * characterized voltage is nearest. */
+#define ADC_VREF_MV          1100
+#define ADC_LUT_VREF_LOW     1000
+#define ADC_LUT_VREF_HIGH    1200
+#define ADC_LUT_STEP         64
+#define ADC_LUT_POINTS       20
+#define ADC_LUT_LOW_THRESH   2880
+#define ADC_LUT_HIGH_THRESH  (ADC_LUT_LOW_THRESH + ADC_LUT_STEP)
+
