@@ -0,0 +1,39 @@
+#pragma once
+
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/registerfields.h"
+
+#define TYPE_ESP32_PCNT "misc.esp32.pcnt"
+#define ESP32_PCNT(obj) OBJECT_CHECK(Esp32PcntState, (obj), TYPE_ESP32_PCNT)
+
+#define ESP32_PCNT_UNITS 8
+
+/* Pulse counter (ESP32 TRM, PCNT). The Core counts the edges (Esp32Adapter PCNT engine, which sees every
+ * pad edge at its instant); this model keeps the registers, reads the counters from the vNext-B
+ * snapshot and raises the interrupt when the Core reports an event (esp32_pcnt_vnext_event). */
+typedef struct Esp32PcntState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t conf0[ESP32_PCNT_UNITS];
