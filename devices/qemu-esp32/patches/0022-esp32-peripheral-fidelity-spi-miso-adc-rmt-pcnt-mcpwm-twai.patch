diff --git a/include/hw/misc/esp32_mcpwm.h b/include/hw/misc/esp32_mcpwm.h
new file mode 100644
index 0000000..95a4b54
--- /dev/null
+++ b/include/hw/misc/esp32_mcpwm.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/registerfields.h"
+
+#define TYPE_ESP32_MCPWM "misc.esp32.mcpwm"
+#define ESP32_MCPWM(obj) OBJECT_CHECK(Esp32McpwmState, (obj), TYPE_ESP32_MCPWM)
+
+#define ESP32_MCPWM_REG_BYTES 0x128
+
+/* Motor-control PWM (ESP32 TRM, MCPWM), one instance per unit. The Core generates the waveforms and
+ * captures the inputs (Esp32Adapter MCPWM engine); this model keeps the register file, mirrors every
+ * write to the Core, and takes from the Core the timer status (vNext-B snapshot) and the events that
+ * set INT_RAW, the capture values and the fault status (esp32_mcpwm_vnext_event). */
+typedef struct Esp32McpwmState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t unit;
+    uint32_t regs[ESP32_MCPWM_REG_BYTES / 4];
+    int64_t status_sync_ns; /* last instant a TIMERn_STATUS read synced the Core */
+} Esp32McpwmState;
+
+REG32(MCPWM_TIMER0_STATUS, 0x010)
+REG32(MCPWM_INT_ENA, 0x110)
+REG32(MCPWM_INT_RAW, 0x114)
+REG32(MCPWM_INT_ST, 0x118)
+REG32(MCPWM_INT_CLR, 0x11c)
+
+/* vNext-B: an MCPWM register the Core updated (INT_RAW bits to set, a capture value, a status). */
+void esp32_mcpwm_vnext_event(uint64_t address, uint64_t value);
