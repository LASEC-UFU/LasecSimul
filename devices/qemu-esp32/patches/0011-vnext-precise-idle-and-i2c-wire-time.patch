diff --git a/util/main-loop.c b/util/main-loop.c
index fcf9329..36723ce 100644
--- a/util/main-loop.c
+++ b/util/main-loop.c
@@ -470,6 +470,39 @@ bool (*main_loop_idle_wake_hook)(void);
 /* Tempo máximo, em ns, que a próxima volta de os_host_main_loop_wait() pode esperar SEM o BQL pelo
  * próximo timer (ver main_loop_timeout()). Zero = uma única consulta, comportamento anterior. */
 static int64_t precise_idle_wait_ns;
+/* vNext-B: everything that can end the idle wait is a Windows handle (Core reply wait object,
+ * GLib/AIO sources, a timer armed by a vCPU through qemu_notify_event), so the wait may block on
+ * them plus a high-resolution timer instead of spinning; only the last PRECISE_IDLE_SPIN_NS are
+ * spun. The legacy transport also needs main_loop_idle_wake_hook (an arena IRQ has no handle), so
+ * it keeps the pure spin. */
+bool main_loop_precise_idle_can_block;
+#define PRECISE_IDLE_SPIN_NS 300000
+#ifdef _WIN32
+static HANDLE precise_idle_timer;
+
+/* Blocks until a poll handle is signalled or `remaining_ns - PRECISE_IDLE_SPIN_NS` passes. */
+static void precise_idle_block(GPollFD *fds, int nfds, int64_t remaining_ns)
+{
+    if (remaining_ns <= PRECISE_IDLE_SPIN_NS) return;
+    if (!precise_idle_timer) {
+        precise_idle_timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                                    TIMER_ALL_ACCESS);
+        if (!precise_idle_timer) return;
+    }
+    HANDLE handles[MAXIMUM_WAIT_OBJECTS];
+    DWORD count = 0;
+    for (int i = 0; i < nfds; ++i) {
+        if (fds[i].fd == G_WIN32_MSG_HANDLE) continue;
+        if (count == MAXIMUM_WAIT_OBJECTS - 1) return; /* too many sources: keep spinning */
+        handles[count++] = (HANDLE)(intptr_t)fds[i].fd;
+    }
+    LARGE_INTEGER due;
+    due.QuadPart = -(LONGLONG)((remaining_ns - PRECISE_IDLE_SPIN_NS) / 100); /* relative, 100 ns */
+    if (!SetWaitableTimer(precise_idle_timer, &due, 0, NULL, NULL, FALSE)) return;
+    handles[count++] = precise_idle_timer;
+    WaitForMultipleObjects(count, handles, FALSE, 2 /* ms safety cap */);
+}
+#endif
 
 static int os_host_main_loop_wait(int64_t timeout)
 {
@@ -549,6 +582,9 @@ static int os_host_main_loop_wait(int64_t timeout)
         const int64_t idle_until = precise_idle_wait_ns > 0 ? get_clock() + precise_idle_wait_ns : 0;
         while (g_poll_ret == 0 && idle_until && get_clock() < idle_until &&
                !(main_loop_idle_wake_hook && main_loop_idle_wake_hook())) {
+            if (main_loop_precise_idle_can_block) {
+                precise_idle_block(poll_fds, n_poll_fds + w->num, idle_until - get_clock());
+            }
             g_poll_ret = qemu_poll_ns(poll_fds, n_poll_fds + w->num, 0);
             if (g_poll_ret == 0) SwitchToThread();
         }
