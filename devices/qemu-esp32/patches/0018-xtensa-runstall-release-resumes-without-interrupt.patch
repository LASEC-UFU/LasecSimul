diff --git a/target/xtensa/helper.c b/target/xtensa/helper.c
index 84fc93f..a7bb9e1 100644
--- a/target/xtensa/helper.c
+++ b/target/xtensa/helper.c
@@ -332,15 +332,28 @@ void xtensa_cpu_do_transaction_failed(CPUState *cs, hwaddr physaddr, vaddr addr,
                                   addr);
 }
 
+/* RUNSTALL is a level on the core's input: while it is high the core executes nothing, and once it
+ * drops the core goes on as it was -- running, or still in WAITI until an interrupt. Halting through
+ * CPU_INTERRUPT_HALT left that request pending when the core did not run during the stall (the
+ * single-threaded RR loop never runs a halted core; on the ESP32 the flash-cache wait also holds it),
+ * and it halted the core again right after the release, until an interrupt above PS.INTLEVEL: about
+ * a tick late, or forever with interrupts masked. And the release ended a WAITI with no interrupt. */
 void xtensa_runstall(CPUXtensaState *env, bool runstall)
 {
     CPUState *cpu = env_cpu(env);
 
+    if (runstall == env->runstall) {
+        return;
+    }
     env->runstall = runstall;
-    cpu->halted = runstall;
     if (runstall) {
+        env->runstall_waiti = cpu->halted;
+        cpu->halted = 1;
         cpu_interrupt(cpu, CPU_INTERRUPT_HALT);
     } else {
+        cpu_reset_interrupt(cpu, CPU_INTERRUPT_HALT);
+        cpu->halted = env->runstall_waiti;
+        env->runstall_waiti = false;
         qemu_cpu_kick(cpu);
     }
 }
