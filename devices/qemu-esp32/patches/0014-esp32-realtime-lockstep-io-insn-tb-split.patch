+static uint64_t vnext_rt_window_schedule_ns, vnext_rt_window_core_ns;
+static uint64_t vnext_rt_windows;
+/* Instructions per host second of straight guest code (peak with slow decay). Execution time beyond
+ * instructions / this -- translating new code, a device model doing host I/O -- does not shrink
+ * when instructions cost more virtual time, so it never counts toward the stretch. */
+static double vnext_rt_peak_ips = 20e6;
+static int64_t vnext_rt_window_icount;
+static int64_t vnext_rt_trace_slices; /* LASECSIMUL_LOCKSTEP_TRACE only */
