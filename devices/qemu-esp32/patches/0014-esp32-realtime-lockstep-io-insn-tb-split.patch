+static void vnext_rt_open_window(int64_t host_now, uint64_t schedule, uint64_t core) {
+    vnext_rt_window_host_ns = host_now;
+    vnext_rt_window_schedule_ns = schedule;
+    vnext_rt_window_core_ns = core;
+    vnext_rt_window_icount = icount_get_raw();
