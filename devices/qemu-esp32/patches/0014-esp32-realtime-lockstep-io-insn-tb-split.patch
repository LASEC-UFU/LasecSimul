+/*
+ * LasecSimul: an I/O access is only allowed as the last instruction of a TB (can_do_io starts false
+ * in every TB, with or without icount). One in the middle makes cpu_io_recompile() leave the TB (a
+ * longjmp -- stack unwinding on Windows) and run that instruction alone -- every time it executes,
+ * so a busy-wait polling a peripheral register (UART FIFO, SPI done bit, I2C status) ran at a few
+ * million instructions per second. The PCs of instructions that did it are remembered here: the
+ * translator then ends a TB right before them and gives each its own one-instruction TB with I/O
+ * allowed (translator_loop()), and later iterations stay on cached, chained TBs. With MTTCG several
+ * vCPU threads use it: every slot access is atomic, and two inserts racing for one slot only lose an
+ * entry, noted again on its next recompile. A stale or colliding entry only splits a TB needlessly;
+ * a full table falls back to the stock path.
+ */
+#define TB_IO_PC_SLOTS 8192u /* power of two */
+#define TB_IO_PC_PROBES 16u
+static vaddr tb_io_pcs[TB_IO_PC_SLOTS]; /* pc + 1; 0 = free */
+
+static unsigned tb_io_pc_slot(vaddr pc)
+{
+    return (unsigned)(((uint64_t)pc * UINT64_C(0x9E3779B97F4A7C15)) >> 51) & (TB_IO_PC_SLOTS - 1);
+}
