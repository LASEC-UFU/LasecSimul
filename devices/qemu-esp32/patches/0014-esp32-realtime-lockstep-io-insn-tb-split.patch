+    if (vnext_lockstep_trace > 0) qatomic_inc(&vnext_rt_trace_slices);
+}
+
+static void vnext_rt_apply(double dilation) {
+    if (dilation < 1.0) dilation = 1.0;
+    if (dilation > VNEXT_RT_MAX_DILATION) dilation = VNEXT_RT_MAX_DILATION;
+    if (dilation == vnext_rt_dilation) return;
+    vnext_rt_dilation = dilation;
+    icount_set_time_dilation(dilation);
