+bool tb_io_insn_pc(vaddr pc)
+{
+    unsigned slot = tb_io_pc_slot(pc);
+    for (unsigned i = 0; i < TB_IO_PC_PROBES; ++i, slot = (slot + 1) & (TB_IO_PC_SLOTS - 1)) {
+        const vaddr entry = qatomic_read(&tb_io_pcs[slot]);
+        if (entry == pc + 1) {
+            return true;
+        }
+        if (!entry) {
+            return false;
+        }
+    }
+    return false;
+}
+
+/* Remembers `pc`; false when the table has no room for it. */
+static bool tb_io_insn_pc_note(vaddr pc)
+{
+    unsigned slot = tb_io_pc_slot(pc);
+    for (unsigned i = 0; i < TB_IO_PC_PROBES; ++i, slot = (slot + 1) & (TB_IO_PC_SLOTS - 1)) {
+        const vaddr entry = qatomic_read(&tb_io_pcs[slot]);
+        if (entry == pc + 1) {
+            return true;
+        }
+        if (!entry) {
+            qatomic_set(&tb_io_pcs[slot], pc + 1);
+            return true;
+        }
+    }
+    return false;
+}
