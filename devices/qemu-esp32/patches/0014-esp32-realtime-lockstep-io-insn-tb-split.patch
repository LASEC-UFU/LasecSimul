+                    exec > 0 ? instructions * 1000.0 / exec : 0.0, vnext_rt_peak_ips / 1e6, slices,
+                    tbs - last_tbs,
+                    vnext_cpus[0] ? (uint64_t)CPU_GET_CLASS(vnext_cpus[0])->get_pc(vnext_cpus[0]) : 0,
+                    vnext_cpus[1] ? (uint64_t)CPU_GET_CLASS(vnext_cpus[1])->get_pc(vnext_cpus[1]) : 0,
+                    lag / 1000.0, dv / ds, core / 1000000);
+        last_tbs = tbs;
