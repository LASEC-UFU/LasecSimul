+
+/* One controller step (see vnext_rt), at a release, vCPUs held. `schedule` and `core` were published
+ * together by the Core: where the simulation should be by the real-time clock, and where it is. */
+static void vnext_rt_step(int64_t host_now, uint64_t schedule, uint64_t core) {
+    if (!vnext_rt) return;
+    if (!schedule) { /* no real-time pacing (unlimited speed): exact instruction timing */
+        vnext_rt_window_host_ns = 0;
+        vnext_rt_apply(1.0);
+        return;
+    }
+    const int64_t wall = host_now - vnext_rt_window_host_ns;
+    if (!vnext_rt_window_host_ns || wall > VNEXT_RT_STALE_NS || schedule < vnext_rt_window_schedule_ns ||
+        core < vnext_rt_window_core_ns) {
+        qatomic_xchg(&vnext_rt_window_exec_ns, 0);
+        vnext_rt_open_window(host_now, schedule, core);
+        return;
+    }
+    if (wall < VNEXT_RT_WINDOW_NS) return;
+    const double ds = (double)(schedule - vnext_rt_window_schedule_ns);
+    const double dv = (double)(core - vnext_rt_window_core_ns);
+    const double exec = (double)MIN(qatomic_xchg(&vnext_rt_window_exec_ns, 0), wall);
+    const double instructions = (double)(icount_get_raw() - vnext_rt_window_icount);
+    const double lag = schedule > core ? (double)(schedule - core) : 0.0;
