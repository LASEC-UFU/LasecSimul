+/* Real-time lockstep (lockstep_realtime). When the host cannot execute the guest fast enough to
+ * keep the Core's real-time schedule (core_realtime_schedule_ns) -- a heavy sketch, or a lab server
+ * shared by many simulations -- each instruction costs more virtual time instead of the whole
+ * simulation falling behind: the CPU behaves as if it had wait states, while timers, peripherals and
+ * every Core sync stay on the same timeline. Once per window of host time, always at a release (the
+ * vCPUs are held, so no instruction budget is in flight with the old rate), the stretch is set from
+ * the progress the window made: it grows only when executing guest code took a large share of the
+ * window (measured around each tcg_cpus_exec(); a vCPU stopped for an I2C reply or for lane credit
+ * is not executing -- and a slow circuit is not fixed by a slower CPU), and it returns to one
+ * instruction per CPU cycle as soon as there is slack. */
+#define VNEXT_RT_WINDOW_NS (10 * 1000 * 1000)   /* host time per controller step */
+#define VNEXT_RT_STALE_NS (500 * 1000 * 1000)   /* a longer window (pause, reload) says nothing */
+#define VNEXT_RT_LATE_NS (2 * 1000 * 1000)      /* behind the schedule by more than this = late */
+#define VNEXT_RT_CATCHUP_NS (200 * 1000 * 1000) /* host time over which lag is recovered */
+#define VNEXT_RT_MAX_STEP 4.0
+#define VNEXT_RT_MAX_DILATION 64.0
