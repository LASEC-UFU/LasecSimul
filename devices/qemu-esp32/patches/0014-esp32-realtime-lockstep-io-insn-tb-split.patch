+        if (vnext_rt_dilation > before * 1.1 || vnext_rt_dilation < before / 1.1 || vnext_rt_windows % 100 == 0)
+            fprintf(stderr, "[RT] d=%.1f x=%.2f i=%.2f mips=%.1f/%.0f sl=%" PRId64 " tb=%" PRIu64
+                    " pc=%08" PRIx64 ",%08" PRIx64 " lag=%.0f p=%.2f g=%" PRIu64 "\n",
