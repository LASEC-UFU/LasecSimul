+        if (cpu->cpu_index >= 0 && cpu->cpu_index < ICOUNT_CPU_CLOCKS) {
+            icount_cpu_busy_ns[cpu->cpu_index] += ns;
+            icount_cpu_insns[cpu->cpu_index] += executed;
+        }
     }
     icount_update_global_locked();
 }
 
+int icount_take_cpu_activity(double *busy_ns, int64_t *insns, int max)
+{
+    const int count = max < ICOUNT_CPU_CLOCKS ? max : ICOUNT_CPU_CLOCKS;
+
+    seqlock_write_lock(&timers_state.vm_clock_seqlock, &timers_state.vm_clock_lock);
+    for (int i = 0; i < ICOUNT_CPU_CLOCKS; i++) {
+        if (i < count && busy_ns) {
+            busy_ns[i] = icount_cpu_busy_ns[i];
+        }
+        if (i < count && insns) {
+            insns[i] = icount_cpu_insns[i];
+        }
+        icount_cpu_busy_ns[i] = 0.0;
+        icount_cpu_insns[i] = 0;
+    }
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock, &timers_state.vm_clock_lock);
+    return count;
+}
