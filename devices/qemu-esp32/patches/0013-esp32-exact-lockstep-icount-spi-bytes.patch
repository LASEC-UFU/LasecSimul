+/* Byte `index` of the MOSI data held in W0..W15, as the controller shifts it out (ESP32 TRM, SPI):
+ * the buffer is byte-addressed, low byte of each word first (SPI_USER.WR_BYTE_ORDER = 0) or high
+ * byte first (= 1), each byte MSB first (SPI_CTRL.WR_BIT_ORDER = 0) or LSB first (= 1). The Core's
+ * SPI engine always shifts MSB first, so an LSB-first byte is mirrored here. Sending
+ * data_reg[index] -- a whole word per byte, past W15 from the 17th byte on -- put the low byte of
+ * the wrong word on the wire: a PCD8544 driven by hardware SPI showed garbage. */
+static uint8_t esp32_spi_tx_byte( Esp32SpiState* s, uint32_t index )
+{
+    const uint32_t word = s->data_reg[(index / 4) % ESP32_SPI_BUF_WORDS];
+    const unsigned lane = index % 4;
+    const bool big_endian = (s->user_reg >> 11) & 1u;
+    uint8_t byte = (uint8_t)(word >> (8 * (big_endian ? 3 - lane : lane)));
+    if( (s->ctrl_reg >> 26) & 1u ){
+        uint8_t mirrored = 0;
+        for( int bit = 0; bit < 8; ++bit ) if( byte & (1u << bit) ) mirrored |= 0x80u >> bit;
+        byte = mirrored;
+    }
