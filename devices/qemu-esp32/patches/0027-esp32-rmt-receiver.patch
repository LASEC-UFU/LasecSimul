     FIELD(RMT_CHnCONF1, TX_CONTI_MODE, 6, 1)
     FIELD(RMT_CHnCONF1, APB_MEM_RST, 4, 1)
     FIELD(RMT_CHnCONF1, MEM_RD_RST, 3, 1)
@@ -81,3 +90,8 @@ REG32(RMT_DATA, 0x800)
 #define ESP32_RMT_ITEM_SECOND   (1u << 2)  /* LEVEL1 starts FIRST_PS after LEVEL0 */
 #define ESP32_RMT_ITEM_IDLE     (1u << 3)  /* not an item: the idle level, no carrier */
 #define ESP32_RMT_ITEM_PS_SHIFT 8          /* [63:8] the first half's duration, in ps */
+#define ESP32_RMT_CORE_RX       0x480  /* + 8n: the receiver (esp32_rmt_rx_config) */
+
+/* vNext-B C2A (0x3FF56480): a word the Core's receiver recorded ([31:0], channel [34:32]) or, bit 36, the
