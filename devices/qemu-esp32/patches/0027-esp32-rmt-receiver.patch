     FIELD(RMT_CHnCONF1, REF_ALWAYS_ON, 17, 1)
+    FIELD(RMT_CHnCONF1, RX_FILTER_THRES, 8, 8)
+    FIELD(RMT_CHnCONF1, RX_FILTER_EN, 7, 1)
+    FIELD(RMT_CHnCONF1, MEM_OWNER, 5, 1)
