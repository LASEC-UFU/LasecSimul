diff --git a/hw/ssi/esp32_rmt.c b/hw/ssi/esp32_rmt.c
index 0c7da16..dfa20ef 100644
--- a/hw/ssi/esp32_rmt.c
+++ b/hw/ssi/esp32_rmt.c
@@ -153,6 +153,39 @@ static void esp32_rmt_tx_start(Esp32RmtState *s, int n)
     esp32_rmt_tx_item(s, n);
 }
 
+/* Receiver (ESP32 TRM, RMT RX). The Core measures the input (RMT_SIG_INn): from the first edge, each level in
+ * channel ticks, pulses shorter than RX_FILTER_THRES APB cycles ignored, and the end after IDLE_THRES ticks
+ * without an edge. This side writes the words it records into the channel's RAM at the receiver's pointer
+ * (STATUS.MEM_WADDR_EX, what ESP-IDF reads at RX_END) and raises RX_END; past MEM_SIZE blocks, or with the RAM
+ * owned by the CPU (MEM_OWNER 0), the word is lost and ERR is raised. The RX settings go to the Core from the
+ * guest store that changes them (first: it may replay it). */
+static Esp32RmtState *esp32_rmt_device;
+
+static uint64_t esp32_rmt_rx_word(Esp32RmtState *s, int n)
+{
+    return (FIELD_EX32(s->conf1[n], RMT_CHnCONF1, RX_EN) ? 1u : 0u) |
+           (FIELD_EX32(s->conf1[n], RMT_CHnCONF1, RX_FILTER_EN) ? 2u : 0u) |
+           ((uint64_t)FIELD_EX32(s->conf1[n], RMT_CHnCONF1, RX_FILTER_THRES) << 2) |
+           ((uint64_t)FIELD_EX32(s->conf0[n], RMT_CHnCONF0, IDLE_THRES) << 10) |
+           (esp32_rmt_tick_ps(s, n) << 26);
+}
+
+void esp32_rmt_vnext_rx(uint64_t value)
+{
+    Esp32RmtState *s = esp32_rmt_device;
+    if (!s) return;
+    const int n = (value >> 32) & 7;
+    if ((value >> 36) & 1) {
+        s->int_raw |= 1u << (3 * n + 1); /* RX_END */
+    } else if (!FIELD_EX32(s->conf1[n], RMT_CHnCONF1, MEM_OWNER) || s->rx_wr[n] >= esp32_rmt_mem_words(s, n)) {
+        s->int_raw |= 1u << (3 * n + 2); /* ERR */
+    } else {
+        s->data[(n * ESP32_RMT_BLOCK_WORDS + s->rx_wr[n]) % ESP32_RMT_BUF_WORDS] = (uint32_t)value;
+        s->rx_wr[n]++;
+    }
+    esp32_rmt_update_irq(s);
+}
+
 static uint64_t esp32_rmt_read(void *opaque, hwaddr addr, unsigned int size)
 {
     Esp32RmtState *s = ESP32_RMT(opaque);
@@ -167,7 +200,7 @@ static uint64_t esp32_rmt_read(void *opaque, hwaddr addr, unsigned int size)
         /* MEM_WADDR_EX [9:0], MEM_RADDR_EX [19:10], STATE [22:20] (1 = sending) */
         const int n = (addr - A_RMT_CH0STATUS) / 4;
         const uint32_t base = n * ESP32_RMT_BLOCK_WORDS;
-        r = ((base + s->apb_wr[n]) & 0x3FFu) | (((base + s->tx[n].rd) & 0x3FFu) << 10) |
+        r = ((base + (s->rx_used[n] ? s->rx_wr[n] : s->apb_wr[n])) & 0x3FFu) | (((base + s->tx[n].rd) & 0x3FFu) << 10) |
             ((s->tx[n].active ? 1u : 0u) << 20);
         break;
     }
@@ -206,10 +239,30 @@ static void esp32_rmt_write(void *opaque, hwaddr addr, uint64_t value, unsigned
     case A_RMT_CH0CONF0 ... A_RMT_CH0CONF0 + 8 * ESP32_RMT_CHANNELS - 4: {
         const int n = (addr - A_RMT_CH0CONF0) / 8;
         if ((addr & 0x4) == 0) {
+            const uint32_t old0 = s->conf0[n];
             s->conf0[n] = value;
+            if (s->rx_cfg[n] & 1u) {
+                /* DIV_CNT or IDLE_THRES of a running receiver: the Core first (a replay redoes this store) */
+                const uint64_t cfg = esp32_rmt_rx_word(s, n);
+                s->conf0[n] = old0;
+                if (cfg != s->rx_cfg[n]) writeReg(s->iomem.addr + ESP32_RMT_CORE_RX + 8 * n, cfg);
+                s->conf0[n] = value;
+                s->rx_cfg[n] = cfg;
+            }
             break;
         }
+        {
+            /* RX_EN, the filter: the Core first (a replay redoes this store) */
+            const uint32_t old1 = s->conf1[n];
+            s->conf1[n] = value;
+            const uint64_t cfg = esp32_rmt_rx_word(s, n);
+            s->conf1[n] = old1;
+            if (cfg != s->rx_cfg[n] && ((cfg | s->rx_cfg[n]) & 1u)) writeReg(s->iomem.addr + ESP32_RMT_CORE_RX + 8 * n, cfg);
+            s->rx_cfg[n] = cfg;
+            if (cfg & 1u) s->rx_used[n] = true;
+        }
         s->conf1[n] = value;
+        if (FIELD_EX32(value, RMT_CHnCONF1, MEM_WR_RST)) s->rx_wr[n] = 0;
         /* MEM_RD_RST moves the reader back to the first item, also mid-transmission: ESP-IDF stops a
          * channel by writing an end marker there and resetting the pointer. */
         if (FIELD_EX32(value, RMT_CHnCONF1, MEM_RD_RST)) s->tx[n].rd = 0;
@@ -258,6 +311,9 @@ static void esp32_rmt_reset(DeviceState *dev)
         s->carrier_duty[n] = 0x00400040;
         s->txlim[n] = 0x80;
         s->apb_wr[n] = 0;
+        s->rx_wr[n] = 0;
+        s->rx_used[n] = false;
+        s->rx_cfg[n] = 0;
     }
     s->int_raw = 0;
     s->int_en = 0;
@@ -267,6 +323,7 @@ static void esp32_rmt_reset(DeviceState *dev)
 
 static void esp32_rmt_realize(DeviceState *dev, Error **errp)
 {
+    esp32_rmt_device = ESP32_RMT(dev);
 }
 
