+    FIELD(I2S_SAMPLE_RATE_CONF, RX_BCK_DIV_NUM, 6, 6)
+    FIELD(I2S_SAMPLE_RATE_CONF, TX_BITS_MOD, 12, 6)
+    FIELD(I2S_SAMPLE_RATE_CONF, RX_BITS_MOD, 18, 6)
+REG32(I2S_PDM_CONF, 0xb4)
+REG32(I2S_PDM_FREQ_CONF, 0xb8)
+REG32(I2S_STATE, 0xbc)
+REG32(I2S_DATE, 0xfc)
+
+/* INT_RAW bits (ESP32 TRM, I2S interrupts) */
+#define ESP32_I2S_INT_RX_TAKE_DATA  BIT(0)
+#define ESP32_I2S_INT_TX_PUT_DATA   BIT(1)
+#define ESP32_I2S_INT_RX_WFULL      BIT(2)
+#define ESP32_I2S_INT_RX_REMPTY     BIT(3)
+#define ESP32_I2S_INT_TX_WFULL      BIT(4)
+#define ESP32_I2S_INT_TX_REMPTY     BIT(5)
+#define ESP32_I2S_INT_IN_DONE       BIT(8)
+#define ESP32_I2S_INT_IN_SUC_EOF    BIT(9)
+#define ESP32_I2S_INT_OUT_DONE      BIT(11)
+#define ESP32_I2S_INT_OUT_EOF       BIT(12)
+#define ESP32_I2S_INT_IN_DSCR_ERR   BIT(13)
+#define ESP32_I2S_INT_OUT_DSCR_ERR  BIT(14)
+#define ESP32_I2S_INT_IN_DSCR_EMPTY BIT(15)
+#define ESP32_I2S_INT_OUT_TOTAL_EOF BIT(16)
+
+/* A descriptor the TX DMA has read into the FIFO and the shifter has not finished: its last entry pops at
+ * index `last` (OUT_EOF in OUT_EOF_MODE 1). */
+typedef struct Esp32I2sInflight {
+    uint64_t last;
+    uint32_t desc, buf, next;
+    bool eof;
+} Esp32I2sInflight;
+
+/* One direction (TX or RX). The shifter moves one FIFO entry every `per_num / per_den` ns from `t0` (entry
+ * `base` at t0); the entry period follows CLKM_CONF and SAMPLE_RATE_CONF (esp32_i2s_entry_period). */
+typedef struct Esp32I2sChan {
+    QEMUTimer timer;
+    bool clocked;          /* TX_START / RX_START: the shifter runs */
+    bool link;             /* the DMA link runs (OUTLINK/INLINK START) */
+    uint64_t t0;
+    uint64_t base;
+    uint64_t per_num, per_den;
+    /* DMA: the descriptor being read (TX) or filled (RX) */
+    uint32_t desc, buf, len, next;
+    bool desc_eof, have_desc;
+    uint32_t off;           /* RX: bytes of it filled */
+    uint64_t desc_done;     /* TX: entries of it pushed into the FIFO */
+    uint64_t pushed;        /* TX: FIFO entries the DMA has pushed (index of the next one) */
+    uint64_t done;          /* RX: entries written to memory */
+    uint32_t eof_bytes;     /* RX: bytes since the last IN_SUC_EOF (RXEOF_NUM counts words) */
+    /* TX: descriptors in the FIFO */
+    Esp32I2sInflight inflight[ESP32_I2S_INFLIGHT];
+    unsigned inflight_rd, inflight_cnt;
+    bool chain_end;         /* the DMA reached the end of the list */
+    /* CPU FIFO mode (DSCR_EN 0) */
+    uint32_t fifo[ESP32_I2S_FIFO_DEPTH];
+    unsigned fifo_rd, fifo_cnt;
+    uint64_t fifo_popped;   /* TX: entries popped from the CPU FIFO */
+} Esp32I2sChan;
+
+/* Built-in DAC mode: a sample for the Core (DAC1 [7:0], DAC2 [15:8], channels [17:16]) at instant `t`, or
+ * (cut) the end of the stream at `t`. */
+typedef struct Esp32I2sDacSample {
+    uint64_t t;
+    uint32_t codes;
+    bool cut;
+} Esp32I2sDacSample;
+
+typedef struct Esp32I2sState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t unit;
+    uint32_t regs[ESP32_I2S_REGS];
+    Esp32I2sChan tx, rx;
+    Esp32I2sDacSample dac[ESP32_I2S_DAC_PENDING];
+    unsigned dac_rd, dac_cnt;
+    bool dac_blocked;       /* the last send found the lane full: retry in 2 us */
+    /* Built-in ADC mode (I2S0 RX in LCD mode with APB_SARADC DATA_TO_I2S): the Core samples the pattern's
+     * pads at the sample instants (adapter ADC module 0x3FF48BC0) and returns the voltages (0.1 mV). */
+    bool adc_on;            /* the Core is sampling (what adc_send last told it) */
+    bool adc_want;          /* what it should be doing */
+    bool adc_pending;       /* the configuration still has to reach the Core */
+    unsigned adc_sent;      /* writes of it already accepted */
+    uint64_t adc_base;      /* RX entry of sample 0 */
+    uint64_t adc_recv;      /* samples received */
+    uint16_t adc_ring[ESP32_I2S_ADC_RING];
+    bool adc_format2, adc_inv;
+    unsigned adc_unit, adc_len;
+    uint8_t adc_pattern[16];
+} Esp32I2sState;
+
+/* vNext-B C2A (0x3FF4F0F0): up to three voltages [15:0], [31:16], [47:32], their count [50:48]. */
+void esp32_i2s_vnext_adc(uint64_t value);
