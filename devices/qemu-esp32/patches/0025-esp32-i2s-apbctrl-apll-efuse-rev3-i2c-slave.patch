--- a/hw/gpio/esp32_gpio.c
+++ b/hw/gpio/esp32_gpio.c
@@ -122,6 +122,22 @@ void esp32_gpio_vnext_bind( Esp32GpioState *s )
     vnext_gpio_instance = s;
 }
 
+/* The level a peripheral input signal sees through the GPIO matrix (GPIO_FUNCy_IN_SEL_CFG: IN_SEL [5:0],
+ * 0x30 constant 1 and 0x38 constant 0, IN_INV_SEL bit 6, SIG_IN_SEL bit 7 -- through the matrix). */
+bool esp32_gpio_in_signal_level( unsigned signal )
+{
+    Esp32GpioState *s = vnext_gpio_instance;
+    if( !s || signal >= 256 ) return false;
+    const uint32_t cfg = s->gpio_in_sel[signal];
+    const unsigned sel = cfg & 0x3Fu;
+    bool level = false;
+    if( !(cfg & (1u << 7)) ) level = false;       /* the IO_MUX path: no pad has this function */
+    else if( sel == 0x30 ) level = true;
+    else if( sel == 0x38 || sel >= 40 ) level = false;
+    else level = gpio_pin_level( s, (int)sel );
+    return level != ((cfg >> 6) & 1u);
+}
+
 /* Light-sleep GPIO wakeup (esp_sleep_enable_gpio_wakeup + gpio_wakeup_enable): a pin with
  * GPIO_PINn_REG.WAKEUP_ENABLE (bit 10) whose pad is at its INT_TYPE level (low or high). */
 #define GPIO_PIN_WAKEUP_ENABLE (1u << 10)
