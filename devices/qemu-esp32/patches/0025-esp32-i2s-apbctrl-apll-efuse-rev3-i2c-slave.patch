diff --git a/hw/misc/esp32_apbctrl.c b/hw/misc/esp32_apbctrl.c
new file mode 100644
index 0000000..98797b2
--- /dev/null
+++ b/hw/misc/esp32_apbctrl.c
@@ -0,0 +1,100 @@
+/*
+ * ESP32 APB_CTRL (SYSCON)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32_apbctrl.h"
+
+static Esp32ApbCtrlState *esp32_apbctrl_device;
+
+void esp32_apbctrl_saradc(Esp32SaradcDig *out)
+{
+    memset(out, 0, sizeof(*out));
+    Esp32ApbCtrlState *s = esp32_apbctrl_device;
+    if (!s) return;
+    const uint32_t ctrl = s->regs[R_APBCTRL_SARADC_CTRL];
+    out->to_i2s = FIELD_EX32(ctrl, APBCTRL_SARADC_CTRL, DATA_TO_I2S);
+    out->unit = FIELD_EX32(ctrl, APBCTRL_SARADC_CTRL, SAR_SEL);
+    out->len = 1 + (out->unit ? FIELD_EX32(ctrl, APBCTRL_SARADC_CTRL, SAR2_PATT_LEN)
+                              : FIELD_EX32(ctrl, APBCTRL_SARADC_CTRL, SAR1_PATT_LEN));
+    out->format2 = FIELD_EX32(ctrl, APBCTRL_SARADC_CTRL, DATA_SAR_SEL);
+    out->inv = out->unit ? FIELD_EX32(s->regs[R_APBCTRL_SARADC_CTRL2], APBCTRL_SARADC_CTRL2, SAR2_INV)
+                         : FIELD_EX32(s->regs[R_APBCTRL_SARADC_CTRL2], APBCTRL_SARADC_CTRL2, SAR1_INV);
+    /* PATT_TAB1..4: the first entry in the top byte of TAB1 (ESP-IDF adc_ll_digi_set_pattern_table) */
+    const unsigned tab = out->unit ? R_APBCTRL_SARADC_SAR2_PATT_TAB1 : R_APBCTRL_SARADC_SAR1_PATT_TAB1;
+    for (unsigned i = 0; i < 16; ++i) out->pattern[i] = (s->regs[tab + i / 4] >> (24 - 8 * (i % 4))) & 0xFF;
+}
+
+static uint64_t esp32_apbctrl_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32ApbCtrlState *s = ESP32_APBCTRL(opaque);
+    return addr / 4 < ESP32_APBCTRL_REGS ? s->regs[addr / 4] : 0;
+}
+
+static void esp32_apbctrl_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    Esp32ApbCtrlState *s = ESP32_APBCTRL(opaque);
+    if (addr / 4 >= ESP32_APBCTRL_REGS || addr == A_APBCTRL_DATE) return;
+    s->regs[addr / 4] = value;
+}
+
+static const MemoryRegionOps esp32_apbctrl_ops = {
+    .read = esp32_apbctrl_read,
+    .write = esp32_apbctrl_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32_apbctrl_reset(DeviceState *dev)
+{
+    Esp32ApbCtrlState *s = ESP32_APBCTRL(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    /* ESP32 TRM reset values */
+    s->regs[R_APBCTRL_XTAL_TICK_CONF] = 39;
+    s->regs[R_APBCTRL_PLL_TICK_CONF] = 79;
+    s->regs[R_APBCTRL_CK8M_TICK_CONF] = 11;
+    s->regs[R_APBCTRL_SARADC_CTRL] = 0x007F8240;
+    s->regs[R_APBCTRL_SARADC_CTRL2] = 0x000001FE;
+    s->regs[R_APBCTRL_SARADC_FSM] = 0x0208FF08;
+    for (unsigned i = 0; i < 4; ++i) {
+        s->regs[R_APBCTRL_SARADC_SAR1_PATT_TAB1 + i] = 0x0F0F0F0F;
+        s->regs[R_APBCTRL_SARADC_SAR2_PATT_TAB1 + i] = 0x0F0F0F0F;
+    }
+    s->regs[R_APBCTRL_APLL_TICK_CONF] = 99;
+    s->regs[R_APBCTRL_DATE] = 0x16042000 | 0x80000000; /* the MSB marks ECO3 silicon (esp_efuse_get_chip_ver) */
+}
+
+static void esp32_apbctrl_init(Object *obj)
+{
+    Esp32ApbCtrlState *s = ESP32_APBCTRL(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32_apbctrl_ops, s, TYPE_ESP32_APBCTRL, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    esp32_apbctrl_device = s;
+}
+
+static void esp32_apbctrl_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->reset = esp32_apbctrl_reset;
+}
+
+static const TypeInfo esp32_apbctrl_info = {
+    .name = TYPE_ESP32_APBCTRL,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32ApbCtrlState),
+    .instance_init = esp32_apbctrl_init,
+    .class_init = esp32_apbctrl_class_init,
+};
+
+static void esp32_apbctrl_register_types(void)
+{
+    type_register_static(&esp32_apbctrl_info);
+}
+
+type_init(esp32_apbctrl_register_types)
diff --git a/hw/misc/esp32_i2s.c b/hw/misc/esp32_i2s.c
new file mode 100644
index 0000000..b66ef04
--- /dev/null
+++ b/hw/misc/esp32_i2s.c
@@ -0,0 +1,992 @@
+/*
+ * ESP32 I2S0/I2S1 (ESP32 TRM, I2S Controller)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/hw.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "exec/address-spaces.h"
+#include "hw/misc/esp32_i2s.h"
+#include "hw/gpio/esp32_gpio.h"
+#include "hw/misc/esp32_sens.h"
+#include "hw/misc/esp32_apbctrl.h"
+#include "hw/misc/esp32_ana.h"
+#include "../softmmu/vnext_b.h"
+#include "../softmmu/simuliface.h"
+
+/* Both I2S were unimplemented stubs: i2s_write()/i2s_read() waited forever for the DMA interrupts.
+ *
+ * The shifter moves one FIFO entry per entry period. I2S mode: a frame is 2 x TX_BITS_MOD BCK cycles, one
+ * entry per frame in FIFO modes 0, 1 and 3 (16-bit dual, 16-bit single, 32-bit single) and one per channel
+ * in mode 2 (32-bit dual). LCD mode (CONF2 LCD_EN; the built-in DAC and ADC): one entry per WS cycle, 2 BCK.
+ * BCK = I2Sn_CLK / M (BCK_DIV_NUM) and I2Sn_CLK = PLL_F160M / (N + b / a) (CLKM_CONF), so the period is an
+ * exact fraction of ns, kept as one (no drift over a long stream).
+ *
+ * TX DMA: the outlink descriptors (lldesc_t) go through the 64-entry FIFO. The DMA pushes as soon as the FIFO
+ * has room and the shifter pops: OUT_DONE when a descriptor has been read, OUT_EOF when its last entry has
+ * been sent (OUT_EOF_MODE 1, the reset value) or pushed (0), OUT_TOTAL_EOF at the end of the list.
+ * RX DMA: each entry is written to the inlink buffer as it is received; IN_DONE when a descriptor is full,
+ * IN_SUC_EOF every RXEOF_NUM words (ESP-IDF sets one descriptor), with the descriptor written back (length,
+ * eof, owner 0). DSCR_EN 0 is the CPU FIFO mode (FIFO_WR/FIFO_RD). */
+
+#define ESP32_I2S_DMA_BUS 0x3FF00000u
+#define ESP32_I2S_PLL_F160M 160000000ull
+
+static void esp32_i2s_update_irq(Esp32I2sState *s)
+{
+    s->regs[R_I2S_INT_ST] = s->regs[R_I2S_INT_RAW] & s->regs[R_I2S_INT_ENA];
+    qemu_set_irq(s->irq, s->regs[R_I2S_INT_ST] != 0);
+}
+
+static void esp32_i2s_raise(Esp32I2sState *s, uint32_t bits)
+{
+    s->regs[R_I2S_INT_RAW] |= bits;
+}
+
+static bool esp32_i2s_lcd(Esp32I2sState *s)
+{
+    return FIELD_EX32(s->regs[R_I2S_CONF2], I2S_CONF2, LCD_EN);
+}
+
+static unsigned esp32_i2s_fifo_mod(Esp32I2sState *s, bool tx)
+{
+    return tx ? FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, TX_FIFO_MOD)
+              : FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, RX_FIFO_MOD);
+}
+
+/* Memory bytes per FIFO entry: mode 1 splits each 32-bit word in two 16-bit entries. */
+static unsigned esp32_i2s_entry_bytes(Esp32I2sState *s, bool tx)
+{
+    return esp32_i2s_fifo_mod(s, tx) == 1 ? 2 : 4;
+}
+
+/* Master mode drives BCK/WS itself. A slave needs them from outside, and no device of the circuit is an I2S
+ * master (the pins are not modeled): it only runs off the other half of the same I2S through SIG_LOOPBACK
+ * (the ESP-IDF full-duplex setup: RX slave on TX's BCK/WS), while that half runs. */
+static bool esp32_i2s_slave(Esp32I2sState *s, bool tx)
+{
+    return tx ? FIELD_EX32(s->regs[R_I2S_CONF], I2S_CONF, TX_SLAVE_MOD) : FIELD_EX32(s->regs[R_I2S_CONF], I2S_CONF, RX_SLAVE_MOD);
+}
+
+static bool esp32_i2s_clock_on(Esp32I2sState *s, bool tx)
+{
+    const uint32_t conf = s->regs[R_I2S_CONF];
+    const bool start = tx ? FIELD_EX32(conf, I2S_CONF, TX_START) : FIELD_EX32(conf, I2S_CONF, RX_START);
+    if (!start) return false;
+    if (!esp32_i2s_slave(s, tx)) return true;
+    const bool other_start = tx ? FIELD_EX32(conf, I2S_CONF, RX_START) : FIELD_EX32(conf, I2S_CONF, TX_START);
+    return FIELD_EX32(conf, I2S_CONF, SIG_LOOPBACK) && !esp32_i2s_slave(s, !tx) && other_start;
+}
+
+static void esp32_i2s_entry_period(Esp32I2sState *s, bool tx, uint64_t *num, uint64_t *den)
+{
+    /* a slave on the other half's clock (SIG_LOOPBACK) takes that half's timing */
+    if (esp32_i2s_slave(s, tx) && FIELD_EX32(s->regs[R_I2S_CONF], I2S_CONF, SIG_LOOPBACK)) tx = !tx;
+    const uint32_t clkm = s->regs[R_I2S_CLKM_CONF];
+    const uint32_t rate = s->regs[R_I2S_SAMPLE_RATE_CONF];
+    uint64_t n = MAX(FIELD_EX32(clkm, I2S_CLKM_CONF, DIV_NUM), 2u);
+    uint64_t a = FIELD_EX32(clkm, I2S_CLKM_CONF, DIV_A);
+    uint64_t b = FIELD_EX32(clkm, I2S_CLKM_CONF, DIV_B);
+    if (a == 0) {
+        a = 1;
+        b = 0;
+    }
+    const uint64_t m = MAX(tx ? FIELD_EX32(rate, I2S_SAMPLE_RATE_CONF, TX_BCK_DIV_NUM)
+                              : FIELD_EX32(rate, I2S_SAMPLE_RATE_CONF, RX_BCK_DIV_NUM), 2u);
+    const uint64_t bits = MAX(tx ? FIELD_EX32(rate, I2S_SAMPLE_RATE_CONF, TX_BITS_MOD)
+                                 : FIELD_EX32(rate, I2S_SAMPLE_RATE_CONF, RX_BITS_MOD), 1u);
+    uint64_t bck;
+    if (esp32_i2s_lcd(s)) bck = 2;
+    else bck = esp32_i2s_fifo_mod(s, tx) == 2 ? bits : 2 * bits;
+    uint32_t sdm = 0, o_div = 0;
+    if (FIELD_EX32(clkm, I2S_CLKM_CONF, CLKA_ENA) && esp32_ana_apll(&sdm, &o_div) && sdm) {
+        /* APLL_CLK = 40 MHz * sdm / 65536 / (2 (o_div + 2)) (hw/misc/esp32_ana.c): 1e9 / 40e6 = 25 */
+        *num = bck * m * (n * a + b) * 25ull * 131072ull * (o_div + 2);
+        *den = a * sdm;
+        return;
+    }
+    *num = bck * m * (n * a + b) * 1000000000ull;
+    *den = a * ESP32_I2S_PLL_F160M;
+}
+
+/* Start time of entry `index` (rounded up, so that esp32_i2s_index() then counts every entry before it) /
+ * entries the shifter has finished by `now`. */
+static uint64_t esp32_i2s_time(Esp32I2sChan *c, uint64_t index)
+{
+    if (index <= c->base) return c->t0;
+    return c->t0 + (uint64_t)(((unsigned __int128)(index - c->base) * c->per_num + c->per_den - 1) / c->per_den);
+}
+
+static uint64_t esp32_i2s_index(Esp32I2sChan *c, uint64_t now)
+{
+    if (!c->clocked || now <= c->t0) return c->base;
+    return c->base + (uint64_t)(((unsigned __int128)(now - c->t0) * c->per_den) / c->per_num);
+}
+
+/* The shifter keeps its position and goes on from now at the current period (a new period, a start). */
+static void esp32_i2s_rebase(Esp32I2sState *s, Esp32I2sChan *c, bool tx, uint64_t now)
+{
+    c->base = esp32_i2s_index(c, now);
+    c->t0 = now;
+    esp32_i2s_entry_period(s, tx, &c->per_num, &c->per_den);
+}
+
+/* lldesc_t (ESP-IDF rom/lldesc.h): word 0 = size [11:0], length [23:12], eof 30, owner 31 (1 = the DMA);
+ * word 1 = buffer; word 2 = next descriptor. */
+static bool esp32_i2s_desc_read(uint32_t addr, uint32_t w[3])
+{
+    if (!addr || address_space_read(&address_space_memory, addr, MEMTXATTRS_UNSPECIFIED, w, 12) != MEMTX_OK) {
+        return false;
+    }
+    for (int i = 0; i < 3; ++i) w[i] = le32_to_cpu(w[i]);
+    return true;
+}
+
+static void esp32_i2s_desc_word0(uint32_t addr, uint32_t word0)
+{
+    const uint32_t w = cpu_to_le32(word0);
+    address_space_write(&address_space_memory, addr, MEMTXATTRS_UNSPECIFIED, &w, 4);
+}
+
+/* The level of the serial data input (I2SnI_Data_in[15] through the GPIO matrix). With no audio device on
+ * the circuit, what a receiver reads is that level on every bit. */
+static uint8_t esp32_i2s_rx_fill(Esp32I2sState *s)
+{
+    return esp32_gpio_in_signal_level(s->unit ? 181 : 155) ? 0xFF : 0x00;
+}
+
+/* ---- built-in DAC (I2S0 in LCD mode with SENS DAC_DIG_FORCE) ----
+ * ESP32 TRM, ADC/DAC mode: the DAC takes the upper 8 bits of each 16-bit sample, the right channel to DAC1
+ * (GPIO25) and the left to DAC2 (GPIO26). The Core drives the pads (adapter RtcIo module, 0x3FF484F0): each
+ * entry goes there with its own instant as the DMA reads it into the FIFO, ahead of the shifter. Only the
+ * timer sends (outside the vCPU: a full lane is kept here and retried, never a replayed guest store). */
+
+static bool esp32_i2s_dac_active(Esp32I2sState *s)
+{
+    return s->unit == 0 && esp32_i2s_lcd(s) && esp32_sens_dac_digital();
+}
+
+static void esp32_i2s_dac_queue(Esp32I2sState *s, uint64_t t, uint32_t codes, bool cut)
+{
+    if (s->dac_cnt == ESP32_I2S_DAC_PENDING) { /* the Core is far behind: the oldest goes */
+        s->dac_rd = (s->dac_rd + 1) % ESP32_I2S_DAC_PENDING;
+        s->dac_cnt--;
+    }
+    s->dac[(s->dac_rd + s->dac_cnt) % ESP32_I2S_DAC_PENDING] = (Esp32I2sDacSample){ t, codes, cut };
+    s->dac_cnt++;
+}
+
+/* Sends what is queued; false while the lane is full. The instant goes as a delay from the send. */
+static bool esp32_i2s_dac_flush(Esp32I2sState *s, uint64_t now)
+{
+    while (s->dac_cnt) {
+        const Esp32I2sDacSample *d = &s->dac[s->dac_rd];
+        const uint64_t delay = MIN(d->t > now ? d->t - now : 0, (UINT64_C(1) << 46) - 1);
+        const VnextPublishResult r = d->cut ? writeReg(0x3FF484F8, delay) : writeReg(0x3FF484F0, (delay << 18) | d->codes);
+        if (r != VNEXT_PUBLISHED) return false;
+        s->dac_rd = (s->dac_rd + 1) % ESP32_I2S_DAC_PENDING;
+        s->dac_cnt--;
+    }
+    return true;
+}
+
+/* DAC codes of TX entry `k` of the bytes `d` (`len` of them) read from the descriptor. */
+static uint32_t esp32_i2s_dac_codes(Esp32I2sState *s, const uint8_t *d, uint32_t len, uint64_t k)
+{
+    const unsigned mod = esp32_i2s_fifo_mod(s, true);
+    const bool msb_right = FIELD_EX32(s->regs[R_I2S_CONF], I2S_CONF, TX_MSB_RIGHT);
+    const unsigned chan = FIELD_EX32(s->regs[R_I2S_CONF_CHAN], I2S_CONF_CHAN, TX_CHAN_MOD);
+    const uint8_t single = (s->regs[R_I2S_CONF_SINGLE_DATA] >> 8) & 0xFF;
+    uint32_t right, left, mask = 3;
+    if (mod == 0) {
+        uint32_t w = 0;
+        if (k * 4 < len) memcpy(&w, d + k * 4, MIN(4u, len - (uint32_t)(k * 4)));
+        w = le32_to_cpu(w);
+        const uint32_t hi = (w >> 24) & 0xFF, lo = (w >> 8) & 0xFF;
+        right = msb_right ? hi : lo;
+        left = msb_right ? lo : hi;
+    } else {
+        uint32_t code;
+        if (mod == 1) {
+            /* 16-bit single: each word gives {D[31:16]} then {D[15:0]} */
+            uint16_t h = 0;
+            const uint32_t at = (uint32_t)(k / 2) * 4 + ((k & 1) ? 0 : 2);
+            if (at < len) memcpy(&h, d + at, MIN(2u, len - at));
+            code = (le16_to_cpu(h) >> 8) & 0xFF;
+        } else {
+            uint32_t w = 0;
+            if (k * 4 < len) memcpy(&w, d + k * 4, MIN(4u, len - (uint32_t)(k * 4)));
+            code = (le32_to_cpu(w) >> 24) & 0xFF;
+        }
+        right = left = code;
+        if (mod == 2) {
+            mask = ((k & 1) != msb_right) ? 1 : 2; /* 32-bit dual: one channel per entry */
+        } else if (chan == 3) {
+            if (msb_right) right = single; else left = single;
+        } else if (chan == 4) {
+            if (msb_right) left = single; else right = single;
+        }
+    }
+    return (mask << 16) | (left << 8) | right;
+}
+
+/* Entries [first, first + n) of the TX descriptor being read, the first of them at shifter index `index`. */
+static void esp32_i2s_dac_emit(Esp32I2sState *s, uint64_t first, uint64_t n, uint64_t index)
+{
+    Esp32I2sChan *c = &s->tx;
+    if (!esp32_i2s_dac_active(s)) return;
+    const unsigned eb = esp32_i2s_entry_bytes(s, true);
+    /* whole words: in mode 1 an entry pair shares one */
+    const uint64_t word_first = esp32_i2s_fifo_mod(s, true) == 1 ? first / 2 * 2 : first;
+    const uint32_t from = (uint32_t)(word_first * eb);
+    const uint32_t to = MIN((uint32_t)((first + n + 1) * eb), c->len);
+    uint8_t d[ESP32_I2S_FIFO_DEPTH * 4 + 8];
+    memset(d, 0, sizeof(d));
+    const uint32_t got = to > from ? MIN(to - from, (uint32_t)sizeof(d)) : 0;
+    if (got) address_space_read(&address_space_memory, c->buf + from, MEMTXATTRS_UNSPECIFIED, d, got);
+    for (uint64_t k = 0; k < n; ++k) {
+        esp32_i2s_dac_queue(s, esp32_i2s_time(c, index + k), esp32_i2s_dac_codes(s, d, got, first + k - word_first), false);
+    }
+}
+
+/* ---- built-in ADC (I2S0 RX in LCD mode with APB_SARADC DATA_TO_I2S) ----
+ * ESP32 TRM, DIG ADC controller: one conversion per entry, going through the pattern table; each 16-bit
+ * sample is the channel [15:12] and the data [11:0] (DATA_SAR_SEL 0) or the unit [15], channel [14:11] and
+ * 11 bits of data (1). The Core samples the pad voltage at each sample's instant (the same instants as
+ * here) and returns it through C2A before QEMU's time passes the instant; the RX timer holds the vCPUs
+ * when a descriptor closes before its samples arrived. */
+
+static Esp32I2sState *esp32_i2s_unit0;
+
+static bool esp32_i2s_adc_mode(Esp32I2sState *s)
+{
+    if (s->unit != 0 || !esp32_i2s_lcd(s)) return false;
+    Esp32SaradcDig dig;
+    esp32_apbctrl_saradc(&dig);
+    return dig.to_i2s;
+}
+
+/* The RX shifter (re)started or changed: sample 0 is its current entry. */
+static void esp32_i2s_adc_restart(Esp32I2sState *s)
+{
+    Esp32SaradcDig dig;
+    esp32_apbctrl_saradc(&dig);
+    s->adc_want = s->rx.clocked && esp32_i2s_adc_mode(s);
+    s->adc_base = s->rx.base;
+    s->adc_recv = 0;
+    s->adc_unit = dig.unit;
+    s->adc_len = MAX(dig.len, 1u);
+    memcpy(s->adc_pattern, dig.pattern, sizeof(s->adc_pattern));
+    s->adc_format2 = dig.format2;
+    s->adc_inv = dig.inv;
+    if (s->adc_want || s->adc_on) {
+        s->adc_pending = true;
+        s->adc_sent = 0;
+    }
+}
+
+/* From the RX timer (outside the vCPU): the configuration to the adapter, four writes, the commit last. */
+static bool esp32_i2s_adc_send(Esp32I2sState *s)
+{
+    if (!s->adc_pending) return true;
+    uint64_t pads = 0;
+    for (unsigned i = 0; i < 16; ++i) pads |= (uint64_t)(s->adc_pattern[i] >> 4) << (4 * i);
+    const uint64_t commit = (s->rx.per_den & ((UINT64_C(1) << 40) - 1)) | ((uint64_t)(s->adc_len - 1) << 56) |
+                            ((uint64_t)s->adc_unit << 60) | ((uint64_t)s->adc_want << 63);
+    const uint64_t t0 = esp32_i2s_time(&s->rx, s->adc_base);
+    const struct { uint64_t addr, value; } w[4] = {
+        { 0x3FF48BC0, t0 }, { 0x3FF48BC4, s->rx.per_num }, { 0x3FF48BCC, pads }, { 0x3FF48BC8, commit } };
+    while (s->adc_sent < 4) {
+        if (writeReg(w[s->adc_sent].addr, w[s->adc_sent].value) != VNEXT_PUBLISHED) return false;
+        s->adc_sent++;
+    }
+    s->adc_pending = false;
+    s->adc_on = s->adc_want;
+    return true;
+}
+
+void esp32_i2s_vnext_adc(uint64_t value)
+{
+    Esp32I2sState *s = esp32_i2s_unit0;
+    if (!s) return;
+    const unsigned n = MIN((unsigned)((value >> 48) & 7), 3u);
+    for (unsigned i = 0; i < n; ++i) {
+        s->adc_ring[s->adc_recv % ESP32_I2S_ADC_RING] = (value >> (16 * i)) & 0xFFFF;
+        s->adc_recv++;
+    }
+}
+
+/* The 16-bit sample of RX entry `entry`, or false while the Core has not delivered it. */
+static bool esp32_i2s_adc_sample(Esp32I2sState *s, uint64_t entry, uint16_t *out)
+{
+    if (entry < s->adc_base) {
+        *out = 0;
+        return true;
+    }
+    const uint64_t k = entry - s->adc_base;
+    if (k >= s->adc_recv) return false;
+    if (s->adc_recv - k > ESP32_I2S_ADC_RING) {
+        *out = 0; /* overwritten: the DMA fell that far behind */
+        return true;
+    }
+    const uint8_t p = s->adc_pattern[k % s->adc_len];
+    const unsigned channel = p >> 4, width = 9 + ((p >> 2) & 3), atten = p & 3;
+    const double mv = s->adc_ring[k % ESP32_I2S_ADC_RING] / 10.0;
+    uint32_t code = esp32_sens_adc_code((int)s->adc_unit, (int)atten, (int)width, mv, s->adc_inv);
+    if (s->adc_format2) {
+        if (width == 12) code >>= 1;
+        *out = (uint16_t)((s->adc_unit << 15) | ((channel & 0xF) << 11) | (code & 0x7FF));
+    } else {
+        *out = (uint16_t)(((channel & 0xF) << 12) | (code & 0xFFF));
+    }
+    return true;
+}
+
+/* ---- TX ---- */
+
+static void esp32_i2s_tx_schedule(Esp32I2sState *s);
+
+/* The descriptor whose last entry left the shifter. */
+static void esp32_i2s_tx_sent(Esp32I2sState *s, const Esp32I2sInflight *f)
+{
+    const bool eof_on_pop = FIELD_EX32(s->regs[R_I2S_LC_CONF], I2S_LC_CONF, OUT_EOF_MODE);
+    if (f->eof && eof_on_pop) {
+        s->regs[R_I2S_OUT_EOF_DES_ADDR] = f->desc;
+        s->regs[R_I2S_OUT_EOF_BFR_DES_ADDR] = f->buf;
+        esp32_i2s_raise(s, ESP32_I2S_INT_OUT_EOF);
+    }
+    if (!f->next && eof_on_pop) esp32_i2s_raise(s, ESP32_I2S_INT_OUT_TOTAL_EOF);
+}
+
+/* The DMA side: read the descriptors into the FIFO as it gets room (only while the shifter runs; what a
+ * stopped transmitter would prefetch is not modeled). */
+static void esp32_i2s_tx_dma(Esp32I2sState *s, uint64_t now)
+{
+    Esp32I2sChan *c = &s->tx;
+    const unsigned eb = esp32_i2s_entry_bytes(s, true);
+    if (!c->clocked) return;
+    while (c->link && c->inflight_cnt < ESP32_I2S_INFLIGHT) {
+        if (!c->have_desc) {
+            uint32_t w[3];
+            if (!esp32_i2s_desc_read(c->next, w) ||
+                (FIELD_EX32(s->regs[R_I2S_LC_CONF], I2S_LC_CONF, CHECK_OWNER) && !(w[0] >> 31))) {
+                esp32_i2s_raise(s, ESP32_I2S_INT_OUT_DSCR_ERR);
+                c->link = false;
+                break;
+            }
+            c->desc = c->next;
+            c->buf = w[1];
+            c->len = (w[0] >> 12) & 0xFFFu;
+            c->desc_eof = (w[0] >> 30) & 1u;
+            c->next = w[2];
+            c->have_desc = true;
+            c->desc_done = 0;
+            s->regs[R_I2S_OUTLINK_DSCR] = c->desc;
+            s->regs[R_I2S_OUTLINK_DSCR_BF0] = c->next;
+            s->regs[R_I2S_OUTLINK_DSCR_BF1] = c->buf;
+            /* The FIFO ran dry (or the shifter never started): the new data goes out from now. */
+            if (c->pushed <= esp32_i2s_index(c, now)) {
+                c->base = c->pushed;
+                c->t0 = now;
+            }
+        }
+        const uint64_t entries = (c->len + eb - 1) / eb;
+        const uint64_t popped = esp32_i2s_index(c, now);
+        const uint64_t room = popped + ESP32_I2S_FIFO_DEPTH > c->pushed ? popped + ESP32_I2S_FIFO_DEPTH - c->pushed : 0;
+        const uint64_t n = MIN(room, entries - c->desc_done);
+        if (n) {
+            esp32_i2s_dac_emit(s, c->desc_done, n, c->pushed);
+            c->pushed += n;
+            c->desc_done += n;
+        }
+        if (c->desc_done < entries) {
+            break; /* the FIFO is full: esp32_i2s_tx_schedule wakes when it has room again */
+        }
+        esp32_i2s_raise(s, ESP32_I2S_INT_OUT_DONE);
+        if (FIELD_EX32(s->regs[R_I2S_LC_CONF], I2S_LC_CONF, OUT_AUTO_WRBACK)) {
+            uint32_t w[3];
+            if (esp32_i2s_desc_read(c->desc, w)) esp32_i2s_desc_word0(c->desc, w[0] & ~BIT(31));
+        }
+        Esp32I2sInflight f = { .last = c->pushed ? c->pushed - 1 : 0, .desc = c->desc, .buf = c->buf,
+                               .next = c->next, .eof = c->desc_eof };
+        if (!FIELD_EX32(s->regs[R_I2S_LC_CONF], I2S_LC_CONF, OUT_EOF_MODE)) {
+            if (f.eof) {
+                s->regs[R_I2S_OUT_EOF_DES_ADDR] = f.desc;
+                s->regs[R_I2S_OUT_EOF_BFR_DES_ADDR] = f.buf;
+                esp32_i2s_raise(s, ESP32_I2S_INT_OUT_EOF);
+            }
+            if (!f.next) esp32_i2s_raise(s, ESP32_I2S_INT_OUT_TOTAL_EOF);
+        }
+        if (entries) {
+            c->inflight[(c->inflight_rd + c->inflight_cnt) % ESP32_I2S_INFLIGHT] = f;
+            c->inflight_cnt++;
+        } else {
+            esp32_i2s_tx_sent(s, &f);
+        }
+        c->have_desc = false;
+        if (!c->next) {
+            c->link = false;
+            c->chain_end = true;
+        }
+    }
+}
+
+/* The shifter side: descriptors whose last entry has been sent. */
+static void esp32_i2s_tx_pop(Esp32I2sState *s, uint64_t now)
+{
+    Esp32I2sChan *c = &s->tx;
+    const uint64_t popped = esp32_i2s_index(c, now);
+    while (c->inflight_cnt && c->inflight[c->inflight_rd].last < popped) {
+        esp32_i2s_tx_sent(s, &c->inflight[c->inflight_rd]);
+        c->inflight_rd = (c->inflight_rd + 1) % ESP32_I2S_INFLIGHT;
+        c->inflight_cnt--;
+        if (!c->inflight_cnt && !c->link) esp32_i2s_raise(s, ESP32_I2S_INT_TX_REMPTY);
+    }
+}
+
+/* CPU FIFO mode: entries the shifter took from FIFO_WR data. */
+static void esp32_i2s_tx_fifo_pop(Esp32I2sState *s, uint64_t now)
+{
+    Esp32I2sChan *c = &s->tx;
+    if (!c->clocked) return;
+    const uint64_t index = esp32_i2s_index(c, now);
+    while (c->fifo_cnt && c->fifo_popped < index) {
+        c->fifo_rd = (c->fifo_rd + 1) % ESP32_I2S_FIFO_DEPTH;
+        c->fifo_cnt--;
+        c->fifo_popped++;
+        if (c->fifo_cnt < FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, TX_DATA_NUM)) {
+            esp32_i2s_raise(s, ESP32_I2S_INT_TX_PUT_DATA);
+        }
+        if (!c->fifo_cnt) esp32_i2s_raise(s, ESP32_I2S_INT_TX_REMPTY);
+    }
+}
+
+static void esp32_i2s_tx_run(Esp32I2sState *s, uint64_t now)
+{
+    if (FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, DSCR_EN)) {
+        esp32_i2s_tx_pop(s, now);
+        esp32_i2s_tx_dma(s, now);
+        esp32_i2s_tx_pop(s, now);
+    } else {
+        esp32_i2s_tx_fifo_pop(s, now);
+    }
+    esp32_i2s_update_irq(s);
+    esp32_i2s_tx_schedule(s);
+}
+
+static void esp32_i2s_tx_schedule(Esp32I2sState *s)
+{
+    Esp32I2sChan *c = &s->tx;
+    uint64_t due = UINT64_MAX;
+    if (c->clocked) {
+        if (FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, DSCR_EN)) {
+            if (c->inflight_cnt) due = esp32_i2s_time(c, c->inflight[c->inflight_rd].last + 1);
+            if (c->link && c->have_desc) {
+                /* room for the rest of the descriptor, or for half the FIFO */
+                const unsigned eb = esp32_i2s_entry_bytes(s, true);
+                const uint64_t left = (c->len + eb - 1) / eb - c->desc_done;
+                const uint64_t need = MIN(left, (uint64_t)ESP32_I2S_FIFO_DEPTH / 2);
+                const uint64_t at = c->pushed + need;
+                due = MIN(due, at > ESP32_I2S_FIFO_DEPTH ? esp32_i2s_time(c, at - ESP32_I2S_FIFO_DEPTH) : c->t0);
+            }
+        } else if (c->fifo_cnt) {
+            due = esp32_i2s_time(c, c->fifo_popped + 1);
+        }
+    }
+    if (s->dac_cnt) due = MIN(due, getQemu_ns() + (s->dac_blocked ? 2000 : 0)); /* samples for the Core */
+    if (due == UINT64_MAX) timer_del(&c->timer);
+    else timer_mod_ns(&c->timer, due);
+}
+
+static void esp32_i2s_tx_timer_cb(void *opaque)
+{
+    Esp32I2sState *s = ESP32_I2S(opaque);
+    const uint64_t now = getQemu_ns();
+    esp32_i2s_tx_run(s, now);
+    if (s->dac_cnt) {
+        s->dac_blocked = !esp32_i2s_dac_flush(s, now);
+        esp32_i2s_tx_schedule(s);
+    }
+}
+
+static void esp32_i2s_tx_reset_dma(Esp32I2sChan *c)
+{
+    c->link = false;
+    c->have_desc = false;
+    c->chain_end = false;
+    c->inflight_rd = c->inflight_cnt = 0;
+}
+
+/* ---- RX ---- */
+
+static void esp32_i2s_rx_schedule(Esp32I2sState *s);
+
+static bool esp32_i2s_rx_fetch(Esp32I2sState *s)
+{
+    Esp32I2sChan *c = &s->rx;
+    uint32_t w[3];
+    if (!c->next) {
+        esp32_i2s_raise(s, ESP32_I2S_INT_IN_DSCR_EMPTY);
+        c->link = false;
+        return false;
+    }
+    if (!esp32_i2s_desc_read(c->next, w) ||
+        (FIELD_EX32(s->regs[R_I2S_LC_CONF], I2S_LC_CONF, CHECK_OWNER) && !(w[0] >> 31))) {
+        esp32_i2s_raise(s, ESP32_I2S_INT_IN_DSCR_ERR);
+        c->link = false;
+        return false;
+    }
+    c->desc = c->next;
+    c->buf = w[1];
+    c->len = w[0] & 0xFFFu;
+    c->next = w[2];
+    c->off = 0;
+    c->have_desc = true;
+    s->regs[R_I2S_INLINK_DSCR] = c->desc;
+    s->regs[R_I2S_INLINK_DSCR_BF0] = c->next;
+    s->regs[R_I2S_INLINK_DSCR_BF1] = c->buf;
+    return true;
+}
+
+/* Hand a filled inlink descriptor back to the CPU: length, eof, owner 0. */
+static void esp32_i2s_rx_close(Esp32I2sChan *c, bool eof)
+{
+    uint32_t w[3];
+    if (!esp32_i2s_desc_read(c->desc, w)) return;
+    esp32_i2s_desc_word0(c->desc, (w[0] & 0xFFFu) | ((c->off & 0xFFFu) << 12) | (eof ? BIT(30) : 0));
+    c->have_desc = false;
+}
+
+/* The bytes of RX entries [first, first + n) at descriptor offset `off` (mode 1: two 16-bit entries per
+ * word, the first in the upper half -- the I2S moves the most significant half-word first). False while
+ * an ADC sample has not arrived. */
+static bool esp32_i2s_rx_data(Esp32I2sState *s, uint64_t first, uint64_t n, uint32_t off, uint8_t *out, uint32_t bytes)
+{
+    const unsigned eb = esp32_i2s_entry_bytes(s, false);
+    if (!s->adc_on || !esp32_i2s_adc_mode(s)) {
+        memset(out, esp32_i2s_rx_fill(s), bytes);
+        return true;
+    }
+    for (uint64_t k = 0; k < n; ++k) {
+        uint16_t v;
+        if (!esp32_i2s_adc_sample(s, first + k, &v)) return false;
+        const uint32_t at = (uint32_t)(k * eb);
+        if (eb == 2) {
+            const uint32_t pos = off + at;               /* this entry's place in the descriptor */
+            const uint32_t slot = (pos & ~3u) + ((pos & 2) ? 0 : 2) - off;
+            if (slot + 2 <= bytes) stw_le_p(out + slot, v);
+        } else if (at + 4 <= bytes) {
+            stl_le_p(out + at, ((uint32_t)v << 16) | v);
+        }
+    }
+    return true;
+}
+
+/* Entries received up to `now` go to the inlink buffers (DMA) or the RX FIFO (CPU mode). From the RX timer
+ * (`timer`) a descriptor whose ADC samples have not come yet holds the vCPUs here until they do. */
+static void esp32_i2s_rx_run_ex(Esp32I2sState *s, uint64_t now, bool timer)
+{
+    Esp32I2sChan *c = &s->rx;
+    const uint64_t received = esp32_i2s_index(c, now);
+    const unsigned eb = esp32_i2s_entry_bytes(s, false);
+    const bool dma = FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, DSCR_EN);
+    const uint8_t fill = esp32_i2s_rx_fill(s);
+    bool waiting = false;
+    while (c->done < received) {
+        if (!dma) {
+            if (c->fifo_cnt < ESP32_I2S_FIFO_DEPTH) {
+                c->fifo[(c->fifo_rd + c->fifo_cnt) % ESP32_I2S_FIFO_DEPTH] = fill ? 0xFFFFFFFFu : 0;
+                c->fifo_cnt++;
+                if (c->fifo_cnt > FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, RX_DATA_NUM)) {
+                    esp32_i2s_raise(s, ESP32_I2S_INT_RX_TAKE_DATA);
+                }
+                if (c->fifo_cnt == ESP32_I2S_FIFO_DEPTH) esp32_i2s_raise(s, ESP32_I2S_INT_RX_WFULL);
+            }
+            c->done++;
+            continue;
+        }
+        if (!c->link || (!c->have_desc && !esp32_i2s_rx_fetch(s))) {
+            c->done = received; /* nowhere to go: the FIFO overflows */
+            break;
+        }
+        /* Up to the descriptor end or the next EOF, whichever comes first. */
+        const uint32_t eof_num = MAX(s->regs[R_I2S_RXEOF_NUM], 1u);
+        const uint64_t to_full = (c->len - c->off + eb - 1) / eb;
+        const uint64_t to_eof = ((uint64_t)eof_num * 4 - MIN(c->eof_bytes, eof_num * 4) + eb - 1) / eb;
+        uint64_t n = MIN(MIN(to_full, to_eof), received - c->done);
+        if (n == 0) n = 1;
+        uint32_t bytes = MIN((uint32_t)(n * eb), c->len - c->off);
+        uint8_t chunk[256];
+        if (bytes > sizeof(chunk)) {
+            bytes = sizeof(chunk);
+            n = bytes / eb;
+        }
+        if (eb == 2 && ((c->off + bytes) & 3) && c->off + bytes < c->len) {
+            /* mode 1: the two entries of a word go together */
+            if (n == 1) break;
+            bytes -= 2;
+            n--;
+        }
+        if (!esp32_i2s_rx_data(s, c->done, n, c->off, chunk, bytes)) {
+            if (timer) vnext_b_lockstep_hold_now();
+            waiting = true;
+            break;
+        }
+        address_space_write(&address_space_memory, c->buf + c->off, MEMTXATTRS_UNSPECIFIED, chunk, bytes);
+        c->off += bytes;
+        c->done += n;
+        c->eof_bytes += bytes;
+        if (c->eof_bytes >= eof_num * 4) {
+            c->eof_bytes = 0;
+            s->regs[R_I2S_IN_EOF_DES_ADDR] = c->desc;
+            esp32_i2s_rx_close(c, true);
+            esp32_i2s_raise(s, ESP32_I2S_INT_IN_SUC_EOF | ESP32_I2S_INT_IN_DONE);
+        } else if (c->off >= c->len) {
+            esp32_i2s_rx_close(c, false);
+            esp32_i2s_raise(s, ESP32_I2S_INT_IN_DONE);
+        }
+    }
+    esp32_i2s_update_irq(s);
+    esp32_i2s_rx_schedule(s);
+    if (waiting) timer_mod_ns(&c->timer, now + 1000); /* the Core's samples: try again in 1 us */
+}
+
+static void esp32_i2s_rx_run(Esp32I2sState *s, uint64_t now)
+{
+    esp32_i2s_rx_run_ex(s, now, false);
+}
+
+static void esp32_i2s_rx_schedule(Esp32I2sState *s)
+{
+    Esp32I2sChan *c = &s->rx;
+    uint64_t due = UINT64_MAX;
+    if (c->clocked) {
+        if (FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, DSCR_EN)) {
+            if (c->link) {
+                const unsigned eb = esp32_i2s_entry_bytes(s, false);
+                const uint32_t eof_num = MAX(s->regs[R_I2S_RXEOF_NUM], 1u);
+                uint64_t n = ((uint64_t)eof_num * 4 - MIN(c->eof_bytes, eof_num * 4) + eb - 1) / eb;
+                if (c->have_desc) n = MIN(n, (c->len - c->off + eb - 1) / eb);
+                due = esp32_i2s_time(c, c->done + MAX(n, 1u));
+            }
+        } else {
+            /* the next RX_TAKE_DATA / RX_WFULL */
+            const uint32_t thr = FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, RX_DATA_NUM);
+            if (c->fifo_cnt < ESP32_I2S_FIFO_DEPTH) {
+                const uint64_t need = c->fifo_cnt <= thr ? thr + 1 - c->fifo_cnt : ESP32_I2S_FIFO_DEPTH - c->fifo_cnt;
+                due = esp32_i2s_time(c, c->done + need);
+            }
+        }
+    }
+    if (due == UINT64_MAX) timer_del(&c->timer);
+    else timer_mod_ns(&c->timer, due);
+}
+
+static void esp32_i2s_rx_timer_cb(void *opaque)
+{
+    Esp32I2sState *s = ESP32_I2S(opaque);
+    const uint64_t now = getQemu_ns();
+    if (!esp32_i2s_adc_send(s)) {
+        timer_mod_ns(&s->rx.timer, now + 2000); /* the lane is full: the configuration goes in 2 us */
+        return;
+    }
+    esp32_i2s_rx_run_ex(s, now, true);
+}
+
+static void esp32_i2s_rx_reset_dma(Esp32I2sChan *c)
+{
+    c->link = false;
+    c->have_desc = false;
+    c->eof_bytes = 0;
+}
+
+/* ---- registers ---- */
+
+static void esp32_i2s_reclock(Esp32I2sState *s, uint64_t now)
+{
+    esp32_i2s_tx_run(s, now);
+    esp32_i2s_rx_run(s, now);
+    esp32_i2s_rebase(s, &s->tx, true, now);
+    esp32_i2s_rebase(s, &s->rx, false, now);
+    s->rx.done = esp32_i2s_index(&s->rx, now);
+    esp32_i2s_adc_restart(s);
+    esp32_i2s_tx_schedule(s);
+    esp32_i2s_rx_schedule(s);
+    if (s->adc_pending) timer_mod_ns(&s->rx.timer, now);
+}
+
+static uint64_t esp32_i2s_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32I2sState *s = ESP32_I2S(opaque);
+    const uint64_t now = getQemu_ns();
+    if (addr / 4 >= ESP32_I2S_REGS) return 0;
+    switch (addr) {
+    case A_I2S_FIFO_RD: {
+        esp32_i2s_rx_run(s, now);
+        Esp32I2sChan *c = &s->rx;
+        uint32_t v = 0;
+        if (c->fifo_cnt) {
+            v = c->fifo[c->fifo_rd];
+            c->fifo_rd = (c->fifo_rd + 1) % ESP32_I2S_FIFO_DEPTH;
+            c->fifo_cnt--;
+            if (!c->fifo_cnt) esp32_i2s_raise(s, ESP32_I2S_INT_RX_REMPTY);
+            esp32_i2s_update_irq(s);
+            esp32_i2s_rx_schedule(s);
+        }
+        return v;
+    }
+    case A_I2S_INT_RAW:
+    case A_I2S_INT_ST:
+        esp32_i2s_tx_run(s, now);
+        esp32_i2s_rx_run(s, now);
+        return s->regs[addr / 4];
+    case A_I2S_STATE: {
+        esp32_i2s_tx_run(s, now);
+        Esp32I2sChan *c = &s->tx;
+        const bool busy = c->clocked && (c->inflight_cnt || c->fifo_cnt || c->link);
+        return busy ? 0 : 1; /* TX_IDLE; the FIFO resets finish at once */
+    }
+    case A_I2S_DATE:
+        return 0x1604201;
+    default:
+        return s->regs[addr / 4];
+    }
+}
+
+static void esp32_i2s_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    Esp32I2sState *s = ESP32_I2S(opaque);
+    const uint64_t now = getQemu_ns();
+    const uint32_t v = value;
+    if (addr / 4 >= ESP32_I2S_REGS) return;
+    switch (addr) {
+    case A_I2S_FIFO_WR: {
+        Esp32I2sChan *c = &s->tx;
+        esp32_i2s_tx_fifo_pop(s, now);
+        const unsigned n = esp32_i2s_fifo_mod(s, true) == 1 ? 2 : 1;
+        for (unsigned i = 0; i < n; ++i) {
+            if (c->fifo_cnt >= ESP32_I2S_FIFO_DEPTH) break;
+            if (c->clocked && !c->fifo_cnt && c->fifo_popped <= esp32_i2s_index(c, now)) {
+                c->base = c->fifo_popped; /* the FIFO ran dry: the new data goes out from now */
+                c->t0 = now;
+            }
+            c->fifo[(c->fifo_rd + c->fifo_cnt) % ESP32_I2S_FIFO_DEPTH] = v;
+            c->fifo_cnt++;
+        }
+        if (c->fifo_cnt == ESP32_I2S_FIFO_DEPTH) esp32_i2s_raise(s, ESP32_I2S_INT_TX_WFULL);
+        esp32_i2s_update_irq(s);
+        esp32_i2s_tx_schedule(s);
+        return;
+    }
+    case A_I2S_CONF: {
+        esp32_i2s_tx_run(s, now);
+        esp32_i2s_rx_run(s, now);
+        s->regs[R_I2S_CONF] = v;
+        if (v & (R_I2S_CONF_TX_RESET_MASK | R_I2S_CONF_TX_FIFO_RESET_MASK)) {
+            /* what the FIFO held never goes out */
+            if (s->unit == 0 && s->tx.pushed > esp32_i2s_index(&s->tx, now)) esp32_i2s_dac_queue(s, now, 0, true);
+            s->tx.fifo_rd = s->tx.fifo_cnt = 0;
+            s->tx.inflight_rd = s->tx.inflight_cnt = 0;
+            s->tx.pushed = s->tx.fifo_popped = esp32_i2s_index(&s->tx, now);
+        }
+        if (v & (R_I2S_CONF_RX_RESET_MASK | R_I2S_CONF_RX_FIFO_RESET_MASK)) {
+            s->rx.fifo_rd = s->rx.fifo_cnt = 0;
+        }
+        const bool tx_on = esp32_i2s_clock_on(s, true), rx_on = esp32_i2s_clock_on(s, false);
+        if (tx_on != s->tx.clocked) {
+            if (!tx_on && s->unit == 0) esp32_i2s_dac_queue(s, now, 0, true); /* the shifter stops here */
+            esp32_i2s_rebase(s, &s->tx, true, now);
+            s->tx.clocked = tx_on;
+            /* the shifter starts with the oldest entry the FIFO holds (none sent while it ran dry) */
+            if (tx_on) s->tx.base = FIELD_EX32(s->regs[R_I2S_FIFO_CONF], I2S_FIFO_CONF, DSCR_EN)
+                                    ? MIN(s->tx.base, s->tx.pushed) : s->tx.fifo_popped;
+        }
+        if (rx_on != s->rx.clocked) {
+            esp32_i2s_rebase(s, &s->rx, false, now);
+            s->rx.clocked = rx_on;
+            s->rx.done = s->rx.base;
+            esp32_i2s_adc_restart(s);
+            if (s->adc_pending) timer_mod_ns(&s->rx.timer, now);
+        }
+        esp32_i2s_tx_run(s, now);
+        esp32_i2s_rx_run(s, now);
+        return;
+    }
+    case A_I2S_INT_RAW:
+    case A_I2S_INT_ST:
+        return;
+    case A_I2S_INT_ENA:
+        s->regs[R_I2S_INT_ENA] = v;
+        esp32_i2s_update_irq(s);
+        return;
+    case A_I2S_INT_CLR:
+        esp32_i2s_tx_run(s, now);
+        esp32_i2s_rx_run(s, now);
+        s->regs[R_I2S_INT_RAW] &= ~v;
+        esp32_i2s_update_irq(s);
+        return;
+    case A_I2S_OUT_LINK:
+        esp32_i2s_tx_run(s, now);
+        s->regs[R_I2S_OUT_LINK] = v & R_I2S_OUT_LINK_ADDR_MASK; /* START/STOP/RESTART act once */
+        if (FIELD_EX32(v, I2S_OUT_LINK, STOP)) s->tx.link = false;
+        if (FIELD_EX32(v, I2S_OUT_LINK, START)) {
+            s->tx.next = ESP32_I2S_DMA_BUS | FIELD_EX32(v, I2S_OUT_LINK, ADDR);
+            s->tx.have_desc = false;
+            s->tx.chain_end = false;
+            s->tx.link = true;
+        }
+        if (FIELD_EX32(v, I2S_OUT_LINK, RESTART) && !s->tx.link) s->tx.link = s->tx.next != 0;
+        esp32_i2s_tx_run(s, now);
+        return;
+    case A_I2S_IN_LINK:
+        esp32_i2s_rx_run(s, now);
+        s->regs[R_I2S_IN_LINK] = v & R_I2S_OUT_LINK_ADDR_MASK;
+        if (FIELD_EX32(v, I2S_OUT_LINK, STOP)) s->rx.link = false;
+        if (FIELD_EX32(v, I2S_OUT_LINK, START)) {
+            s->rx.next = ESP32_I2S_DMA_BUS | FIELD_EX32(v, I2S_OUT_LINK, ADDR);
+            s->rx.have_desc = false;
+            s->rx.link = true;
+        }
+        if (FIELD_EX32(v, I2S_OUT_LINK, RESTART) && !s->rx.link) s->rx.link = s->rx.next != 0;
+        esp32_i2s_rx_run(s, now);
+        return;
+    case A_I2S_LC_CONF:
+        esp32_i2s_tx_run(s, now);
+        esp32_i2s_rx_run(s, now);
+        s->regs[R_I2S_LC_CONF] = v;
+        if (FIELD_EX32(v, I2S_LC_CONF, OUT_RST)) esp32_i2s_tx_reset_dma(&s->tx);
+        if (FIELD_EX32(v, I2S_LC_CONF, IN_RST)) esp32_i2s_rx_reset_dma(&s->rx);
+        esp32_i2s_tx_schedule(s);
+        esp32_i2s_rx_schedule(s);
+        return;
+    case A_I2S_FIFO_CONF:
+    case A_I2S_CONF2:
+    case A_I2S_CLKM_CONF:
+    case A_I2S_SAMPLE_RATE_CONF:
+        if (s->regs[addr / 4] != v) {
+            esp32_i2s_tx_run(s, now);
+            esp32_i2s_rx_run(s, now);
+            s->regs[addr / 4] = v;
+            esp32_i2s_reclock(s, now);
+        }
+        return;
+    case A_I2S_OUT_EOF_DES_ADDR:
+    case A_I2S_IN_EOF_DES_ADDR:
+    case A_I2S_OUT_EOF_BFR_DES_ADDR:
+    case A_I2S_INLINK_DSCR:
+    case A_I2S_INLINK_DSCR_BF0:
+    case A_I2S_INLINK_DSCR_BF1:
+    case A_I2S_OUTLINK_DSCR:
+    case A_I2S_OUTLINK_DSCR_BF0:
+    case A_I2S_OUTLINK_DSCR_BF1:
+    case A_I2S_STATE:
+    case A_I2S_DATE:
+        return; /* read-only */
+    default:
+        s->regs[addr / 4] = v;
+        return;
+    }
+}
+
+static const MemoryRegionOps esp32_i2s_ops = {
+    .read = esp32_i2s_read,
+    .write = esp32_i2s_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32_i2s_chan_reset(Esp32I2sChan *c)
+{
+    timer_del(&c->timer);
+    c->clocked = c->link = c->have_desc = c->desc_eof = c->chain_end = false;
+    c->t0 = c->base = 0;
+    c->desc = c->buf = c->len = c->next = c->off = 0;
+    c->pushed = c->done = c->fifo_popped = 0;
+    c->eof_bytes = 0;
+    c->inflight_rd = c->inflight_cnt = 0;
+    c->fifo_rd = c->fifo_cnt = 0;
+}
+
+static void esp32_i2s_reset(DeviceState *dev)
+{
+    Esp32I2sState *s = ESP32_I2S(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    /* ESP32 TRM, I2S register reset values */
+    s->regs[R_I2S_CONF] = 0x0000F000;
+    s->regs[R_I2S_FIFO_CONF] = 0x00001820;
+    s->regs[R_I2S_RXEOF_NUM] = 64;
+    s->regs[R_I2S_LC_CONF] = 0x00000100;
+    s->regs[R_I2S_LC_HUNG_CONF] = 0x00000810;
+    s->regs[R_I2S_CONF1] = 0x00000089;
+    s->regs[R_I2S_PD_CONF] = 0x0000000A;
+    s->regs[R_I2S_CONF2] = 0x00000020;
+    s->regs[R_I2S_CLKM_CONF] = 0x00000004;
+    s->regs[R_I2S_SAMPLE_RATE_CONF] = 0x00410186;
+    s->regs[R_I2S_PDM_CONF] = 0x0155002C;
+    s->regs[R_I2S_PDM_FREQ_CONF] = 0x000F01B9;
+    esp32_i2s_chan_reset(&s->tx);
+    esp32_i2s_chan_reset(&s->rx);
+    s->dac_rd = s->dac_cnt = 0;
+    s->dac_blocked = false;
+    s->adc_want = s->adc_pending = false;
+    s->adc_recv = s->adc_base = 0;
+    if (s->adc_on) { /* the Core stops sampling: from the timer, which a reset cannot do now */
+        s->adc_pending = true;
+        s->adc_sent = 0;
+        timer_mod_ns(&s->rx.timer, getQemu_ns());
+    }
+    esp32_i2s_entry_period(s, true, &s->tx.per_num, &s->tx.per_den);
+    esp32_i2s_entry_period(s, false, &s->rx.per_num, &s->rx.per_den);
+    qemu_set_irq(s->irq, 0);
+}
+
+static void esp32_i2s_init(Object *obj)
+{
+    Esp32I2sState *s = ESP32_I2S(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &esp32_i2s_ops, s, TYPE_ESP32_I2S, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    timer_init_ns(&s->tx.timer, QEMU_CLOCK_VIRTUAL, esp32_i2s_tx_timer_cb, s);
+    timer_init_ns(&s->rx.timer, QEMU_CLOCK_VIRTUAL, esp32_i2s_rx_timer_cb, s);
+}
+
+static void esp32_i2s_realize(DeviceState *dev, Error **errp)
+{
+    Esp32I2sState *s = ESP32_I2S(dev);
+    if (s->unit == 0) esp32_i2s_unit0 = s;
+}
