+void esp32_i2c_vnext_slave(uint32_t bus, uint64_t value)
+{
+    if (bus >= 2 || !vnext_i2c_instances[bus]) return;
+    Esp32I2CState *s = vnext_i2c_instances[bus];
+    const unsigned event = (value >> 8) & 0xF;
+    const uint8_t byte = value & 0xFF;
+    switch (event) {
+    case 1: /* a byte received and ACKed */
+        if (fifo8_num_free(&s->rx_fifo) == 0) {
+            s->int_raw_reg |= BIT(2);
+        } else {
+            fifo8_push(&s->rx_fifo, byte);
+            if (fifo8_num_used(&s->rx_fifo) >= FIELD_EX32(s->fifo_conf_reg, I2C_FIFO_CONF, RXFIFO_FULL_THRHD))
+                s->int_raw_reg |= BIT(0);
+        }
+        s->sr_reg |= BIT(6);
+        s->int_raw_reg |= BIT(4);
+        break;
+    case 2: /* addressed */
+        s->sr_reg = (s->sr_reg & ~BIT(1)) | ((value >> 12) & 1 ? BIT(1) : 0) | BIT(4) | BIT(5);
+        s->int_raw_reg |= BIT(9);
+        break;
+    case 3: /* STOP */
+        s->sr_reg = (s->sr_reg & ~(BIT(4) | BIT(5) | (7u << 24))) | ((uint32_t)((value >> 13) & 7) << 24);
+        s->int_raw_reg |= BIT(7);
+        break;
+    case 4: /* a TX FIFO byte went out on the bus */
+        if (fifo8_num_used(&s->tx_fifo)) fifo8_pop(&s->tx_fifo);
+        s->sr_reg |= BIT(6);
+        s->int_raw_reg |= BIT(4);
+        if (fifo8_num_used(&s->tx_fifo) <= FIELD_EX32(s->fifo_conf_reg, I2C_FIFO_CONF, TXFIFO_EMPTY_THRHD))
+            s->int_raw_reg |= BIT(1);
+        break;
+    default:
+        return;
+    }
+    esp32_i2c_update_irq(s);
+}
