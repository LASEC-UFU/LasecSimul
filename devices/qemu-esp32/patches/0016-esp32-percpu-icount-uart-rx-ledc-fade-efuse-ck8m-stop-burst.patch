+/* STOP numa lista so' dele, depois de uma lista fechada por END (o ESP-IDF termina assim algumas
+ * escritas). Se o Core executou o BATCH anterior no fio, o barramento esta' retido -- SCL baixo -- e
+ * so' este STOP o solta, como no chip. Antes ele nao ia ao Core (so' o executor byte a byte o
+ * espelhava) e o SCL ficava em 0 V ate' a transacao seguinte. Num barramento de transferencia
+ * direta e' so' a fronteira da transacao. O tempo do STOP no fio continua cobrado pelo caso STOP. */
+static bool esp32_i2c_try_stop_burst(Esp32I2CState *s)
+{
+    /* O endereco so' identifica o alvo (sem START); vale o ultimo selecionado, mesmo depois de um
+     * reset do FIFO -- o barramento do Core continua retido ate' um STOP ou um START novo. */
+    if (!vnext_b_active() || !s->burstBusHeld) return false;
