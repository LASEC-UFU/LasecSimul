+    s->burstStopOnly = true;
+    s->burstActive = true;
+    s->burstPartial = false;
+    s->burstStop = true;
+    s->burstAddressAck = false;
+    s->burstFirstNack = UINT32_MAX;
+    s->burstRxLen = 0;
+    s->burstWriteCmdCount = 0;
+    s->burstReadCmdCount = 0;
+    return true;
+}
