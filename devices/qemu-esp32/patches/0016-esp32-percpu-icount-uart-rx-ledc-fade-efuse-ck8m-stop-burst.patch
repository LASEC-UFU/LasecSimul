+static int ledc_channel_timer(Esp32LEDCState *s, int channel)
+{
+    const uint32_t conf0 = s->regs[(channel * LEDC_CHANNEL_BYTES) >> 2];
+    return (int)(conf0 & 0x3u) + (channel >= 8 ? 4 : 0);
+}
+
+/* Counter period of `timer` in ns: 2^res ticks of div/256 source clocks; 0 when it is not counting. */
+static long double ledc_timer_period_ns(Esp32LEDCState *s, int timer)
+{
+    const uint32_t conf = ledc_timer_conf(s, timer);
+    const uint32_t res = conf & LEDC_TIMER_RES_MASK;
+    const uint32_t div = (conf >> LEDC_TIMER_DIV_SHIFT) & LEDC_TIMER_DIV_MASK;
+    if (!res || !div || (conf & (LEDC_TIMER_PAUSE | LEDC_TIMER_RST))) return 0;
+    return (long double)div / 256.0L * 1.0e9L / (long double)ledc_timer_src_hz(s, timer) *
+           (long double)(1u << res);
+}
+
+static void ledc_update_irq(Esp32LEDCState *s)
+{
+    qemu_set_irq(s->irq, (s->regs[A_LEDC_INT_RAW_REG >> 2] & s->regs[A_LEDC_INT_ENA_REG >> 2]) != 0);
+}
+
+static uint32_t ledc_fade_duty(Esp32LEDCState *s, int channel, uint32_t steps)
+{
+    const uint32_t conf1 = s->fade_conf1[channel];
+    /* DUTY_SCALE moves the integer part of the duty (above its 4 fractional bits). */
+    const int64_t delta = (int64_t)steps * ((int64_t)LEDC_CONF1_DUTY_SCALE(conf1) << 4);
+    int64_t duty = (conf1 & LEDC_CONF1_DUTY_INC) ? (int64_t)s->fade_start_duty[channel] + delta
+                                                  : (int64_t)s->fade_start_duty[channel] - delta;
+    if (duty < 0) duty = 0;
+    if (duty > LEDC_DUTY_MASK) duty = LEDC_DUTY_MASK;
+    return (uint32_t)duty;
+}
+
+/* Duty in effect now (CHn_DUTY_R): the previous one until the first overflow after DUTY_START, then
+ * the start duty moved DUTY_SCALE per DUTY_CYCLE periods, at most DUTY_NUM times. */
+static uint32_t ledc_duty_now(Esp32LEDCState *s, int channel)
+{
+    if (!s->fade_active[channel]) return s->duty_r[channel];
+    const long double now = (long double)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (now < s->fade_first_ns[channel]) return s->fade_prev_duty[channel];
+    const uint32_t num = LEDC_CONF1_DUTY_NUM(s->fade_conf1[channel]);
+    uint64_t steps = num;
+    if (s->fade_step_ns[channel] > 0) {
+        const long double elapsed = (now - s->fade_first_ns[channel]) / s->fade_step_ns[channel];
+        if (elapsed < (long double)num) steps = (uint64_t)elapsed;
+    }
+    return ledc_fade_duty(s, channel, (uint32_t)steps);
+}
+
+static void ledc_start_update(Esp32LEDCState *s, int channel, uint32_t conf1)
+{
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    s->fade_prev_duty[channel] = ledc_duty_now(s, channel);
+    s->fade_start_duty[channel] = s->regs[(channel * LEDC_CHANNEL_BYTES + 0x8) >> 2] & LEDC_DUTY_MASK;
+    s->fade_conf1[channel] = conf1 & ~LEDC_CONF1_DUTY_START;
+    const uint32_t num = LEDC_CONF1_DUTY_NUM(conf1);
+    s->duty_r[channel] = ledc_fade_duty(s, channel, num);
+    const int timer = ledc_channel_timer(s, channel);
+    const long double period = ledc_timer_period_ns(s, timer);
+    if (period <= 0) {
+        /* Counter not running: no overflow to wait for -- the duty takes effect as written. */
+        s->fade_active[channel] = false;
+        timer_del(&s->fade_end_timer[channel]);
+        return;
+    }
+    const long double elapsed = (long double)(now - s->timer_epoch_ns[timer]);
+    const long double overflows = elapsed < 0 ? 1.0L : floorl(elapsed / period) + 1.0L;
+    s->fade_first_ns[channel] = (long double)s->timer_epoch_ns[timer] + overflows * period;
+    s->fade_step_ns[channel] = period * (long double)LEDC_CONF1_DUTY_CYCLE(conf1);
+    s->fade_end_ns[channel] = (int64_t)ceill(s->fade_first_ns[channel] + (long double)num * s->fade_step_ns[channel]);
+    s->fade_active[channel] = true;
+    timer_mod(&s->fade_end_timer[channel], s->fade_end_ns[channel]);
+}
+
+static void ledc_fade_end_cb(void *opaque)
+{
+    Esp32LEDCState *s = ESP32_LEDC(opaque);
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    for (int channel = 0; channel < ESP32_LEDC_CHANNEL_CNT; ++channel) {
+        if (!s->fade_active[channel] || now < s->fade_end_ns[channel]) continue;
+        s->fade_active[channel] = false;
+        s->regs[A_LEDC_INT_RAW_REG >> 2] |= LEDC_INT_DUTY_CHNG_END(channel);
+    }
+    ledc_update_irq(s);
+}
+
