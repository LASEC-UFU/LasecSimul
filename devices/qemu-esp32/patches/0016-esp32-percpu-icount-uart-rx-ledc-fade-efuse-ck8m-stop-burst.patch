+#define LEDC_CONF1_DUTY_INC      (1u << 30)
+#define LEDC_CONF1_DUTY_NUM(v)   (((v) >> 20) & 0x3FFu)
+#define LEDC_CONF1_DUTY_CYCLE(v) (((v) >> 10) & 0x3FFu)
+#define LEDC_CONF1_DUTY_SCALE(v) ((v) & 0x3FFu)
+#define LEDC_INT_DUTY_CHNG_END(channel) (1u << (8 + (channel)))  /* HSCH0-7 bits 8-15, LSCH0-7 16-23 */
