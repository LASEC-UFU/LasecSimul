  "properties": [
    {
      "id": "temp",
      "label": "Junta de medição (°C)",
      "group": "Main",
      "valueKind": "number",
      "editor": "number",
      "default": 25,
      "min": -270,
      "max": 1820,
      "step": 1,
      "unit": "°C"
    },
    {
      "id": "ref_temp",
      "label": "Junta de referência (°C)",
      "group": "Main",
      "valueKind": "number",
      "editor": "number",
      "default": 25,
      "min": -50,
      "max": 200,
      "step": 0.5,
      "unit": "°C"
    },
    {
      "id": "tc_type",
      "label": "Tipo",
      "group": "Main",
      "valueKind": "number",
      "editor": "select",
      "default": 3,
      "options": [
        {
          "label": "B (Pt30%Rh/Pt6%Rh)",
          "value": 0
        },
        {
          "label": "E (NiCr/CuNi)",
          "value": 1
        },
        {
          "label": "J (Fe/CuNi)",
          "value": 2
        },
        {
          "label": "K (NiCr/NiAl)",
          "value": 3
        },
        {
          "label": "N (NiCrSi/NiSi)",
          "value": 4
        },
        {
          "label": "R (Pt13%Rh/Pt)",
          "value": 5
        },
        {
          "label": "S (Pt10%Rh/Pt)",
          "value": 6
        },
        {
          "label": "T (Cu/CuNi)",
          "value": 7
        }
      ]
    },
    {
      "id": "emf_mv",
      "label": "Tensão gerada (mV)",
      "group": "Main",
      "valueKind": "number",
      "editor": "readonly",
      "default": 0,
      "unit": "mV",
      "readOnly": true,
      "noCopy": true,
      "hidden": true
    },
    {
      "id": "min_temp",
      "label": "Mín. Temp (°C)",
      "group": "Main",
      "valueKind": "number",
      "editor": "number",
      "default": 0,
      "min": -270,
      "max": 1820,
      "step": 1,
      "unit": "°C"
    },
    {
      "id": "max_temp",
      "label": "Máx. Temp (°C)",
      "group": "Main",
      "valueKind": "number",
      "editor": "number",
      "default": 1200,
      "min": -270,
      "max": 1820,
      "step": 1,
      "unit": "°C"
    },
    {
      "id": "r_loop",
      "label": "Resistência dos fios (Ω)",
      "group": "Parameters",
      "valueKind": "number",
      "editor": "number",
      "default": 5,
      "min": 0.001,
      "max": 10000,
      "step": 0.5,
      "unit": "Ω"
    },
    {
      "id": "broken",
      "label": "Rompido (circuito aberto)",
      "group": "Parameters",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    },
    {
      "id": "dialStep",
      "label": "Passo do Dial",
      "group": "Main",
      "valueKind": "number",
      "editor": "number",
      "unit": "°C",
      "default": 1,
      "min": 0.001,
      "step": 1
    }
  ],
  "help": {
    "description": "Termopar: dois fios de ligas diferentes unidos na junta de medição. Gera entre + e − a tensão de Seebeck E(junta de medição) − E(junta de referência), pelas funções de referência NIST ITS-90 (IEC 60584-1) do tipo escolhido, em série com a resistência dos fios. A junta de referência é onde os fios do termopar (ou o cabo de extensão) encontram o cobre: os bornes do instrumento. Rompido = circuito aberto (o transmissor vai para burnout)."
  },
  "limits": {
    "stepTimeoutMs": 4,
    "expectedComplexity": "low"
  },
  "defaultProperties": {
    "dialStep": 1
  }
}
