{
  "schemaVersion": 1,
  "typeId": "outputs.max72xx_matrix",
  "graphical": true,
  "name": "Max72xx matrix",
  "language": "pt-BR",
  "translations": { "en": { "name": "Max72xx matrix" } },
  "abiVersion": { "major": 4, "minor": 0 },
  "nativeEntry": {
    "win32-x64": "build/win-x64/device.dll",
    "linux-x64": "build/linux-x64/device.so",
    "darwin-universal": "build/macos-universal/device.dylib"
  },
  "pins": [
    { "id": "cs", "kind": "DIGITAL_IN", "x": 24, "y": 96, "angle": 90, "length": 8, "label": "CS" },
    { "id": "din", "kind": "DIGITAL_IN", "x": 16, "y": 96, "angle": 90, "length": 8, "label": "DIN" },
    { "id": "sck", "kind": "DIGITAL_IN", "x": 8, "y": 96, "angle": 90, "length": 8, "label": "SCK" }
  ],
  "properties": [
    {
      "id": "numDisplays", "label": "Tamanho", "group": "Principal",
      "valueKind": "number", "editor": "number", "default": 4, "min": 1, "max": 16, "step": 1
    },
    {
      "id": "color", "label": "Cor", "group": "Principal", "valueKind": "string", "editor": "enum",
      "default": "Yellow",
      "options": ["Yellow", "Red", "Green", "Blue", "Orange", "Purple", "White"],
      "optionLabels": ["Amarelo", "Vermelho", "Verde", "Azul", "Laranja", "Roxo", "Branco"]
    }
  ],
  "limits": { "stepTimeoutMs": 8, "expectedComplexity": "medium" },
  "package": {
    "width": 264,
    "height": 96,
    "border": false,
    "background": { "kind": "none" },
    "dynamicLayout": {
      "width": { "prop": "numDisplays", "multiplier": 64, "offset": 8, "fallback": 4, "min": 72, "max": 1032 },
      "schematicWidth": { "prop": "numDisplays", "multiplier": 64, "offset": 8, "fallback": 4, "min": 72, "max": 1032 }
    },
    "runtimeState": {
      "versionOffset": 0,
      "expectedVersion": 1,
      "surface": {
        "encoding": "luma8",
        "x": 4,
        "y": 4,
        "w": { "prop": "numDisplays", "multiplier": 64, "fallback": 4, "min": 64, "max": 1024 },
        "h": 64,
        "sourceWidth": { "prop": "numDisplays", "multiplier": 8, "fallback": 4, "min": 8, "max": 128 },
        "sourceHeight": 8,
        "payloadOffset": 36,
        "onColor": {
          "prop": "color",
          "map": {
            "Yellow": "#e6e600", "Red": "#e6734b", "Green": "#00e664", "Blue": "#7d7de6",
            "Orange": "#e6af19", "Purple": "#e632d7", "White": "#e6e6e6"
          },
          "fallback": "#e6e600"
        },
        "offColor": "#191919",
        "pixelShape": "circle",
        "pixelGap": 1
      }
    },
    "simulidePaint": {
      "version": 1,
      "source": {
        "file": "src/components/outputs/leds/max72xx_matrix.cpp",
        "className": "Max72xx_matrix",
        "method": "paint"
      },
      "bounds": { "x": 0, "y": 0, "w": 264, "h": 88 },
      "primitives": [
        {
          "kind": "roundedRect", "x": 0, "y": 0,
          "w": { "prop": "numDisplays", "multiplier": 64, "offset": 8, "fallback": 4, "min": 72, "max": 1032 },
          "h": 88, "rx": 2, "ry": 2, "fill": "#324664", "stroke": "#000000"
        },
        {
          "kind": "repeat", "countProp": "numDisplays", "stepX": 64, "stepY": 0,
          "primitives": [
            { "kind": "roundedRect", "x": 4, "y": 4, "w": 64, "h": 64, "rx": 2, "ry": 2, "fill": "#000000" }
          ]
        }
      ]
    },
    "pins": [
      { "id": "cs", "x": 24, "y": 96, "angle": 90, "length": 8, "label": "CS" },
      { "id": "din", "x": 16, "y": 96, "angle": 90, "length": 8, "label": "DIN" },
      { "id": "sck", "x": 8, "y": 96, "angle": 90, "length": 8, "label": "SCK" }
    ]
  },
  "icon": "max72xx",
  "folderPath": ["Saidas", "Leds"],
  "defaultProperties": { "numDisplays": 4, "color": "Yellow" },
  "help": { "description": "Matriz de LEDs em cascata controlada por MAX7219/MAX7221." }
}
