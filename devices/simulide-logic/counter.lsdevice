{
  "schemaVersion": 1,
  "typeId": "logic.counter",
  "name": "Simple Counter",
  "language": "pt-BR",
  "abiVersion": {
    "major": 3,
    "minor": 0
  },
  "nativeEntry": {
    "win32-x64": "build/win-x64/device.dll",
    "linux-x64": "build/linux-x64/device.so",
    "darwin-universal": "build/macos-universal/device.dylib"
  },
  "pins": [
    {
      "id": "clk",
      "kind": "DIGITAL_IN"
    },
    {
      "id": "rst",
      "kind": "DIGITAL_IN"
    },
    {
      "id": "q",
      "kind": "DIGITAL_OUT"
    }
  ],
  "properties": [
    {
      "id": "maxValue",
      "label": "Count to",
      "group": "Main",
      "valueKind": "number",
      "editor": "number",
      "default": 1,
      "min": 1,
      "step": 1
    },
    {
      "id": "inputHighV",
      "label": "Limiar de Baixo para Alto",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputLowV",
      "label": "Limiar de Alto para Baixo",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputImpedance",
      "label": "Impedância de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 1000000000,
      "min": 0,
      "step": 1
    },
    {
      "id": "inputPullupR",
      "label": "Pull-up de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "outputHighV",
      "label": "Tensão Alta de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 5,
      "step": 0.1
    },
    {
      "id": "outputLowV",
      "label": "Tensão Baixa de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 0,
      "step": 0.1
    },
    {
      "id": "outputImpedance",
      "label": "Impedância de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 40,
      "min": 0,
      "step": 1
    },
    {
      "id": "outputPullupR",
      "label": "Pull-up de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "openCollector",
      "label": "Coletor Aberto",
      "group": "Outputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    }
  ],
  "limits": {
    "stepTimeoutMs": 4,
    "expectedComplexity": "low"
  },
  "package": {
    "width": 48,
    "height": 24,
    "border": false,
    "background": {
      "kind": "none"
    },
    "shapes": [],
    "pins": [
      {
        "id": "clk",
        "x": 0,
        "y": 8,
        "angle": 180,
        "length": 8,
        "label": "CLK"
      },
      {
        "id": "rst",
        "x": 0,
        "y": 16,
        "angle": 180,
        "length": 8,
        "label": "RST"
      },
      {
        "id": "q",
        "x": 48,
        "y": 8,
        "angle": 0,
        "length": 8,
        "label": "Q"
      }
    ],
    "viewSpec": {
      "paint": [
        {
          "kind": "rect",
          "x": 0,
          "y": 0,
          "w": 48,
          "h": 24,
          "fill": "#ffffff"
        },
        {
          "kind": "text",
          "x": 24,
          "y": -4,
          "value": "__label",
          "fontSize": 5,
          "color": "#0000aa"
        }
      ]
    }
  },
  "icon": "2to1",
  "folderPath": [
    "Aritmeticos"
  ],
  "defaultProperties": {
    "maxValue": 1,
    "inputHighV": 2.5,
    "inputLowV": 2.5,
    "inputImpedance": 1000000000,
    "inputPullupR": 0,
    "outputHighV": 5,
    "outputLowV": 0,
    "outputImpedance": 40,
    "outputPullupR": 0,
    "openCollector": false
  },
  "help": {
    "description": "Contador lógico simples."
  }
}
