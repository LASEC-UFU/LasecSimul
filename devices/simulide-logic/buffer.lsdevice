{
  "schemaVersion": 1,
  "typeId": "logic.buffer",
  "name": "Buffer",
  "language": "pt-BR",
  "icon": "buffer",
  "folderPath": [
    "Portas"
  ],
  "abiVersion": {
    "major": 4,
    "minor": 0
  },
  "nativeEntry": {
    "win32-x64": "build/win-x64/device.dll",
    "linux-x64": "build/linux-x64/device.so",
    "darwin-universal": "build/macos-universal/device.dylib"
  },
  "pins": [
    {
      "id": "in",
      "kind": "DIGITAL_IN"
    },
    {
      "id": "out",
      "kind": "DIGITAL_OUT"
    }
  ],
  "properties": [
    {
      "id": "inverted",
      "label": "Inverter Saída (NOT)",
      "group": "Main",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    },
    {
      "id": "inputHighV",
      "label": "Limiar de Baixo para Alto",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputLowV",
      "label": "Limiar de Alto para Baixo",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputImpedance",
      "label": "Impedância de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 1000000000,
      "min": 0,
      "step": 1
    },
    {
      "id": "inputPullupR",
      "label": "Pull-up de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "invertInputs",
      "label": "Inverter Entradas",
      "group": "Inputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    },
    {
      "id": "outputHighV",
      "label": "Tensão Alta de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 5,
      "step": 0.1
    },
    {
      "id": "outputLowV",
      "label": "Tensão Baixa de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 0,
      "step": 0.1
    },
    {
      "id": "outputImpedance",
      "label": "Impedância de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 40,
      "min": 0,
      "step": 1
    },
    {
      "id": "outputPullupR",
      "label": "Pull-up de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "openCollector",
      "label": "Coletor Aberto",
      "group": "Outputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    }
  ],
  "limits": {
    "stepTimeoutMs": 4,
    "expectedComplexity": "low"
  },
  "package": {
    "width": 32,
    "height": 16,
    "border": false,
    "background": {
      "kind": "none"
    },
    "viewSpec": {
      "paint": [
        {
          "kind": "path",
          "d": "M 8 0 L 8 16 L 24 9 L 24 7 Z",
          "fill": "#ffffff"
        }
      ]
    },
    "pins": [
      {
        "id": "in",
        "x": 0,
        "y": 8,
        "angle": 180,
        "length": 8,
        "label": ""
      },
      {
        "id": "out",
        "x": 32,
        "y": 8,
        "angle": 0,
        "length": 8,
        "label": "",
        "invertBubble": {
          "when": {
            "inverted": [
              "true"
            ]
          }
        }
      }
    ]
  },
  "help": {
    "description": "Buffer lógico, com opção de inversão quando configurada."
  },
  "defaultProperties": {
    "inputHighV": 2.5,
    "inputLowV": 2.5,
    "inputImpedance": 1000000000,
    "inputPullupR": 0,
    "invertInputs": false,
    "outputHighV": 5,
    "outputLowV": 0,
    "outputImpedance": 40,
    "outputPullupR": 0,
    "openCollector": false
  }
}
