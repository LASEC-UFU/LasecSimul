          "kind": "rect",
          "x": 8,
          "y": 0,
          "w": 48,
          "h": 72,
          "fill": "#ffffff"
        },
        {
          "kind": "text",
          "x": 32,
          "y": -4,
          "value": "__label",
          "fontSize": 5,
          "color": "#0000aa"
        }
      ]
    },
    "pins": [
      {
        "id": "clk",
