      "kind": "DIGITAL_OUT"
    }
  ],
  "properties": [
    {
      "id": "seed",
      "label": "Semente",
      "group": "Main",
      "valueKind": "number",
      "editor": "number",
      "default": 1,
      "min": 1,
      "max": 255,
      "step": 1
    },
    {
      "id": "invertInputs",
      "label": "Inverter Entradas",
      "group": "Inputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    }
  ],
  "limits": {
    "stepTimeoutMs": 4,
    "expectedComplexity": "low"
  },
  "package": {
    "width": 64,
    "height": 72,
    "border": false,
    "background": {
