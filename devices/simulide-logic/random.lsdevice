{
  "schemaVersion": 1,
  "typeId": "logic.random",
  "name": "Random",
  "language": "pt-BR",
  "icon": "package",
  "folderPath": [
    "Memorias"
  ],
  "abiVersion": {
    "major": 3,
    "minor": 0
  },
  "nativeEntry": {
    "win32-x64": "build/win-x64/device.dll",
    "linux-x64": "build/linux-x64/device.so",
    "darwin-universal": "build/macos-universal/device.dylib"
  },
  "pins": [
    {
      "id": "clk",
      "kind": "DIGITAL_IN"
    },
    {
      "id": "rst",
      "kind": "DIGITAL_IN"
    },
    {
      "id": "q0",
      "kind": "DIGITAL_OUT"
    },
    {
      "id": "q1",
      "kind": "DIGITAL_OUT"
    },
    {
