{
  "schemaVersion": 1,
  "typeId": "logic.xor_gate",
  "name": "Xor Gate",
  "language": "pt-BR",
  "icon": "xorgate",
  "folderPath": [
    "Portas"
  ],
  "abiVersion": {
    "major": 4,
    "minor": 0
  },
  "nativeEntry": {
    "win32-x64": "build/win-x64/device.dll",
    "linux-x64": "build/linux-x64/device.so",
    "darwin-universal": "build/macos-universal/device.dylib"
  },
  "pins": [
    {
      "id": "in1",
      "kind": "DIGITAL_IN"
    },
    {
      "id": "in2",
      "kind": "DIGITAL_IN"
    },
    {
      "id": "out",
      "kind": "DIGITAL_OUT"
    }
  ],
  "properties": [
    {
      "id": "inverted",
      "label": "Inverter Saída (XNOR)",
      "group": "Main",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    },
    {
      "id": "inputHighV",
      "label": "Limiar de Baixo para Alto",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputLowV",
      "label": "Limiar de Alto para Baixo",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputImpedance",
      "label": "Impedância de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 1000000000,
      "min": 0,
      "step": 1
    },
    {
      "id": "inputPullupR",
      "label": "Pull-up de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "invertInputs",
      "label": "Inverter Entradas",
      "group": "Inputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    },
    {
      "id": "outputHighV",
      "label": "Tensão Alta de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 5,
      "step": 0.1
    },
    {
      "id": "outputLowV",
      "label": "Tensão Baixa de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 0,
      "step": 0.1
    },
    {
      "id": "outputImpedance",
      "label": "Impedância de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 40,
      "min": 0,
      "step": 1
    },
    {
      "id": "outputPullupR",
      "label": "Pull-up de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "openCollector",
      "label": "Coletor Aberto",
      "group": "Outputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    }
  ],
  "limits": {
    "stepTimeoutMs": 4,
    "expectedComplexity": "low"
  },
  "package": {
    "width": 32,
    "height": 16,
    "border": false,
    "background": {
      "kind": "none"
    },
    "viewSpec": {
      "paint": [
        {
          "kind": "path",
          "d": "M 9 0 Q 23 0 25 8 Q 23 16 9 16 Q 13 8 9 0 Z",
          "fill": "#ffffff"
        },
        {
          "kind": "path",
          "d": "M 6 16 Q 10.5 8 6 0",
          "fill": "none"
        }
      ]
    },
    "pins": [
      {
        "id": "in1",
        "x": 0,
        "y": 4,
        "angle": 180,
        "length": 8,
        "label": ""
      },
      {
        "id": "in2",
        "x": 0,
        "y": 12,
        "angle": 180,
        "length": 8,
        "label": ""
      },
      {
        "id": "out",
        "x": 32,
        "y": 8,
        "angle": 0,
        "length": 8,
        "label": "",
        "invertBubble": {
          "when": {
            "inverted": [
              "true"
            ]
          }
        }
      }
    ]
  },
  "help": {
    "description": "Porta lógica XOR."
  },
  "defaultProperties": {
    "inputHighV": 2.5,
    "inputLowV": 2.5,
    "inputImpedance": 1000000000,
    "inputPullupR": 0,
    "invertInputs": false,
    "outputHighV": 5,
    "outputLowV": 0,
    "outputImpedance": 40,
    "outputPullupR": 0,
    "openCollector": false
  }
}
