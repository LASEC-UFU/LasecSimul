{
  "schemaVersion": 1,
  "typeId": "logic.and_gate",
  "name": "And Gate",
  "language": "pt-BR",
  "icon": "andgate",
  "folderPath": [
    "Portas"
  ],
  "abiVersion": {
    "major": 4,
    "minor": 0
  },
  "nativeEntry": {
    "win32-x64": "build/win-x64/device.dll",
    "linux-x64": "build/linux-x64/device.so",
    "darwin-universal": "build/macos-universal/device.dylib"
  },
  "pins": [
    {
      "id": "out",
      "kind": "DIGITAL_OUT"
    },
    {
      "id": "in1",
      "kind": "DIGITAL_IN"
    },
    {
      "id": "in2",
      "kind": "DIGITAL_IN"
    }
  ],
  "properties": [
    {
      "id": "inputs",
      "label": "Entradas",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "default": 2,
      "min": 2,
      "step": 1,
      "affectsPinCount": true
    },
    {
      "id": "inverted",
      "label": "Inverter Saida (NAND)",
      "group": "Outputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    },
    {
      "id": "inputHighV",
      "label": "Limiar de Baixo para Alto",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputLowV",
      "label": "Limiar de Alto para Baixo",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputImpedance",
      "label": "Impedância de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 1000000000,
      "min": 0,
      "step": 1
    },
    {
      "id": "inputPullupR",
      "label": "Pull-up de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "invertInputs",
      "label": "Inverter Entradas",
      "group": "Inputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    },
    {
      "id": "outputHighV",
      "label": "Tensão Alta de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 5,
      "step": 0.1
    },
    {
      "id": "outputLowV",
      "label": "Tensão Baixa de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 0,
      "step": 0.1
    },
    {
      "id": "outputImpedance",
      "label": "Impedância de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 40,
      "min": 0,
      "step": 1
    },
    {
      "id": "outputPullupR",
      "label": "Pull-up de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "openCollector",
      "label": "Coletor Aberto",
      "group": "Outputs",
      "valueKind": "bool",
      "editor": "checkbox",
      "default": false
    }
  ],
  "limits": {
    "stepTimeoutMs": 4,
    "expectedComplexity": "low"
  },
  "package": {
    "width": 32,
    "height": 16,
    "border": false,
    "background": {
      "kind": "none"
    },
    "viewSpec": {
      "paint": [
        {
          "kind": "path",
          "logicGateBody": {
            "style": "and"
          },
          "fill": "#ffffff"
        }
      ]
    },
    "pins": [
      {
        "id": "out",
        "x": 32,
        "y": {
          "prop": "inputs",
          "multiplier": 4,
          "fallback": 8,
          "min": 8
        },
        "angle": 0,
        "length": 8,
        "label": "",
        "invertBubble": {
          "when": {
            "inverted": [
              "true"
            ]
          }
        }
      }
    ],
    "dynamicLayout": {
      "height": {
        "prop": "inputs",
        "multiplier": 8,
        "fallback": 16,
        "min": 16
      },
      "pinGroups": [
        {
          "countProp": "inputs",
          "indexName": "i",
          "idPrefix": "in",
          "idStart": 1,
          "x": 0,
          "y": {
            "index": "i",
            "multiplier": 8,
            "offset": 4
          },
          "angle": 180,
          "length": 8,
          "label": ""
        }
      ]
    }
  },
  "defaultProperties": {
    "inputs": 2,
    "inverted": false,
    "inputHighV": 2.5,
    "inputLowV": 2.5,
    "inputImpedance": 1000000000,
    "inputPullupR": 0,
    "invertInputs": false,
    "outputHighV": 5,
    "outputLowV": 0,
    "outputImpedance": 40,
    "outputPullupR": 0,
    "openCollector": false
  },
  "pinSpec": {
    "fixedPinIds": [
      "out"
    ],
    "dynamicGroups": [
      {
        "idPrefix": "in",
        "countProperty": "inputs"
      }
    ]
  },
  "help": {
    "description": "Porta lógica AND com quantidade configurável de entradas."
  }
}
