      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 5,
      "step": 0.1
    },
    {
      "id": "outputLowV",
      "label": "Tensão Baixa de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 0,
      "step": 0.1
    },
    {
      "id": "outputImpedance",
