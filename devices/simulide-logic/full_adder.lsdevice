      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputLowV",
      "label": "Limiar de Alto para Baixo",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "V",
      "default": 2.5,
      "step": 0.1
    },
    {
      "id": "inputImpedance",
      "label": "Impedância de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 1000000000,
      "min": 0,
      "step": 1
    },
    {
      "id": "inputPullupR",
      "label": "Pull-up de Entrada",
      "group": "Inputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
    },
    {
      "id": "outputHighV",
