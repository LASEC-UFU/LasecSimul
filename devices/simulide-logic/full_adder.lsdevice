      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 40,
      "min": 0,
      "step": 1
    },
    {
      "id": "outputPullupR",
      "label": "Pull-up de Saída",
      "group": "Outputs",
      "valueKind": "number",
      "editor": "number",
      "unit": "Ω",
      "default": 0,
      "min": 0,
      "step": 1
