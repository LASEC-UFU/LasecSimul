# Embute project/schema/block-library/*.json no executável (docs/66 §3): o Core não depende de
# caminho de instalação para conhecer a biblioteca de blocos. Roda no configure; editar um .json
# reconfigura sozinho (CMAKE_CONFIGURE_DEPENDS). Gera um array de bytes (string literal grande
# esbarra no limite do MSVC) com os arquivos concatenados como um array JSON.
function(lasecsimul_embed_block_library SPEC_DIR OUTPUT)
    file(GLOB _spec_files "${SPEC_DIR}/*.json")
    list(SORT _spec_files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_spec_files})
    set(_json "[")
    set(_first TRUE)
    foreach(_file IN LISTS _spec_files)
        file(READ "${_file}" _content)
        if(NOT _first)
            string(APPEND _json ",")
        endif()
        set(_first FALSE)
        string(APPEND _json "${_content}")
    endforeach()
    string(APPEND _json "]")
    string(LENGTH "${_json}" _length)
    # Hex por byte via arquivo temporário (file(READ HEX) opera sobre arquivos).
    set(_tmp "${OUTPUT}.json")
    file(WRITE "${_tmp}" "${_json}")
    file(READ "${_tmp}" _hex HEX)
    file(SIZE "${_tmp}" _size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" _bytes "${_bytes}")
    set(_source "// Gerado por core/cmake/EmbedBlockLibrary.cmake -- nao editar.\n#include <cstddef>\nnamespace lasecsimul::components::blocks {\nextern const unsigned char kBlockLibrarySpec[] = {\n${_bytes}0x00};\nextern const std::size_t kBlockLibrarySpecSize = ${_size};\n}\n")
    if(EXISTS "${OUTPUT}")
        file(READ "${OUTPUT}" _previous)
    else()
        set(_previous "")
    endif()
    if(NOT _previous STREQUAL _source)
        file(WRITE "${OUTPUT}" "${_source}")
    endif()
endfunction()
