    {
      "id": "interval_test",
      "name": "Interval Test",
      "title": {"pt-BR": "Teste de intervalo"},
      "doc": "https://www.mathworks.com/help/simulink/slref/intervaltest.html",
      "simulink": {"sourceBlock": "simulink/Logic and Bit Operations/Interval Test"},
      "sampleTime": {"fixed": "inherited"},
      "size": [40, 30],
      "params": [
        {"name": "IntervalClosedRight", "type": "bool", "default": true, "title": {"en": "Interval closed on right", "pt-BR": "Intervalo fechado à direita"}},
        {"name": "uplimit", "type": "expr", "default": "0.5", "tunable": true, "title": {"en": "Upper limit", "pt-BR": "Limite superior"}},
        {"name": "IntervalClosedLeft", "type": "bool", "default": true, "title": {"en": "Interval closed on left", "pt-BR": "Intervalo fechado à esquerda"}},
        {"name": "lowlimit", "type": "expr", "default": "-0.5", "tunable": true, "title": {"en": "Lower limit", "pt-BR": "Limite inferior"}}
