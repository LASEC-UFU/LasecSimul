      "doc": "https://www.mathworks.com/help/simulink/slref/detectincrease.html",
      "simulink": {"sourceBlock": "simulink/Logic and Bit Operations/Detect Increase"},
      "sampleTime": {"fixed": "inherited"},
      "size": [60, 30],
      "params": [
