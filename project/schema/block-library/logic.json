        {"name": "InputProcessing", "type": "enum", "default": "Elements as channels (sample based)", "options": ["Columns as channels (frame based)", "Elements as channels (sample based)"], "title": {"en": "Input processing", "pt-BR": "Processamento da entrada"}}
      ],
      "inputs": [
        {"id": "in1"}
      ],
      "outputs": [
        {"id": "out1"}
      ]
    },
