{
  "library": "logic",
  "name": "Logic and Bit Operations",
  "title": {"pt-BR": "Lógica e operações de bits"},
  "order": 45,
  "blocks": [
    {
      "id": "logical_operator",
      "name": "Logical Operator",
      "title": {"pt-BR": "Operador lógico"},
      "doc": "https://www.mathworks.com/help/simulink/slref/logicaloperator.html",
      "simulink": {"blockType": "Logic"},
      "sampleTime": {"param": "SampleTime"},
      "size": [30, 30],
      "params": [
        {"name": "Operator", "type": "enum", "default": "AND", "options": ["AND", "OR", "NAND", "NOR", "XOR", "NXOR", "NOT"], "title": {"en": "Operator", "pt-BR": "Operador"}},
        {"name": "Inputs", "type": "expr", "default": "2", "visibleWhen": {"Operator": ["AND", "OR", "NAND", "NOR", "XOR", "NXOR"]}, "title": {"en": "Number of input ports", "pt-BR": "Número de entradas"}},
        {"name": "IconShape", "type": "enum", "default": "rectangular", "options": ["rectangular", "distinctive"], "title": {"en": "Icon shape", "pt-BR": "Formato do ícone"}},
        {"name": "SampleTime", "type": "expr", "default": "-1", "title": {"en": "Sample time (-1 for inherited)", "pt-BR": "Tempo de amostragem (-1 herdado)"}}
      ],
      "inputs": [
        {"repeat": {"param": "Inputs", "rule": "count"}, "prefix": "in", "start": 1, "when": {"Operator": ["AND", "OR", "NAND", "NOR", "XOR", "NXOR"]}},
        {"id": "in1", "when": {"Operator": ["NOT"]}}
      ],
      "outputs": [
        {"id": "out1"}
      ]
    },
    {
      "id": "relational_operator",
      "name": "Relational Operator",
      "title": {"pt-BR": "Operador relacional"},
      "doc": "https://www.mathworks.com/help/simulink/slref/relationaloperator.html",
      "simulink": {"blockType": "RelationalOperator"},
      "sampleTime": {"param": "SampleTime"},
      "size": [30, 30],
      "params": [
        {"name": "Operator", "type": "enum", "default": "<=", "options": ["==", "~=", "<", "<=", ">=", ">", "isInf", "isNaN", "isFinite"], "title": {"en": "Relational operator", "pt-BR": "Operador relacional"}},
        {"name": "ZeroCross", "type": "bool", "default": true, "title": {"en": "Enable zero-crossing detection", "pt-BR": "Detecção de cruzamento por zero"}},
        {"name": "SampleTime", "type": "expr", "default": "-1", "title": {"en": "Sample time (-1 for inherited)", "pt-BR": "Tempo de amostragem (-1 herdado)"}}
      ],
      "inputs": [
        {"id": "in1"},
        {"id": "in2", "when": {"Operator": ["==", "~=", "<", "<=", ">=", ">"]}}
      ],
      "outputs": [
        {"id": "out1"}
      ]
    },
    {
      "id": "compare_to_constant",
      "name": "Compare To Constant",
      "title": {"pt-BR": "Comparar com constante"},
      "doc": "https://www.mathworks.com/help/simulink/slref/comparetoconstant.html",
      "simulink": {"sourceBlock": "simulink/Logic and Bit Operations/Compare To Constant"},
      "sampleTime": {"fixed": "inherited"},
      "size": [40, 30],
      "params": [
        {"name": "relop", "type": "enum", "default": "<=", "options": ["==", "~=", "<", "<=", ">=", ">"], "title": {"en": "Operator", "pt-BR": "Operador"}},
        {"name": "const", "type": "expr", "default": "3.0", "tunable": true, "title": {"en": "Constant value", "pt-BR": "Valor da constante"}},
        {"name": "ZeroCross", "type": "bool", "default": true, "title": {"en": "Enable zero-crossing detection", "pt-BR": "Detecção de cruzamento por zero"}}
      ],
      "inputs": [
        {"id": "in1"}
      ],
      "outputs": [
        {"id": "out1"}
      ]
    },
    {
      "id": "compare_to_zero",
      "name": "Compare To Zero",
      "title": {"pt-BR": "Comparar com zero"},
      "doc": "https://www.mathworks.com/help/simulink/slref/comparetozero.html",
      "simulink": {"sourceBlock": "simulink/Logic and Bit Operations/Compare To Zero"},
      "sampleTime": {"fixed": "inherited"},
      "size": [40, 30],
      "params": [
        {"name": "relop", "type": "enum", "default": "<=", "options": ["==", "~=", "<", "<=", ">=", ">"], "title": {"en": "Operator", "pt-BR": "Operador"}},
        {"name": "ZeroCross", "type": "bool", "default": true, "title": {"en": "Enable zero-crossing detection", "pt-BR": "Detecção de cruzamento por zero"}}
      ],
      "inputs": [
        {"id": "in1"}
      ],
      "outputs": [
        {"id": "out1"}
      ]
    },
    {
