{
  "library": "discrete",
  "name": "Discrete",
  "title": {"pt-BR": "Discretos"},
  "order": 30,
  "blocks": [
    {
      "id": "discrete_pid_controller",
      "name": "Discrete PID Controller",
      "title": {"pt-BR": "Controlador PID discreto"},
      "doc": "https://www.mathworks.com/help/simulink/slref/discretepidcontroller.html",
      "simulink": {"sourceBlock": "simulink/Discrete/Discrete PID Controller"},
      "sampleTime": {"param": "SampleTime"},
      "size": [40, 35],
      "params": [
        {"name": "Controller", "type": "enum", "default": "PID", "options": ["PID", "PI", "PD", "P", "I"], "group": "Main", "title": {"en": "Controller", "pt-BR": "Controlador"}},
        {"name": "Form", "type": "enum", "default": "Parallel", "options": ["Parallel", "Ideal"], "group": "Main", "title": {"en": "Form", "pt-BR": "Forma"}},
        {"name": "TimeDomain", "type": "enum", "default": "Discrete-time", "options": ["Continuous-time", "Discrete-time"], "group": "Main", "title": {"en": "Time domain", "pt-BR": "Domínio do tempo"}},
        {"name": "UseExternalTs", "type": "bool", "default": false, "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"]}, "title": {"en": "PID Controller is inside a conditionally executed subsystem", "pt-BR": "Dentro de subsistema condicionalmente executado"}},
        {"name": "SampleTime", "type": "expr", "default": "-1", "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"]}, "title": {"en": "Sample time (-1 for inherited)", "pt-BR": "Tempo de amostragem (-1 = herdado)"}},
        {"name": "IntegratorMethod", "type": "enum", "default": "Forward Euler", "options": ["Forward Euler", "Backward Euler", "Trapezoidal"], "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"], "Controller": ["PID", "PI", "I"]}, "title": {"en": "Integrator method", "pt-BR": "Método do integrador"}},
        {"name": "FilterMethod", "type": "enum", "default": "Forward Euler", "options": ["Forward Euler", "Backward Euler", "Trapezoidal"], "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"], "Controller": ["PID", "PD"], "UseFilter": [true]}, "title": {"en": "Filter method", "pt-BR": "Método do filtro"}},
        {"name": "ControllerParametersSource", "type": "enum", "default": "internal", "options": ["internal", "external"], "group": "Main", "title": {"en": "Source (controller parameters)", "pt-BR": "Origem dos parâmetros do controlador"}},
        {"name": "P", "type": "expr", "default": "1", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PI", "PD", "P"]}, "tunable": true, "title": {"en": "Proportional (P)", "pt-BR": "Proporcional (P)"}},
        {"name": "I", "type": "expr", "default": "1", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PI", "I"]}, "tunable": true, "title": {"en": "Integral (I)", "pt-BR": "Integral (I)"}},
        {"name": "UseKiTs", "type": "bool", "default": false, "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"], "Controller": ["PID", "PI", "I"]}, "title": {"en": "Use I*Ts", "pt-BR": "Usar I*Ts"}},
        {"name": "D", "type": "expr", "default": "0", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PD"]}, "tunable": true, "title": {"en": "Derivative (D)", "pt-BR": "Derivativo (D)"}},
        {"name": "UseFilter", "type": "bool", "default": true, "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"], "Controller": ["PID", "PD"]}, "title": {"en": "Use filtered derivative", "pt-BR": "Usar derivada filtrada"}},
        {"name": "N", "type": "expr", "default": "100", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PD"]}, "tunable": true, "title": {"en": "Filter coefficient (N)", "pt-BR": "Coeficiente do filtro (N)"}},
        {"name": "ZeroCross", "type": "bool", "default": true, "group": "Main", "visibleWhen": {"TimeDomain": ["Continuous-time"]}, "title": {"en": "Enable zero-crossing detection", "pt-BR": "Detecção de cruzamento por zero"}},
        {"name": "InitialConditionSource", "type": "enum", "default": "internal", "options": ["internal", "external"], "group": "Initialization", "title": {"en": "Source (initial conditions)", "pt-BR": "Origem das condições iniciais"}},
        {"name": "InitialConditionForIntegrator", "type": "expr", "default": "0", "group": "Initialization", "visibleWhen": {"InitialConditionSource": ["internal"], "Controller": ["PID", "PI", "I"]}, "title": {"en": "Integrator (initial condition)", "pt-BR": "Condição inicial do integrador"}},
        {"name": "InitialConditionForFilter", "type": "expr", "default": "0", "group": "Initialization", "visibleWhen": {"InitialConditionSource": ["internal"], "Controller": ["PID", "PD"]}, "title": {"en": "Filter (initial condition)", "pt-BR": "Condição inicial do filtro"}},
        {"name": "DifferentiatorICPrevScaledInput", "type": "expr", "default": "0", "group": "Initialization", "visibleWhen": {"InitialConditionSource": ["internal"], "TimeDomain": ["Discrete-time"], "Controller": ["PID", "PD"], "UseFilter": [false]}, "title": {"en": "Differentiator (initial condition)", "pt-BR": "Condição inicial do diferenciador"}},
        {"name": "InitialConditionSetting", "type": "enum", "default": "Auto", "options": ["Auto", "Output"], "group": "Initialization", "title": {"en": "Initial condition setting", "pt-BR": "Aplicação da condição inicial"}},
        {"name": "ExternalReset", "type": "enum", "default": "none", "options": ["none", "rising", "falling", "either", "level"], "group": "Initialization", "title": {"en": "External reset", "pt-BR": "Reset externo"}},
        {"name": "IgnoreLimit", "type": "bool", "default": false, "group": "Initialization", "visibleWhen": {"ExternalReset": ["rising", "falling", "either", "level"]}, "title": {"en": "Ignore reset when linearizing", "pt-BR": "Ignorar reset ao linearizar"}},
        {"name": "TrackingMode", "type": "bool", "default": false, "group": "Initialization", "visibleWhen": {"Controller": ["PID", "PI", "I"]}, "title": {"en": "Enable tracking mode", "pt-BR": "Modo de rastreamento (tracking)"}},
        {"name": "Kt", "type": "expr", "default": "1", "group": "Initialization", "visibleWhen": {"TrackingMode": [true], "Controller": ["PID", "PI", "I"]}, "title": {"en": "Tracking coefficient (Kt)", "pt-BR": "Coeficiente de rastreamento (Kt)"}},
        {"name": "LimitOutput", "type": "bool", "default": false, "group": "Saturation", "title": {"en": "Limit output", "pt-BR": "Limitar saída"}},
        {"name": "SatLimitsSource", "type": "enum", "default": "internal", "options": ["internal", "external"], "group": "Saturation", "visibleWhen": {"LimitOutput": [true]}, "title": {"en": "Source (output saturation limits)", "pt-BR": "Origem dos limites de saturação"}},
        {"name": "UpperSaturationLimit", "type": "expr", "default": "Inf", "group": "Saturation", "visibleWhen": {"LimitOutput": [true], "SatLimitsSource": ["internal"]}, "tunable": true, "title": {"en": "Upper limit", "pt-BR": "Limite superior"}},
        {"name": "LowerSaturationLimit", "type": "expr", "default": "-Inf", "group": "Saturation", "visibleWhen": {"LimitOutput": [true], "SatLimitsSource": ["internal"]}, "tunable": true, "title": {"en": "Lower limit", "pt-BR": "Limite inferior"}},
        {"name": "LinearizeAsGain", "type": "bool", "default": false, "group": "Saturation", "visibleWhen": {"LimitOutput": [true]}, "title": {"en": "Ignore saturation when linearizing", "pt-BR": "Ignorar saturação ao linearizar"}},
        {"name": "AntiWindupMode", "type": "enum", "default": "none", "options": ["none", "back-calculation", "clamping", "external"], "group": "Saturation", "visibleWhen": {"LimitOutput": [true], "Controller": ["PID", "PI", "I"]}, "title": {"en": "Anti-windup method", "pt-BR": "Método anti-windup"}},
        {"name": "Kb", "type": "expr", "default": "1", "group": "Saturation", "visibleWhen": {"LimitOutput": [true], "AntiWindupMode": ["back-calculation"], "Controller": ["PID", "PI", "I"]}, "title": {"en": "Back-calculation coefficient (Kb)", "pt-BR": "Coeficiente de back-calculation (Kb)"}},
        {"name": "LimitIntegratorOutput", "type": "bool", "default": false, "group": "Saturation", "visibleWhen": {"Controller": ["PID", "PI", "I"]}, "title": {"en": "Limit output (integrator)", "pt-BR": "Limitar saída do integrador"}},
        {"name": "UpperIntegratorSaturationLimit", "type": "expr", "default": "Inf", "group": "Saturation", "visibleWhen": {"LimitIntegratorOutput": [true], "Controller": ["PID", "PI", "I"]}, "tunable": true, "title": {"en": "Upper limit (integrator)", "pt-BR": "Limite superior do integrador"}},
        {"name": "LowerIntegratorSaturationLimit", "type": "expr", "default": "-Inf", "group": "Saturation", "visibleWhen": {"LimitIntegratorOutput": [true], "Controller": ["PID", "PI", "I"]}, "tunable": true, "title": {"en": "Lower limit (integrator)", "pt-BR": "Limite inferior do integrador"}}
      ],
      "inputs": [
        {"id": "in1"},
        {"id": "p", "label": "P", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PI", "PD", "P"]}},
        {"id": "i", "label": "I", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PI", "I"], "TimeDomain": ["Continuous-time"]}},
        {"id": "i", "label": "I", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PI", "I"], "TimeDomain": ["Discrete-time"], "UseKiTs": [false]}},
        {"id": "i", "label": "I*Ts", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PI", "I"], "TimeDomain": ["Discrete-time"], "UseKiTs": [true]}},
        {"id": "d", "label": "D", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PD"]}},
        {"id": "n", "label": "N", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PD"], "TimeDomain": ["Continuous-time"]}},
        {"id": "n", "label": "N", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PD"], "TimeDomain": ["Discrete-time"], "UseFilter": [true]}},
        {"id": "reset", "when": {"ExternalReset": ["rising", "falling", "either", "level"]}},
        {"id": "i0", "label": "I0", "when": {"InitialConditionSource": ["external"], "Controller": ["PID", "PI", "I"]}},
        {"id": "d0", "label": "D0", "when": {"InitialConditionSource": ["external"], "Controller": ["PID", "PD"]}},
        {"id": "up", "label": "up", "when": {"LimitOutput": [true], "SatLimitsSource": ["external"]}},
        {"id": "lo", "label": "lo", "when": {"LimitOutput": [true], "SatLimitsSource": ["external"]}},
        {"id": "tr", "label": "TR", "when": {"TrackingMode": [true], "Controller": ["PID", "PI", "I"]}},
        {"id": "extaw", "label": "extAW", "when": {"LimitOutput": [true], "AntiWindupMode": ["external"], "Controller": ["PID", "PI", "I"]}}
      ],
      "outputs": [
        {"id": "out1"},
        {"id": "preint", "label": "preInt", "when": {"LimitOutput": [true], "AntiWindupMode": ["external"], "Controller": ["PID", "PI", "I"]}}
      ]
    },
    {
      "id": "discrete_pid_controller_2dof",
      "name": "Discrete PID Controller (2DOF)",
      "title": {"pt-BR": "Controlador PID discreto (2DOF)"},
      "doc": "https://www.mathworks.com/help/simulink/slref/discretepidcontroller2dof.html",
      "simulink": {"sourceBlock": "simulink/Discrete/Discrete PID Controller (2DOF)"},
      "sampleTime": {"param": "SampleTime"},
      "size": [55, 40],
      "params": [
        {"name": "Controller", "type": "enum", "default": "PID", "options": ["PID", "PI", "PD"], "group": "Main", "title": {"en": "Controller", "pt-BR": "Controlador"}},
        {"name": "Form", "type": "enum", "default": "Parallel", "options": ["Parallel", "Ideal"], "group": "Main", "title": {"en": "Form", "pt-BR": "Forma"}},
        {"name": "TimeDomain", "type": "enum", "default": "Discrete-time", "options": ["Continuous-time", "Discrete-time"], "group": "Main", "title": {"en": "Time domain", "pt-BR": "Domínio do tempo"}},
        {"name": "UseExternalTs", "type": "bool", "default": false, "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"]}, "title": {"en": "PID Controller is inside a conditionally executed subsystem", "pt-BR": "Dentro de subsistema condicionalmente executado"}},
        {"name": "SampleTime", "type": "expr", "default": "-1", "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"]}, "title": {"en": "Sample time (-1 for inherited)", "pt-BR": "Tempo de amostragem (-1 = herdado)"}},
        {"name": "IntegratorMethod", "type": "enum", "default": "Forward Euler", "options": ["Forward Euler", "Backward Euler", "Trapezoidal"], "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"], "Controller": ["PID", "PI"]}, "title": {"en": "Integrator method", "pt-BR": "Método do integrador"}},
        {"name": "FilterMethod", "type": "enum", "default": "Forward Euler", "options": ["Forward Euler", "Backward Euler", "Trapezoidal"], "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"], "Controller": ["PID", "PD"], "UseFilter": [true]}, "title": {"en": "Filter method", "pt-BR": "Método do filtro"}},
        {"name": "ControllerParametersSource", "type": "enum", "default": "internal", "options": ["internal", "external"], "group": "Main", "title": {"en": "Source (controller parameters)", "pt-BR": "Origem dos parâmetros do controlador"}},
        {"name": "P", "type": "expr", "default": "1", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PI", "PD"]}, "tunable": true, "title": {"en": "Proportional (P)", "pt-BR": "Proporcional (P)"}},
        {"name": "I", "type": "expr", "default": "1", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PI"]}, "tunable": true, "title": {"en": "Integral (I)", "pt-BR": "Integral (I)"}},
        {"name": "UseKiTs", "type": "bool", "default": false, "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"], "Controller": ["PID", "PI"]}, "title": {"en": "Use I*Ts", "pt-BR": "Usar I*Ts"}},
        {"name": "D", "type": "expr", "default": "0", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PD"]}, "tunable": true, "title": {"en": "Derivative (D)", "pt-BR": "Derivativo (D)"}},
        {"name": "UseFilter", "type": "bool", "default": true, "group": "Main", "visibleWhen": {"TimeDomain": ["Discrete-time"], "Controller": ["PID", "PD"]}, "title": {"en": "Use filtered derivative", "pt-BR": "Usar derivada filtrada"}},
        {"name": "N", "type": "expr", "default": "100", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PD"]}, "tunable": true, "title": {"en": "Filter coefficient (N)", "pt-BR": "Coeficiente do filtro (N)"}},
        {"name": "b", "type": "expr", "default": "1", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"]}, "tunable": true, "title": {"en": "Setpoint weight (b)", "pt-BR": "Peso do setpoint (b)"}},
        {"name": "c", "type": "expr", "default": "1", "group": "Main", "visibleWhen": {"ControllerParametersSource": ["internal"], "Controller": ["PID", "PD"]}, "tunable": true, "title": {"en": "Setpoint weight (c)", "pt-BR": "Peso do setpoint (c)"}},
        {"name": "ZeroCross", "type": "bool", "default": true, "group": "Main", "visibleWhen": {"TimeDomain": ["Continuous-time"]}, "title": {"en": "Enable zero-crossing detection", "pt-BR": "Detecção de cruzamento por zero"}},
        {"name": "InitialConditionSource", "type": "enum", "default": "internal", "options": ["internal", "external"], "group": "Initialization", "title": {"en": "Source (initial conditions)", "pt-BR": "Origem das condições iniciais"}},
        {"name": "InitialConditionForIntegrator", "type": "expr", "default": "0", "group": "Initialization", "visibleWhen": {"InitialConditionSource": ["internal"], "Controller": ["PID", "PI"]}, "title": {"en": "Integrator (initial condition)", "pt-BR": "Condição inicial do integrador"}},
        {"name": "InitialConditionForFilter", "type": "expr", "default": "0", "group": "Initialization", "visibleWhen": {"InitialConditionSource": ["internal"], "Controller": ["PID", "PD"]}, "title": {"en": "Filter (initial condition)", "pt-BR": "Condição inicial do filtro"}},
        {"name": "DifferentiatorICPrevScaledInput", "type": "expr", "default": "0", "group": "Initialization", "visibleWhen": {"InitialConditionSource": ["internal"], "TimeDomain": ["Discrete-time"], "Controller": ["PID", "PD"], "UseFilter": [false]}, "title": {"en": "Differentiator (initial condition)", "pt-BR": "Condição inicial do diferenciador"}},
        {"name": "InitialConditionSetting", "type": "enum", "default": "Auto", "options": ["Auto", "Output"], "group": "Initialization", "title": {"en": "Initial condition setting", "pt-BR": "Aplicação da condição inicial"}},
        {"name": "ExternalReset", "type": "enum", "default": "none", "options": ["none", "rising", "falling", "either", "level"], "group": "Initialization", "title": {"en": "External reset", "pt-BR": "Reset externo"}},
        {"name": "IgnoreLimit", "type": "bool", "default": false, "group": "Initialization", "visibleWhen": {"ExternalReset": ["rising", "falling", "either", "level"]}, "title": {"en": "Ignore reset when linearizing", "pt-BR": "Ignorar reset ao linearizar"}},
        {"name": "TrackingMode", "type": "bool", "default": false, "group": "Initialization", "visibleWhen": {"Controller": ["PID", "PI"]}, "title": {"en": "Enable tracking mode", "pt-BR": "Modo de rastreamento (tracking)"}},
        {"name": "Kt", "type": "expr", "default": "1", "group": "Initialization", "visibleWhen": {"TrackingMode": [true], "Controller": ["PID", "PI"]}, "title": {"en": "Tracking coefficient (Kt)", "pt-BR": "Coeficiente de rastreamento (Kt)"}},
        {"name": "LimitOutput", "type": "bool", "default": false, "group": "Saturation", "title": {"en": "Limit output", "pt-BR": "Limitar saída"}},
        {"name": "SatLimitsSource", "type": "enum", "default": "internal", "options": ["internal", "external"], "group": "Saturation", "visibleWhen": {"LimitOutput": [true]}, "title": {"en": "Source (output saturation limits)", "pt-BR": "Origem dos limites de saturação"}},
        {"name": "UpperSaturationLimit", "type": "expr", "default": "Inf", "group": "Saturation", "visibleWhen": {"LimitOutput": [true], "SatLimitsSource": ["internal"]}, "tunable": true, "title": {"en": "Upper limit", "pt-BR": "Limite superior"}},
        {"name": "LowerSaturationLimit", "type": "expr", "default": "-Inf", "group": "Saturation", "visibleWhen": {"LimitOutput": [true], "SatLimitsSource": ["internal"]}, "tunable": true, "title": {"en": "Lower limit", "pt-BR": "Limite inferior"}},
        {"name": "LinearizeAsGain", "type": "bool", "default": false, "group": "Saturation", "visibleWhen": {"LimitOutput": [true]}, "title": {"en": "Ignore saturation when linearizing", "pt-BR": "Ignorar saturação ao linearizar"}},
        {"name": "AntiWindupMode", "type": "enum", "default": "none", "options": ["none", "back-calculation", "clamping", "external"], "group": "Saturation", "visibleWhen": {"LimitOutput": [true], "Controller": ["PID", "PI"]}, "title": {"en": "Anti-windup method", "pt-BR": "Método anti-windup"}},
        {"name": "Kb", "type": "expr", "default": "1", "group": "Saturation", "visibleWhen": {"LimitOutput": [true], "AntiWindupMode": ["back-calculation"], "Controller": ["PID", "PI"]}, "title": {"en": "Back-calculation coefficient (Kb)", "pt-BR": "Coeficiente de back-calculation (Kb)"}},
        {"name": "LimitIntegratorOutput", "type": "bool", "default": false, "group": "Saturation", "visibleWhen": {"Controller": ["PID", "PI"]}, "title": {"en": "Limit output (integrator)", "pt-BR": "Limitar saída do integrador"}},
        {"name": "UpperIntegratorSaturationLimit", "type": "expr", "default": "Inf", "group": "Saturation", "visibleWhen": {"LimitIntegratorOutput": [true], "Controller": ["PID", "PI"]}, "tunable": true, "title": {"en": "Upper limit (integrator)", "pt-BR": "Limite superior do integrador"}},
        {"name": "LowerIntegratorSaturationLimit", "type": "expr", "default": "-Inf", "group": "Saturation", "visibleWhen": {"LimitIntegratorOutput": [true], "Controller": ["PID", "PI"]}, "tunable": true, "title": {"en": "Lower limit (integrator)", "pt-BR": "Limite inferior do integrador"}}
      ],
      "inputs": [
        {"id": "in1", "label": "Ref"},
        {"id": "in2"},
        {"id": "p", "label": "P", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PI", "PD"]}},
        {"id": "i", "label": "I", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PI"], "TimeDomain": ["Continuous-time"]}},
        {"id": "i", "label": "I", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PI"], "TimeDomain": ["Discrete-time"], "UseKiTs": [false]}},
        {"id": "i", "label": "I*Ts", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PI"], "TimeDomain": ["Discrete-time"], "UseKiTs": [true]}},
        {"id": "d", "label": "D", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PD"]}},
        {"id": "n", "label": "N", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PD"], "TimeDomain": ["Continuous-time"]}},
        {"id": "n", "label": "N", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PD"], "TimeDomain": ["Discrete-time"], "UseFilter": [true]}},
        {"id": "b", "label": "b", "when": {"ControllerParametersSource": ["external"]}},
        {"id": "c", "label": "c", "when": {"ControllerParametersSource": ["external"], "Controller": ["PID", "PD"]}},
        {"id": "reset", "when": {"ExternalReset": ["rising", "falling", "either", "level"]}},
        {"id": "i0", "label": "I0", "when": {"InitialConditionSource": ["external"], "Controller": ["PID", "PI"]}},
        {"id": "d0", "label": "D0", "when": {"InitialConditionSource": ["external"], "Controller": ["PID", "PD"]}},
        {"id": "up", "label": "up", "when": {"LimitOutput": [true], "SatLimitsSource": ["external"]}},
        {"id": "lo", "label": "lo", "when": {"LimitOutput": [true], "SatLimitsSource": ["external"]}},
        {"id": "tr", "label": "TR", "when": {"TrackingMode": [true], "Controller": ["PID", "PI"]}},
        {"id": "extaw", "label": "extAW", "when": {"LimitOutput": [true], "AntiWindupMode": ["external"], "Controller": ["PID", "PI"]}}
      ],
      "outputs": [
        {"id": "out1"},
        {"id": "preint", "label": "preInt", "when": {"LimitOutput": [true], "AntiWindupMode": ["external"], "Controller": ["PID", "PI"]}}
      ]
    }
  ]
}
