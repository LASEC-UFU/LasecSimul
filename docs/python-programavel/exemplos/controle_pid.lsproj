                       {
                           "id":  "python-1",
                           "typeId":  "python.programmable",
                           "label":  "PID discreto",
                           "visual":  {
                                          "x":  300,
                                          "y":  220,
                                          "rotation":  0
                                      },
                           "properties":  {
                                              "source":  "erro = referencia - medicao\nstate.integral += erro * sim.dt\nderivada = (erro - state.erro_anterior) / sim.dt if sim.dt \u003e 0 else 0.0\nstate.erro_anterior = erro\nsaida = max(0.0, min(100.0, 1.8 * erro + 0.15 * state.integral + 0.02 * derivada))\n",
                                              "ports":  "{\"inputs\":[{\"name\":\"referencia\",\"type\":\"real\",\"unit\":\"%\"},{\"name\":\"medicao\",\"type\":\"real\",\"unit\":\"%\"}],\"outputs\":[{\"name\":\"saida\",\"type\":\"real\",\"unit\":\"%\"}]}",
                                              "periodNs":  10000000
                                          }
                       }
                   ],
