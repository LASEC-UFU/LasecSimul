      "schemaVersion": 1,
      "id": "laboratorio",
      "kind": "screen",
      "title": "Laboratório de Cálculo",
      "startPageId": "pagina-primeira-ordem",
      "pages": [
        {
          "id": "pagina-primeira-ordem",
          "name": "Primeira ordem — exponencial",
          "width": 1920,
          "height": 1080,
          "elements": [
            {
              "id": "atividade-primeira-ordem",
              "typeId": "graphics.math.activity",
              "label": "Primeira ordem — exponencial",
              "properties": {
                "width": 1920,
                "height": 1080,
                "kind": "firstOrder",
                "fillPage": true,
                "plantComponentId": "primeira-ordem-lab",
                "activityJson": "{\"id\":\"primeira-ordem\",\"title\":\"Primeira ordem — exponencial\",\"question\":\"Em que instante a resposta alcança 63,2 % do salto?\",\"steps\":[{\"id\":\"prever\",\"phase\":\"predict\",\"prompt\":\"Prever: qual o valor final de y para K = 2 e u = 1?\",\"hints\":[]},{\"id\":\"tau\",\"phase\":\"explore\",\"prompt\":\"Ache o instante em que y cruza a linha de 63,2 %. Compare com τ.\",\"hints\":[]},{\"id\":\"tangente\",\"phase\":\"formalize\",\"prompt\":\"A tangente em t = 0 cruza o valor final em t = τ? Verifique.\",\"hints\":[]},{\"id\":\"degrau\",\"phase\":\"apply\",\"prompt\":\"Mude u durante a execução: só o futuro muda?\",\"hints\":[]}],\"plantComponentId\":\"primeira-ordem-lab\",\"parameters\":{\"u\":1,\"K\":2,\"tau\":5,\"y0\":0},\"kind\":\"firstOrder\"}"
              },
              "visual": {
                "x": 0,
                "y": 0,
                "width": 1920,
                "height": 1080,
                "rotation": 0
              }
            }
          ]
        }
      ],
      "presentation": {
        "fullscreenContext": "lab",
        "defaultContext": "lab",
        "startInOperation": true
      }
    }
  ],
  "subsystems": [
    {
      "schemaVersion": 3,
      "typeId": "subsystem.process.first_order_lab",
      "name": "Resposta de primeira ordem (laboratório)",
      "language": "pt-BR",
      "folderPath": [
        "Modelos"
      ],
      "workspaceSection": "process",
      "help": {
        "description": "Degrau u (constante, muda com a simulação rodando) aplicado a um bloco de primeira ordem K/(τs+1) com saída inicial y₀: y(t) = Ku + (y₀ − Ku)·e^(−t/τ). Ganho, constante de tempo e y₀ são propriedades do bloco (mudam com a simulação parada). Usado pelo experimento D do Laboratório de Cálculo (exponencial, valor final, tangente em t = 0, 63,2 %)."
      },
      "components": [
        {
          "id": "c_u",
          "typeId": "control.constant",
          "properties": {
            "value": 1,
            "unit": ""
          },
