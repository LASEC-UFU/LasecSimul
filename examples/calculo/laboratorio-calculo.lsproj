              "label": "Pressão aplicada P"
            },
            {
              "id": "c_pmin",
              "typeId": "control.constant",
              "properties": {
                "value": 0,
                "unit": "kPa"
              },
              "visual": {
                "x": 40,
                "y": 100,
                "rotation": 0
              },
              "label": "Início da faixa (Pmin → 4 mA)"
            },
            {
              "id": "c_pmax",
              "typeId": "control.constant",
              "properties": {
                "value": 200,
                "unit": "kPa"
              },
              "visual": {
                "x": 40,
                "y": 160,
                "rotation": 0
              },
              "label": "Fim da faixa (Pmax → 20 mA)"
            },
