            "Modelos"
          ],
          "workspaceSection": "process",
          "help": {
            "description": "Transmissor de pressão como função afim: I = 4 mA + 16 mA·(P − Pmin)/(Pmax − Pmin), saturado em 3,8–20,5 mA como um laço 4–20 mA real. A saída 'raw' mostra o valor sem saturação. P muda com a simulação rodando; a faixa Pmin–Pmax é configuração. Usado pelo experimento A do Laboratório de Cálculo (função afim, ganho/offset, inversa, saturação)."
          },
          "components": [
            {
              "id": "c_p",
              "typeId": "control.constant",
              "properties": {
                "value": 100,
                "unit": "kPa"
              },
              "visual": {
                "x": 40,
                "y": 40,
                "rotation": 0
