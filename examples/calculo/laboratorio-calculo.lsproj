  "calculusLab": {
    "schemaVersion": 1,
    "activities": [
      {
        "id": "funcoes-explorador",
        "title": "Funções — explorador",
        "question": "Como os parâmetros a, b e c mudam o gráfico de f(x) = a·x² + b·x + c?",
        "steps": [
          {
            "id": "prever",
            "phase": "predict",
            "prompt": "Prever: o que acontece com a parábola quando a fica negativo?",
            "hints": []
          },
          {
            "id": "raizes",
            "phase": "explore",
            "prompt": "Encontre valores de c para os quais f não tem raízes reais.",
            "hints": []
          },
          {
            "id": "intersecao",
            "phase": "explore",
            "prompt": "Onde f cruza g(x) = x + 1? Compare com a tabela.",
            "hints": []
          },
          {
            "id": "derivada",
            "phase": "formalize",
            "prompt": "Ligue f′: onde f′(x) = 0, o que acontece com f?",
            "hints": []
          }
        ],
        "kind": "functions",
        "variable": "x",
        "f": "a x^2 + b x + c",
        "g": "x + 1",
        "parameters": [
          {
            "name": "a",
            "min": -3,
            "max": 3,
            "step": 0.1,
            "value": 1
          },
          {
            "name": "b",
            "min": -5,
            "max": 5,
            "step": 0.1,
            "value": 0
          },
          {
            "name": "c",
            "min": -5,
            "max": 5,
            "step": 0.1,
            "value": -2
          }
        ],
        "domain": [
          -5,
          5
        ],
        "range": [
          -6,
          10
        ],
        "show": {
          "derivative": false,
          "integral": false,
          "asymptotes": true,
          "roots": true,
          "table": true
        },
        "integralFrom": 0,
        "tableStep": 1
      },
      {
        "id": "sensor-4-20",
        "title": "Sensor 4–20 mA — função afim",
        "question": "Que pressão produz 12 mA? O que acontece acima de Pmax?",
        "steps": [
          {
            "id": "prever",
            "phase": "predict",
            "prompt": "Prever: com faixa 0–200 kPa, quanto vale I em 50 kPa?",
            "hints": []
          },
          {
            "id": "doze",
            "phase": "explore",
            "prompt": "Mova P até 12 mA. Escreva a inversa P(I).",
            "hints": []
          },
          {
            "id": "saturacao",
            "phase": "apply",
            "prompt": "Passe de Pmax: o que a corrente faz? E o valor sem saturação?",
            "hints": []
          }
        ],
        "plantComponentId": "sensor-lab",
        "parameters": {
          "p": 100,
          "pmin": 0,
          "pmax": 200
        },
        "kind": "sensor"
      },
      {
        "id": "limites-velocidade-4s",
        "title": "Limites — velocidade de subida aos 4 s",
        "question": "Qual é a velocidade de subida da água aos 4 segundos?",
        "steps": [
          {
            "id": "prever",
            "phase": "predict",
            "prompt": "Antes de mexer: a velocidade aos 4 s é maior ou menor que a velocidade média entre 0 e 4 s?",
            "hints": []
          },
          {
            "id": "aproximar",
            "phase": "explore",
            "prompt": "Aproxime Q de P pela direita e pela esquerda. O que acontece com a taxa média?",
            "hints": [
              "Use a tabela: compare as linhas com Δt = 0,1 e 0,01."
            ]
          },
          {
            "id": "formalizar",
            "phase": "formalize",
            "prompt": "Escreva o limite do quociente incremental e calcule-o com a calculadora.",
            "hints": [
              "Teclado › Cálculo › lim"
            ]
          },
          {
            "id": "epsilon",
            "phase": "apply",
            "prompt": "Modo ε–δ: para ε = 0,1, que δ garante |taxa − L| < ε?",
            "hints": []
          }
        ],
        "kind": "limits",
        "variable": "t",
        "units": {
          "x": "s",
          "y": "cm"
        },
        "model": "0.5t^2",
        "a": 4,
        "domain": [
          0,
          6
        ],
        "rows": [
          1,
          0.1,
          0.01
        ],
        "initialDelta": 0.5,
        "epsilon": 0.5
      },
      {
        "id": "eixo-trajetoria",
