        "id": "tanque-vazao-integral",
        "title": "Tanque — da vazão à integral",
        "question": "Com 1 L/s entrando e 0,4 L/s saindo, quanto o volume aumenta em 10 s?",
        "steps": [
          {
            "id": "prever",
            "phase": "predict",
            "prompt": "Com 1 L/s entrando e 0,4 L/s saindo, quanto o volume aumenta em 10 s?",
            "hints": []
          },
          {
            "id": "medir",
            "phase": "explore",
            "prompt": "Execute e marque a = 0 s e b = 10 s: ΔV e a inclinação da secante batem com q?",
            "hints": [
              "Com q constante, qualquer Riemann é exato — por quê?"
            ]
          },
          {
            "id": "mudar",
            "phase": "explore",
            "prompt": "Mude a vazão de entrada durante a execução: o que acontece com V e com q no instante da mudança?",
            "hints": []
          },
          {
            "id": "valvula",
            "phase": "formalize",
            "prompt": "Reinicie com a válvula (q = k·h): compare Riemann à esquerda, à direita e trapézio com V(b) − V(a).",
            "hints": []
          },
          {
            "id": "area",
            "phase": "apply",
            "prompt": "Mude a área A durante a execução: h salta, V não. Explique com h = V/A.",
            "hints": []
          }
        ],
        "plantComponentId": "tanque-lab",
        "parameters": {
          "qIn": 1,
          "qOut": 0.4,
          "area": 0.1,
          "k": 2,
          "torr": 1.4,
