  "visualDocuments": [
    {
      "schemaVersion": 1,
      "id": "laboratorio",
      "kind": "screen",
      "title": "Laboratório de Cálculo",
      "startPageId": "pagina-sensor-4-20",
      "pages": [
        {
          "id": "pagina-sensor-4-20",
          "name": "Sensor 4–20 mA — função afim",
          "width": 1920,
          "height": 1080,
          "elements": [
            {
              "id": "atividade-sensor-4-20",
              "typeId": "graphics.math.activity",
              "label": "Sensor 4–20 mA — função afim",
              "properties": {
                "width": 1920,
                "height": 1080,
                "kind": "sensor",
                "fillPage": true,
                "plantComponentId": "sensor-lab",
                "activityJson": "{\"id\":\"sensor-4-20\",\"title\":\"Sensor 4–20 mA — função afim\",\"question\":\"Que pressão produz 12 mA? O que acontece acima de Pmax?\",\"steps\":[{\"id\":\"prever\",\"phase\":\"predict\",\"prompt\":\"Prever: com faixa 0–200 kPa, quanto vale I em 50 kPa?\",\"hints\":[]},{\"id\":\"doze\",\"phase\":\"explore\",\"prompt\":\"Mova P até 12 mA. Escreva a inversa P(I).\",\"hints\":[]},{\"id\":\"saturacao\",\"phase\":\"apply\",\"prompt\":\"Passe de Pmax: o que a corrente faz? E o valor sem saturação?\",\"hints\":[]}],\"plantComponentId\":\"sensor-lab\",\"parameters\":{\"p\":100,\"pmin\":0,\"pmax\":200},\"kind\":\"sensor\"}"
              },
              "visual": {
                "x": 0,
                "y": 0,
                "width": 1920,
                "height": 1080,
                "rotation": 0
              }
            }
          ]
        }
      ],
      "presentation": {
        "fullscreenContext": "lab",
        "defaultContext": "lab",
        "startInOperation": true
      }
    }
  ],
  "subsystems": [
    {
      "schemaVersion": 3,
      "typeId": "subsystem.process.sensor_4_20",
      "name": "Sensor 4–20 mA (laboratório)",
      "language": "pt-BR",
      "folderPath": [
        "Modelos"
      ],
      "workspaceSection": "process",
      "help": {
        "description": "Transmissor de pressão como função afim: I = 4 mA + 16 mA·(P − Pmin)/(Pmax − Pmin), saturado em 3,8–20,5 mA como um laço 4–20 mA real. A saída 'raw' mostra o valor sem saturação. P muda com a simulação rodando; a faixa Pmin–Pmax é configuração. Usado pelo experimento A do Laboratório de Cálculo (função afim, ganho/offset, inversa, saturação)."
      },
      "components": [
        {
          "id": "c_p",
          "typeId": "control.constant",
          "properties": {
            "value": 100,
            "unit": "kPa"
          },
          "visual": {
            "x": 40,
            "y": 40,
            "rotation": 0
          },
          "label": "Pressão aplicada P"
        },
        {
          "id": "c_pmin",
          "typeId": "control.constant",
          "properties": {
            "value": 0,
            "unit": "kPa"
          },
          "visual": {
            "x": 40,
            "y": 100,
            "rotation": 0
          },
          "label": "Início da faixa (Pmin → 4 mA)"
        },
        {
          "id": "c_pmax",
          "typeId": "control.constant",
          "properties": {
            "value": 200,
            "unit": "kPa"
          },
          "visual": {
            "x": 40,
            "y": 160,
            "rotation": 0
          },
          "label": "Fim da faixa (Pmax → 20 mA)"
        },
        {
          "id": "i_raw",
          "typeId": "control.calc_expression",
          "properties": {
            "expression": "4+16*(p-pmin)/(pmax-pmin)",
            "inputs": [
              "p",
              "pmin",
              "pmax"
            ],
            "upperLimit": 0,
            "lowerLimit": 0,
            "upperLimitEnabled": false,
            "lowerLimitEnabled": false,
            "samplePeriodNs": 10000000
          },
          "visual": {
            "x": 240,
            "y": 80,
            "rotation": 0
          },
          "label": "Corrente sem saturação (mA)"
        },
        {
          "id": "i_loop",
          "typeId": "control.saturation",
          "properties": {
            "minimum": 3.8,
            "maximum": 20.5,
            "samplePeriodNs": 10000000
          },
          "visual": {
            "x": 440,
            "y": 80,
            "rotation": 0
          },
          "label": "Corrente do laço (mA)"
        },
        {
          "id": "t_current",
          "typeId": "connectors.signal_tunnel",
          "properties": {
            "name": "current",
            "pinId": "current",
            "direction": "Output",
            "valueType": "Real"
          },
          "visual": {
            "x": 640,
            "y": 80,
            "rotation": 0
          }
        },
        {
          "id": "t_raw",
          "typeId": "connectors.signal_tunnel",
          "properties": {
            "name": "raw",
            "pinId": "raw",
            "direction": "Output",
            "valueType": "Real"
          },
          "visual": {
            "x": 640,
            "y": 160,
            "rotation": 0
          }
        },
        {
          "id": "g_p",
          "typeId": "graphics.value_display",
          "properties": {
            "width": 150,
            "height": 40,
            "stroke": "currentColor",
            "fill": "#f8fafc",
            "strokeWidth": 1.5,
            "opacity": 1,
            "label": "Pressão",
            "valueColor": "#0f172a",
            "value": 0,
            "bindSource": "c_p",
            "bindChannel": 0,
            "bindScale": 1,
            "bindOffset": 0,
            "bindMin": -1000000000,
            "bindMax": 1000000000,
            "bindUnit": "kPa",
            "bindDecimals": 1
          },
          "visual": {
            "x": 210,
            "y": 50,
            "rotation": 0
          }
        },
        {
          "id": "g_i",
          "typeId": "graphics.value_display",
          "properties": {
            "width": 150,
            "height": 40,
            "stroke": "currentColor",
            "fill": "#f8fafc",
            "strokeWidth": 1.5,
            "opacity": 1,
            "label": "Corrente",
            "valueColor": "#0f172a",
            "value": 0,
            "bindSource": "i_loop",
            "bindChannel": 0,
            "bindScale": 1,
            "bindOffset": 0,
            "bindMin": -1000000000,
            "bindMax": 1000000000,
            "bindUnit": "mA",
            "bindDecimals": 3
          },
          "visual": {
            "x": 210,
            "y": 106,
            "rotation": 0
          }
        }
      ],
      "topology": {
        "revision": 0,
        "nodes": [],
        "conductors": [
          {
            "id": "w-1",
