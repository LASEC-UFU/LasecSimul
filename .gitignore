# QEMU vendorizado (devices/qemu-esp32/bin/) -- PRECISA ser versionado: sem isto no checkout do CI,
# scripts/package-release.js::stageBundledAssets() copia uma pasta vazia e o instalador gerado pelo
# workflow sai sem QEMU (bug real reportado pelo usuario). Sobrescreve as regras genericas *.exe/*.dll
# acima só pra esta pasta -- o resto do repo continua nunca versionando artefato de build comum.
!/devices/qemu-esp32/bin/**

# O módulo VPI do GHDL é reproduzível e construído no CI de release; continua ignorado como os
# demais artefatos de build. `package-release.js` falha se o módulo da plataforma estiver ausente,
# impedindo que um VSIX anuncie suporte a FPGA sem conter a ponte nativa necessária.

# Saida de build/empacotamento (gerada por scripts/build-all.js e scripts/package-release.js)
/dist/
/extension/.vscode-test/
/extension/test/e2e/artifacts/
/packaging/*/obj/
/packaging/*/bin/

# Artefatos de diagnostico/investigacao (traces binarios do Recorder causal, dumps de validacao
# ad-hoc) -- gerados repetidamente durante investigacoes de performance/timing e nunca destinados a
# ficar no historico; poluiam a raiz do repo (lasecsimul-qemu-*.trace) e .codex-validation/ antes
# desta entrada existir.
*.trace
/.codex-validation/

# ---------------------------------------------------------------------------
# Toolchains e caches locais (2026-09-03)
# ---------------------------------------------------------------------------
# PlatformIO core dir do projeto: pacotes/toolchains (~5 GB). E' NECESSARIO em
# disco -- `vnext_prototype/guest_mwdt_baremetal/build.ps1` usa o
# `toolchain-xtensa-esp32` daqui -- mas nunca deve ser versionado.
/.piohome/
# Caches PlatformIO por fixture.
/vnext_prototype/*/.pio/
/vnext_prototype/*/.piohome/

# Runtime QEMU canonico (DECISION-001): copia do build de C:\SourceCode\
# qemu_lasecSimul mais o conjunto de DLLs MSYS2 UCRT64. E' artefato derivado;
# a SHA autoritativa fica em orchestrator/.ai/QEMU_RUNTIME.json e o
# procedimento de rebuild em orchestrator/.ai/QEMU_CURRENT_STATE.md.
/vnext_prototype/dev_qemu_runtime/

# Saidas dos fixtures e dos runners de teste (regeneraveis; o fixture bare-metal
# compila em ~2 s).
/vnext_prototype/guest_*/build/
/vnext_prototype/guest_mwdt_baremetal/runs/
/vnext_prototype/production_mwdt_runs/
/vnext_prototype/regression_runs/
/vnext_prototype/diagnostic_dumps/

# Estado de runtime do orquestrador (o caderno .md/.json consolidado E'
# versionado; estes sao gerados a cada execucao).
/orchestrator/.ai/logs/
/orchestrator/.ai/orchestrator.log
/orchestrator/.ai/STOP

# Traces/dumps de diagnostico adicionais.
*.etl
*.pyc
__pycache__/
